{
	"name": "The Lounge",
	"short_name": "The Lounge",
	"description": "Self-hosted web IRC client",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"theme_color": "#415364",
	"background_color": "#415364",
	"categories": ["social", "communication"],
	"launch_handler": {
		"client_mode": "focus-existing"
	},
	"protocol_handlers": [
		{
			"protocol": "irc",
			"url": "./?uri=%s"
		},
		{
			"protocol": "ircs",
			"url": "./?uri=%s"
		}
	],
	"icons": [
		{
			"src": "img/logo-grey-bg-120x120px.png",
			"type": "image/png",
			"sizes": "120x120",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg-152x152px.png",
			"type": "image/png",
			"sizes": "152x152",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg-167x167px.png",
			"type": "image/png",
			"sizes": "167x167",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg-180x180px.png",
			"type": "image/png",
			"sizes": "180x180",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg-192x192px.png",
			"type": "image/png",
			"sizes": "192x192",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg-512x512px.png",
			"type": "image/png",
			"sizes": "512x512",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg.svg",
			"type": "image/svg+xml",
			"sizes": "any",
			"purpose": "any"
		},
		{
			"src": "img/logo-grey-bg-192x192px.png",
			"type": "image/png",
			"sizes": "192x192",
			"purpose": "maskable"
		},
		{
			"src": "img/logo-grey-bg-512x512px.png",
			"type": "image/png",
			"sizes": "512x512",
			"purpose": "maskable"
		}
	]
}
