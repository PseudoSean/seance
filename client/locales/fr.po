msgid ""
msgstr ""
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#. Tooltip and aria-label of the ✕ button on a private-conversation or list-window row in the sidebar network list; clicking closes that window (nothing is left on the server).
#: client/components/Channel.vue
msgctxt "channel.close"
msgid "Close"
msgstr "Fermer"

#. Tooltip and aria-label of the ✕ button on a channel row in the sidebar network list; clicking leaves the channel on the server and closes its window.
#: client/components/Channel.vue
msgctxt "channel.leave"
msgid "Leave"
msgstr "Quitter"

#. Tooltip and aria-label of the small icon on a channel row in the sidebar network list while the client is not in that channel (it was left or the join failed); the row's history is still readable.
#: client/components/Channel.vue
msgctxt "channel.partedAria"
msgid "Not currently joined"
msgstr "Pas encore rejoint"

#. aria-label of a row in the sidebar's network list. {type} is the kind of window (see the channel.type.* keys); {name} is the channel name or nickname.
#: client/components/ChannelWrapper.vue
msgctxt "channel.rowLabel"
msgid "{type}: {name}"
msgstr "{type}: {name}"

#. aria-label of a row in the sidebar's network list that has unread messages or mentions. {type} is the kind of window (see the channel.type.* keys), {name} is the channel name or nickname, {extra} is a count phrase such as '3 mentions'.
#: client/components/ChannelWrapper.vue
msgctxt "channel.rowLabelCount"
msgid "{type}: {name} ({extra})"
msgstr "{type}: {name} ({extra})"

#. Names the kind of window in a sidebar row's aria-label: a chat channel. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.channel"
msgid "Channel"
msgstr "Canal"

#. Names the kind of window in a sidebar row's aria-label: the chat network's own window. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.lobby"
msgid "Network"
msgstr "Réseau"

#. Names the kind of window in a sidebar row's aria-label: a private conversation with one person. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.query"
msgid "Conversation"
msgstr ""

#. Names the kind of window in a sidebar row's aria-label: a results window such as a channel list or a ban list. Substituted as {type} in channel.rowLabel.
#: client/components/ChannelWrapper.vue
msgctxt "channel.type.special"
msgid "List"
msgstr "Liste"

#. Tooltip and aria-label of the spinner in a chat window's header while the connection is being established, when the network's display name is not known.
#: client/components/Chat.vue:186
msgctxt "chat.connecting"
msgid "Connecting…"
msgstr "En cours de connexion…"

#. Tooltip and aria-label of the spinner in a chat window's header while that network's connection is being established. {network} is the display name of the chat network.
#: client/components/Chat.vue:186
msgctxt "chat.connectingTo"
msgid "Connecting to {network}…"
msgstr "Connexion à {network}…"

#. aria-label of the ☰ button in a chat window's header; clicking opens the menu of actions for the current conversation.
#: client/components/Chat.vue:72
msgctxt "chat.contextMenu"
msgid "Open the context menu"
msgstr "Ouvrir le menu contextuel"

#. aria-label of the conversation's name in the header of an open chat window (the visible text is the channel or conversation name itself). {type} is the kind of conversation, inserted as an English word by the app: 'channel' (a group chat), 'query' (a private one-on-one chat), 'lobby' (the network's home view) or 'special' (a list window such as the ban list).
#: client/components/Chat.vue:22
msgctxt "chat.currentlyOpen"
msgid "Currently open {type}"
msgstr "Actuellement ouvert {type}"

#. Text of the 'load older messages' button at the top of the scrollback while earlier history is being fetched.
#: client/components/MessageList.vue:10
msgctxt "chat.historyLoading"
msgid "Loading…"
msgstr "En charge…"

#. aria-label of the downward-arrow button that appears above the message input when the scrollback is scrolled up; clicking scrolls down to the newest messages.
#: client/components/Chat.vue:106
msgctxt "chat.jumpToRecent"
msgid "Jump to recent messages"
msgstr "Saute aux messages récents"

#. aria-label of the @ button in a chat window's header; clicking opens the popup listing messages that mention you.
#: client/components/Chat.vue:67
msgctxt "chat.mentions"
msgid "Open your mentions"
msgstr "Ouvre les mentions"

#. aria-label of the save control at the right end of the topic editor, shown while the channel topic is being edited; clicking saves the new topic.
#: client/components/Chat.vue:35
msgctxt "chat.saveTopic"
msgid "Save topic"
msgstr "Enregistrer le sujet"

#. Text of the button at the top of the scrollback that fetches and shows earlier history of the conversation.
#: client/components/MessageList.vue:11
msgctxt "chat.showOlder"
msgid "Show older messages"
msgstr "Afficher les messages plus anciens"

#. Tooltip and aria-label of the button in a chat window's header that shows and hides the panel listing the channel's members.
#: client/components/Chat.vue:78
msgctxt "chat.toggleUserlist"
msgid "Toggle user list"
msgstr "Alterner entre la liste des utilisateurs"

#. Placeholder of the input field shown while the channel topic is being edited (double-click the topic line to open it); Enter saves.
#: client/components/Chat.vue:30
msgctxt "chat.topicPlaceholder"
msgid "Set channel topic"
msgstr "Définir le sujet du canal"

#. Confirmation after /alias <name> <commands> created a new alias. {name} is the alias name as typed, verbatim.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.added"
msgid "Alias /{name} added."
msgstr "Alias /{name} ajouté."

#. Error when an /alias name is invalid. {max} is the length limit, a number.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.badName"
msgid "Alias names are letters, digits, _ and - (up to {max} characters)."
msgstr "Les noms d'alias sont des lettres, des chiffres, _, et - (jusqu'à {max} caractères)."

#. Reply to /alias <name> when that alias does not exist. {name} is the name as typed, user input, verbatim; the second '/alias …' part is command syntax.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.missing"
msgid "No alias /{name}. /alias {name} <commands> creates it."
msgstr "Aucun alias /{name}. /alias {name} <commandes> le crée."

#. Reply to a bare /alias when none are defined; the '/alias <name> <commands>' part is command syntax and stays verbatim.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.none"
msgid "No aliases defined. /alias <name> <commands> creates one."
msgstr "Aucun alias défini. /alias <nom> <commandes> en crée un."

#. Error when an /alias body exceeds the size limit. {length} and {max} are byte counts.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.tooLong"
msgid "That alias is too long ({length} of at most {max} characters)."
msgstr "Cet alias est trop long ({length} de maximum {max} caractères)."

#. Error when a new alias would exceed the count limit. {max} is the limit, a number; 'Settings → Aliases' names the settings tab where aliases are edited.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.tooMany"
msgid "You already have {max} aliases; delete one in Settings → Aliases first."
msgstr "Vous avez déjà {max} alias ; supprimez-en un d'abord dans Paramètres → Alias."

#. Confirmation after /alias <name> <commands> overwrote an existing alias. {name} is the alias name as typed, verbatim.
#: client/js/irc/commands/alias.ts
msgctxt "cmd.alias.updated"
msgid "Alias /{name} updated."
msgstr "L'alias /{name} a été mis à jour."

#. Error when /connect is typed for a network that is already up.
#: client/js/irc/commands/connect.ts
msgctxt "cmd.alreadyConnected"
msgid "You are already connected."
msgstr "Vous êtes déjà connecté."

#. Error when a command that needs a conversation is typed in a network's lobby. {cmd} is the command as typed, user input, verbatim.
#: client/js/irc/commands/me.ts
#: client/js/irc/commands/react.ts
msgctxt "cmd.channelsAndQueriesOnly"
msgid "{cmd} command can only be used in channels and queries."
msgstr "La commande {cmd} peut être utilisée uniquement dans les canaux et les requêtes."

#. Error when a channel-only command is typed in another window. {cmd} is the command as typed (its canonical lowercase name, e.g. 'ban', 'kickban', 'op'), user input, verbatim.
#: client/js/irc/commands/ban.ts
#: client/js/irc/commands/kick.ts
#: client/js/irc/commands/mode.ts
#: client/js/irc/commands/topic.ts
#: client/js/irc/commands/invite.ts
msgctxt "cmd.channelsOnly"
msgid "{cmd} command can only be used in channels."
msgstr "La commande {cmd} peut être utilisée uniquement dans les canaux."

#. Error when /invite is typed outside a channel without naming one. {cmd} is the command as typed, user input, verbatim.
#: client/js/irc/commands/invite.ts
msgctxt "cmd.channelsOrTargetOnly"
msgid "{cmd} command can only be used in channels or by specifying a target."
msgstr "La commande {cmd} peut être utilisée uniquement dans les canaux ou en spécifiant une cible."

#. Confirmation after /ignore. {mask} is the hostmask, user data, wrapped in bold formatting codes, verbatim.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.added"
msgid "{mask} added to ignorelist"
msgstr "{mask} ajouté à la liste d'ignorance"

#. Error when /ignore names a hostmask that is already on the ignore list.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.already"
msgid "The specified user/hostmask is already ignored"
msgstr "L'utilisateur/hôte spécifié est déjà ignoré"

#. Error when /unignore names a hostmask that is not on the ignore list.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.notIgnored"
msgid "The specified user/hostmask is not ignored"
msgstr "L'utilisateur/hôte spécifié n'est pas ignoré"

#. Confirmation after /unignore. {mask} is the hostmask, user data, wrapped in bold formatting codes, verbatim.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.removed"
msgid "Successfully removed {mask} from ignorelist"
msgstr "{mask} a été correctement supprimé de la liste d'ignorance"

#. Error when /ignore names the user's own nick.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.ignore.self"
msgid "You can't ignore yourself"
msgstr "Vous ne pouvez pas ignorer vous-même"

#. Error shown instead of the ignore-list window when nothing is ignored.
#: client/js/irc/commands/ignorelist.ts
msgctxt "cmd.ignorelistEmpty"
msgid "Ignorelist is empty"
msgstr "La liste d'ignorance est vide"

#. Title of the special window showing the network's ignore list, opened by /ignorelist. The name doubles as the window's lookup name, so it stays byte-stable per locale while the session lives.
#: client/js/irc/commands/ignorelist.ts
msgctxt "cmd.ignorelistTitle"
msgid "Ignored users"
msgstr "Utilisateurs ignorés"

#. Error when a plain message is typed in a network's lobby instead of a channel or query; the lobby's input is for commands.
#: client/js/irc/commands/index.ts
msgctxt "cmd.lobbySend"
msgid "Messages can not be sent to lobbies."
msgstr "Les messages ne peuvent pas être envoyés aux salons"

#. Error when /mute or /unmute names several channels or users with no open window. {targets} is the comma-joined list of names as typed, user input, verbatim. Plural for more than one name.
#: client/js/irc/commands/mute.ts
msgctxt "cmd.mute.nonePlural"
msgid "No open channels or users found for {targets}"
msgstr "Aucun canal ou utilisateur ouvert trouvé pour {targets}"

#. Error when /mute or /unmute names a channel or user that has no open window. {targets} is the comma-joined list of names as typed, user input, verbatim. Singular for one name.
#: client/js/irc/commands/mute.ts
msgctxt "cmd.mute.noneSingular"
msgid "No open channel or user found for {targets}"
msgstr "Aucun canal ou utilisateur ouvert trouvé pour {targets}"

#. Error when /nick is given a new nick containing spaces.
#: client/js/irc/commands/nick.ts
msgctxt "cmd.nickSpaces"
msgid "Nicknames may not contain spaces."
msgstr "Les surnoms ne peuvent pas contenir d'espace."

#. Error when /nick is given a new nick that exceeds the server's reported length limit.
#: client/js/irc/commands/nick.ts
msgctxt "cmd.nickTooLong"
msgid "Nicknames may not be this long."
msgstr "Les surnoms ne peuvent pas être aussi longs."

#. Error when /part is typed in a network's lobby; the '/quit' part is a command name, verbatim.
#: client/js/irc/commands/part.ts
msgctxt "cmd.partLobby"
msgid "You can not part from networks, use /quit instead."
msgstr "Vous ne pouvez pas quitter les réseaux, utilisez /quit au lieu de cela."

#. Error when /query is given a channel name; the '/join' part is a command name, verbatim.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.channel"
msgid "You can not open query windows for channels, use /join instead."
msgstr "Vous ne pouvez pas ouvrir des fenêtres de requête pour les canaux, utilisez /join au lieu de cela."

#. Error when /query is typed with no nick.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.noArg"
msgid "You cannot open a query window without an argument."
msgstr "Vous ne pouvez pas ouvrir une fenêtre de requête sans argument."

#. Error when /query is given a name starting with a channel membership prefix (~&@%+); a prefixed nick needs the prefix dropped.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.prefix"
msgid "You can not open query windows for names starting with a user prefix."
msgstr "Vous ne pouvez pas ouvrir des fenêtres de requête pour des noms commençant par un préfixe d'utilisateur."

#. Error when /query is given a name with spaces; nicks cannot contain them.
#: client/js/irc/commands/msg.ts
msgctxt "cmd.query.spaces"
msgid "You can not open query windows for names containing spaces."
msgstr "Vous ne pouvez pas ouvrir des fenêtres de requête pour des noms contenant des espaces."

#. Error when /react is typed where no recent message can carry a reaction (e.g. a window without message-tags history).
#: client/js/irc/commands/react.ts
msgctxt "cmd.reactNoTarget"
msgid "No message to react to: none here carries a msgid."
msgstr "Aucun message à réagir : aucun ici n'a un msgid."

#. Error when /rejoin is typed outside a channel window.
#: client/js/irc/commands/rejoin.ts
msgctxt "cmd.rejoinChannels"
msgid "You can only rejoin channels."
msgstr "Vous pouvez uniquement reprendre les canaux."

#. Usage line of /ctcp when arguments are missing; the placeholders are command syntax.
#: client/js/irc/commands/ctcp.ts
msgctxt "cmd.usageCtcp"
msgid "Usage: /ctcp <nick> <ctcp_type>"
msgstr "Utilisation : /ctcp <nick> <ctcp_type>"

#. Usage line of /ignore and /unignore when no target is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/ignore.ts
msgctxt "cmd.usageIgnore"
msgid "Usage: /{cmd} <nick>[!ident][@host]"
msgstr "Utilisation : /{cmd} <nick>[!ident][@host]"

#. Usage line of /join when no channel is given; the placeholders are command syntax.
#: client/js/irc/commands/join.ts
msgctxt "cmd.usageJoin"
msgid "Usage: /join <channel> [key]"
msgstr "Utilisation : /join <channel> [key]"

#. Usage line of the mode-list commands (/ban, /unban, …) when no nick is given. {cmd} is the command as typed, user input, verbatim; the '<nick>' placeholder is command syntax, not user data.
#: client/js/irc/commands/ban.ts
msgctxt "cmd.usageNick"
msgid "Usage: /{cmd} <nick>"
msgstr "Utilisation : /{cmd} <nick>"

#. Usage line of /nick when no new nick is given; the placeholder is command syntax.
#: client/js/irc/commands/nick.ts
msgctxt "cmd.usageNickChange"
msgid "Usage: /nick <your new nick>"
msgstr "Utilisation : /nick <votre nouveau pseudonyme>"

#. Usage line of /op, /deop, /voice, /devoice when no nick is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/mode.ts
msgctxt "cmd.usageNickMulti"
msgid "Usage: /{cmd} <nick> [...nick]"
msgstr "Utilisation : /{cmd} <nick> [...nick]"

#. Usage line of /react when no reaction text is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/react.ts
msgctxt "cmd.usageReact"
msgid "Usage: /{cmd} <text> [msgid]"
msgstr "Utilisation : /{cmd} <texte> [msgid]"

#. Usage line of /redact when no msgid is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
#: client/js/irc/commands/redact.ts
msgctxt "cmd.usageRedact"
msgid "Usage: /{cmd} <msgid> [reason]"
msgstr "Utilisation : /{cmd} <msgid> [raison]"

#. Usage line of /ver (a CTCP VERSION request) when it is not given exactly one nick; the rest is command syntax.
#: client/js/irc/commands/ctcp.ts
msgctxt "cmd.usageVer"
msgid "Usage: /ver <nick>"
msgstr "Utilisation : /ver <nick>"

#. Button under a long code block in a chat message that shows only its first lines; clicking reveals every line. {count} is the number of lines of code. The singular shows with exactly one line, the plural otherwise.
#: client/components/CodeBlock.vue
msgctxt "code.showAllLines"
msgid "Show all {count} line"
msgid_plural "Show all {count} lines"
msgstr[0] "Afficher tous {count} ligne"
msgstr[1] "Afficher toutes les lignes {count}"

#. Button under a long code block in a chat message while all of its lines are shown; clicking folds the block back to its first lines.
#: client/components/CodeBlock.vue
msgctxt "code.showLess"
msgid "Show less"
msgstr "Afficher moins"

#. aria-label of the ✕ button that leaves reply or edit mode in the compose bar above the message input; the keyboard key Escape does the same.
#: client/components/ChatInput.vue:67
msgctxt "composer.cancel"
msgid "Cancel"
msgstr "Annuler"

#. Tooltip of the ✕ button that leaves reply or edit mode in the compose bar; it names the keyboard key that does the same thing.
#: client/components/ChatInput.vue:68
msgctxt "composer.cancelEscape"
msgid "Cancel (Escape)"
msgstr "Annuler (Échappement)"

#. Tooltip and aria-label of the ✕ button on the upload progress bar above the message input; clicking it aborts the upload in progress.
#: client/components/ChatInput.vue:45
msgctxt "composer.cancelUpload"
msgid "Cancel upload"
msgstr "Annuler l'upload"

#. Button in the connection bar shown above the message input when the connection to the chat network is down and no automatic retry is in progress; clicking it dials the network again.
#: client/components/ChatInput.vue:19
msgctxt "composer.connect"
msgid "Connect"
msgstr "Se connecter"

#. Button in the connection bar shown above the message input while the app waits to retry a dropped connection to the chat network; clicking it skips the wait and dials the network immediately.
#: client/components/ChatInput.vue:19
msgctxt "composer.connectNow"
msgid "Connect now"
msgstr "Se connecter maintenant"

#. Text of the connection bar shown above the message input while the dial to the chat network is in flight (a spinner turns beside it). {network} is the display name of the chat network.
#: client/components/ChatInput.vue:344
msgctxt "composer.connectingTo"
msgid "Connecting to {network}…"
msgstr "Connexion à {network}…"

#. Text of the connection bar shown above the message input when the chat network is down and no reconnect attempt is running yet. {network} is the display name of the chat network.
#: client/components/ChatInput.vue:339
msgctxt "composer.disconnectedFrom"
msgid "Disconnected from {network}."
msgstr "Déconnecté de {network}."

#. Label at the left of the compose bar shown while the user edits a message they already sent; the edited text follows it in the same line.
#: client/components/ChatInput.vue:55
msgctxt "composer.editing"
msgid "Editing message"
msgstr "Edition du message"

#. Fallback name for a chat network whose configured name is empty; it is inserted into connection-bar sentences such as 'Connecting to {network}…' in place of the network name. Mid-sentence by position.
#: client/components/ChatInput.vue:336
msgctxt "composer.fallbackNetwork"
msgid "the network"
msgstr "Le réseau"

#. Visually hidden label of the message input field, read by screen readers; the field is where chat messages are typed.
#: client/components/ChatInput.vue:75
msgctxt "composer.inputLabel"
msgid "Message input"
msgstr "Entrée de message"

#. Tooltip on the send button while the chat network is disconnected, explaining why messages cannot be sent right now.
#: client/components/ChatInput.vue:115
msgctxt "composer.notConnected"
msgid "Not connected"
msgstr "Pas connecté"

#. Placeholder of the message input shown while it is empty. {name} is the name of the conversation being typed into: a channel's name, or the person's nick in a private one-on-one conversation.
#: client/components/ChatInput.vue:293
msgctxt "composer.placeholder"
msgid "Write to {name}"
msgstr "Écrire à {name}"

#. Text of the connection bar shown above the message input while the client waits to reconnect to a chat network it lost. {network} is the display name of the chat network; {seconds} is the whole number of seconds until the retry starts, updating every half second. The singular form shows when one second remains, the plural for any other number.
#: client/components/ChatInput.vue:343
msgctxt "composer.reconnectIn"
msgid "Reconnecting to {network} in {seconds}s…"
msgid_plural "Reconnecting to {network} in {seconds}s…"
msgstr[0] "Réconnexion à {network} en {seconds}s…"
msgstr[1] "Reconnection à {network} dans {seconds}s…"

#. Label at the left of the compose bar shown while a reply is being written. {nick} is the name of the user being replied to, shown emphasized; the quoted message preview follows it. Keep the trailing colon.
#: client/components/ChatInput.vue:60
msgctxt "composer.replyingTo"
msgid "Replying to {nick}:"
msgstr "Répondre à {nick} :"

#. Tooltip and aria-label of the send button beside the message input.
#: client/components/ChatInput.vue:123
msgctxt "composer.send"
msgid "Send message"
msgstr "Envoyer message"

#. Tooltip and aria-label of the paperclip button beside the message input; clicking it opens the file picker to send a file into the conversation.
#: client/components/ChatInput.vue:93
msgctxt "composer.uploadFile"
msgid "Upload file"
msgstr "Télécharger fichier"

#. Part of the upload progress bar, appended after the uploading text when several files are queued: it says which file of how many is being sent now. {index} is the number of the current file, {count} the total number queued.
#: client/components/ChatInput.vue:580
msgctxt "composer.uploadIndex"
msgid "{index} of {count}"
msgstr "{index} de {count}"

#. Part of the upload progress bar, appended after the uploading text while the file is being prepared (re-encoded or stripped of metadata) before it is sent. Starts lowercase because it is joined with the other parts into one line.
#: client/components/ChatInput.vue:584
msgctxt "composer.uploadPreparing"
msgid "preparing…"
msgstr "Préparation…"

#. Part of the upload progress bar, appended after the uploading text while the file has been sent and the chat server has not confirmed it yet. Starts lowercase because it is joined with the other parts into one line.
#: client/components/ChatInput.vue:586
msgctxt "composer.uploadWaiting"
msgid "waiting for the server…"
msgstr "En attente du serveur…"

#. First part of the upload progress bar shown above the message input while a file is being sent to the chat server. {file} is the name of the file currently going up.
#: client/components/ChatInput.vue:577
msgctxt "composer.uploading"
msgid "Uploading {file}"
msgstr "Téléchargement de {file}"

#. Condensed status block: away markings while the block was collapsed. The singular shows 'once' when one marking happened, the plural the number of markings; {count} is that number.
#: client/components/MessageCondensed.vue
msgctxt "condensed.away"
msgid "marked away once"
msgid_plural "marked away {count} times"
msgstr[0] "Marqué hors ligne une fois"
msgstr[1] "marqué loin {count} fois"

#. Condensed status block: back markings while the block was collapsed. The singular shows 'once' when one marking happened, the plural the number of markings; {count} is that number.
#: client/components/MessageCondensed.vue
msgctxt "condensed.back"
msgid "marked back once"
msgid_plural "marked back {count} times"
msgstr[0] "Marqué en ligne une fois"
msgstr[1] "marqué près {count} fois"

#. Condensed status block: {count} users changed their username/hostname while the block was collapsed.
#: client/components/MessageCondensed.vue
msgctxt "condensed.chghost"
msgid "{count} user has changed hostname"
msgid_plural "{count} users have changed hostname"
msgstr[0] "{count} utilisateur a changé d'hôte"
msgstr[1] "{count} utilisateurs ont changé le nom d'hôte"

#. Condensed status block: {count} users joined while the block was collapsed. The counts of several kinds join into one sentence in the active locale's list format.
#: client/components/MessageCondensed.vue
msgctxt "condensed.join"
msgid "{count} user has joined"
msgid_plural "{count} users have joined"
msgstr[0] "{count} utilisateur a rejoint"
msgstr[1] "{count} utilisateurs ont rejoint"

#. Condensed status block: {count} users were kicked while the block was collapsed.
#: client/components/MessageCondensed.vue
msgctxt "condensed.kicked"
msgid "{count} user was kicked"
msgid_plural "{count} users were kicked"
msgstr[0] "{count} utilisateur a été expulsé"
msgstr[1] "{count} users have been kicked"

#. Condensed status block: {count} users left the channel (quits are counted as parts) while the block was collapsed.
#: client/components/MessageCondensed.vue
msgctxt "condensed.left"
msgid "{count} user has left"
msgid_plural "{count} users have left"
msgstr[0] "{count} utilisateur a quitté"
msgstr[1] "{count} utilisateurs sont partis"

#. Condensed status block: {count} channel-mode changes were set while the block was collapsed (one MODE line can carry several).
#: client/components/MessageCondensed.vue
msgctxt "condensed.modes"
msgid "{count} mode was set"
msgid_plural "{count} modes were set"
msgstr[0] "{count} mode a été défini"
msgstr[1] "{count} modes ont été définis"

#. Condensed status block: {count} users renamed while the block was collapsed.
#: client/components/MessageCondensed.vue
msgctxt "condensed.nick"
msgid "{count} user has changed nick"
msgid_plural "{count} users have changed nick"
msgstr[0] "{count} utilisateur a changé de pseudonyme"
msgstr[1] "{count} utilisateurs ont changé de nick"

#. aria-label of the small toggle button that expands or collapses the condensed status block in a channel's scrollback.
#: client/components/MessageCondensed.vue
msgctxt "condensed.toggle"
msgid "Toggle status messages"
msgstr "Alterner les messages d'état"

#. Button of every confirmation dialog in the app (delete message, delete network, restore settings, clear history…); clicking declines and closes the dialog.
#: client/components/ConfirmDialog.vue
msgctxt "confirm.cancel"
msgid "Cancel"
msgstr "Annuler"

#. Label of the services account (login name) text field on the connect form and on the network edit form.
#: client/components/Windows/Connect.vue:34
#: client/components/Windows/Connect.vue:213
msgctxt "connect.account"
msgid "Account"
msgstr "Compte"

#. aria-label of the whole connect screen (the window/dialog element); announced by screen readers on arriving at the form.
#: client/components/Windows/Connect.vue:7
msgctxt "connect.ariaLabel"
msgid "Connect"
msgstr "Se connecter"

#. Heading of the authentication section on the connect form (the SASL toggle and account fields follow).
#: client/components/Windows/Connect.vue:201
msgctxt "connect.authentication"
msgid "Authentication"
msgstr "Authentification"

#. Checkbox on the connect form: dial this network every time the app opens.
#: client/components/Windows/Connect.vue:290
msgctxt "connect.autoconnect"
msgid "Connect automatically when the app starts"
msgstr "Connecter automatiquement lors du lancement de l'application"

#. Checkbox at the bottom of the connect form: show desktop notifications for this network's messages; the browser's permission ask fires when it is first switched on.
#: client/components/Windows/Connect.vue:280
msgctxt "connect.browserNotifications"
msgid "Browser notifications for this network"
msgstr "Notifications du navigateur pour ce réseau"

#. Label of the field listing channels to join automatically after connecting, on the connect and network edit forms.
#: client/components/Windows/Connect.vue:188
msgctxt "connect.channels"
msgid "Channels"
msgstr "Canaux"

#. Placeholder of the channels field on the connect form: example channel names, and a note that the field may stay empty.
#: client/components/Windows/Connect.vue:194
msgctxt "connect.channelsPlaceholder"
msgid "#channel, #another (optional)"
msgstr "#channel, #another (optionnel)"

#. Status line shown on the connect form right after submitting: the nick used and the network name (or host:port of the server) being dialled.
#: client/components/Windows/Connect.vue:84
#: client/components/Windows/Connect.vue:308
msgctxt "connect.connectingAs"
msgid "Connecting as {nick} to {network}…"
msgstr "Connexion en tant que {nick} pour {network}…"

#. Lobby status line while a chat network is being dialled. {host} and {port} come from the saved network's settings.
#: client/js/irc/client.ts
msgctxt "connect.connectingTo"
msgid "Connecting to {host}:{port}…"
msgstr "Connexion vers {host}:{port}…"

#. Lobby status line while an automatic retry dials a chat network; {attempt} counts the retries this connection has seen.
#: client/js/irc/client.ts
msgctxt "connect.connectingToAttempt"
msgid "Connecting to {host}:{port}… (attempt {attempt})"
msgstr "Connexion vers {host}:{port}… (tentative {attempt})"

#. Lobby status line when the user's own /quit closed the connection on purpose.
#: client/js/irc/client.ts
msgctxt "connect.disconnected"
msgid "Disconnected."
msgstr "Déconnecté."

#. Lobby status line after registration naming the IRCv3 capabilities the server enabled; {caps} is a comma-separated list of protocol tokens, never translated.
#: client/js/irc/client.ts
msgctxt "connect.enabledCaps"
msgid "Enabled capabilities: {caps}"
msgstr "Fonctionnalités activées : {caps}"

#. Notice on the connect form when it was opened by a link to a saved network whose password was not remembered; {account} is the services account name.
#: client/components/Windows/Connect.vue:572
msgctxt "connect.enterPassword"
msgid "Enter the password for {account} to connect."
msgstr "Entrer le mot de passe pour {account} pour se connecter."

#. Error notice shown under the guest sign-in form when the guest nick field was left empty or invalid.
#: client/components/Windows/Connect.vue:672
msgctxt "connect.guestNickRequired"
msgid "Choose a nick to connect as a guest."
msgstr "Choisir un pseudonyme pour vous connecter en tant que invité."

#. Button that connects with just a nick instead of an account.
#: client/js/branding.ts
msgctxt "connect.guestSubmit"
msgid "Connect as guest"
msgstr "Se connecter en tant qu'invité"

#. Heading of the guest half of the sign-in form (features.guestAccess on).
#: client/js/branding.ts
msgctxt "connect.guestTitle"
msgid "No account?"
msgstr "Aucun compte ?"

#. Notice at the top of the connect form when a web+irc:// link named a server the deploy does not allow; {network} is this deploy's network name, {host} the refused server.
#: client/components/Windows/Connect.vue:608
msgctxt "connect.linkIgnored"
msgid "This app only connects to {network}. The link to {host} was ignored."
msgstr "Cette application se connecte uniquement à {network}. Le lien vers {host} a été ignoré."

#. Notice on the connect approval dialog opened from a web+irc:// link without channels; {host}:{port} is the proposed server.
#: client/components/Windows/Connect.vue:610
msgctxt "connect.linkSuggest"
msgid "This link suggests connecting to {host}:{port}. Nothing is saved until you choose to connect."
msgstr "Ce lien suggère de se connecter à {host}:{port}. Rien n'est enregistré jusqu'à ce que vous choisissiez de vous connecter."

#. Notice on the connect approval dialog opened from a web+irc:// link that also names channels to join; {channels} is the comma-separated channel list.
#: client/components/Windows/Connect.vue:611
msgctxt "connect.linkSuggestJoin"
msgid "This link suggests connecting to {host}:{port} and joining {channels}. Nothing is saved until you choose to connect."
msgstr "Ce lien suggère de se connecter à {host}:{port} et de rejoindre {channels}. Rien n'est enregistré jusqu'à ce que vous choisissiez de vous connecter."

#. Read-only row label on the connect/sign-in form, above the name of the network being connected to (shown instead of an editable server field).
#: client/components/Windows/Connect.vue:28
#: client/components/Windows/Connect.vue:126
msgctxt "connect.network"
msgid "Network"
msgstr "Réseau"

#. Heading of the connect form when it opened from a web+irc:// link that proposes a server the user has not approved yet.
#: client/components/Windows/Connect.vue:118
msgctxt "connect.newServerTitle"
msgid "Connect to a new server?"
msgstr "Se connecter à un nouveau serveur ?"

#. Label of the nickname text field: on the connect form and in the guest half of the sign-in panel.
#: client/components/Windows/Connect.vue:101
#: client/components/Windows/Connect.vue:173
msgctxt "connect.nick"
msgid "Nick"
msgstr "Pseudonyme"

#. Dismiss button on the connect screen shown as a dialog when the user followed a web+irc:// link; declines the connection without disconnecting the app.
#: client/components/Windows/Connect.vue:91
#: client/components/Windows/Connect.vue:315
msgctxt "connect.notNow"
msgid "Not now"
msgstr "Pas maintenant"

#. Label of the account password field on the connect form, sign-in panel and network edit form; the field has a show/hide eye toggle.
#: client/components/Windows/Connect.vue:46
#: client/components/Windows/Connect.vue:228
msgctxt "connect.password"
msgid "Password"
msgstr "Mot de passe"

#. Checkbox in the authentication section of the connect form: register this device for push notifications once the IRC server supports it.
#: client/components/Windows/Connect.vue:251
msgctxt "connect.pushNotifications"
msgid "Push notifications (registers when the server supports them)"
msgstr "Notifications de push (envoyées lorsque le serveur les prend en charge)"

#. Lobby status line when the network was disconnected while an automatic reconnect was still scheduled.
#: client/js/irc/client.ts
msgctxt "connect.reconnectCancelled"
msgid "Reconnect cancelled."
msgstr "Réconnexion annulée."

#. Checkbox on the sign-in form: remember the account and reconnect on the next load.
#: client/js/branding.ts
msgctxt "connect.rememberMe"
msgid "Stay signed in on this device"
msgstr "Rester connecté sur ce dispositif"

#. Checkbox under the SASL password field on the connect form: keep the password in this browser's storage so reconnects need no typing.
#: client/components/Windows/Connect.vue:264
msgctxt "connect.rememberPassword"
msgid "Remember password on this device"
msgstr "Garder le mot de passe sur ce dispositif"

#. Lobby error when the login the deploy asked for did not go through; {reason} is one of the connect.saslReason* copies (or, for a few server-side rejections, a technical phrase left verbatim).
#: client/js/irc/client.ts
msgctxt "connect.saslFailed"
msgid "SASL authentication failed: {reason}"
msgstr "Authentification SASL échouée : {reason}"

#. Lobby status line listing the SASL mechanisms the server offers (902-adjacent RPL_SASLMECHS). {mechanisms} is the server's comma-separated token list, verbatim.
#: client/js/irc/sasl.ts
msgctxt "connect.saslMechanisms"
msgid "Available SASL mechanisms: {mechanisms}"
msgstr "Mécanismes SASL disponibles : {mechanisms}"

#. Lobby error after a failed required SASL login: the network was dropped instead of registering unauthenticated. {host} is the chat network's configured host name.
#: client/js/irc/client.ts
msgctxt "connect.saslQuitHint"
msgid "Not connecting to {host} without the login you asked for."
msgstr "Pas de connexion à {host} sans le login que vous avez demandé."

#. Lobby error after a required SASL login that merely timed out (a slow login service, not a wrong password): the connection is redialled on the usual schedule. {host} is the configured host name.
#: client/js/irc/client.ts
msgctxt "connect.saslQuitHintRetry"
msgid "Not connecting to {host} without the login you asked for; trying again."
msgstr "Pas de connexion à {host} sans le login que vous avez demandé ; tentative de réconnexion."

#. Reason fragment of 'SASL authentication failed: {reason}' when the server's AUTHENTICATE challenge is not the empty one PLAIN and EXTERNAL expect. {mechanism} is the mechanism token, verbatim. Lowercase mid-sentence by position.
#: client/js/irc/sasl.ts
msgctxt "connect.saslReason.badChallenge"
msgid "unexpected challenge for {mechanism}"
msgstr "challenge inattendu pour {mechanism}"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server rejected the client's request for the sasl capability (CAP NAK). Lowercase mid-sentence by position.
#: client/js/irc/handlers/cap.ts
msgctxt "connect.saslReason.capRefused"
msgid "the server refused the sasl capability"
msgstr "Le serveur a refusé la fonctionnalité SASL"

#. Reason fragment of 'SASL authentication failed: {reason}' when the saved network has no login credentials. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.noCredentials"
msgid "no account name or password is configured"
msgstr "Aucun nom d'utilisateur ou mot de passe configuré"

#. Reason fragment of 'SASL authentication failed: {reason}' when a SASL failure numeric carries no text of its own. {code} is the numeric, verbatim. Lowercase mid-sentence by position.
#: client/js/irc/sasl.ts
msgctxt "connect.saslReason.numeric"
msgid "numeric {code}"
msgstr "Code {code}"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server took too long to answer the login. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.timeout"
msgid "timed out waiting for the server"
msgstr "Timeout en attente du serveur"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server announced no usable sasl capability. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.unavailable"
msgid "the server does not offer SASL"
msgstr "Le serveur ne propose pas SASL"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server's rejection named no cause. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.unknown"
msgid "unknown error"
msgstr "Erreur inconnue"

#. Reason fragment of 'SASL authentication failed: {reason}' when the server's SASL mechanisms do not include the saved network's. {offered} and {mechanism} are protocol mechanism tokens, never translated.
#: client/js/irc/client.ts
msgctxt "connect.saslReason.wrongMechanism"
msgid "the server offers SASL {offered}, not {mechanism}"
msgstr "le serveur propose SASL {offered}, pas {mechanism}"

#. Follow-up to a failed required SASL login, telling the reader where to fix or drop the credentials.
#: client/js/irc/client.ts
msgctxt "connect.saslRequiredHint"
msgid "Check the account name and password in this network's settings, or pick \"No authentication\" there to connect without logging in."
msgstr "Vérifiez le nom de compte et le mot de passe dans les paramètres de ce réseau, ou sélectionnez \"Aucune authentification\" pour vous connecter sans vous identifier."

#. Checkbox on the connect form: reveals the account name and password fields used to authenticate with network services (SASL).
#: client/components/Windows/Connect.vue:207
msgctxt "connect.saslToggle"
msgid "I have a services account (SASL)"
msgstr "J'ai un compte de service (SASL)"

#. The IRC server section of the connect form: heading above the server fields, and the label of the server host field.
#: client/components/Windows/Connect.vue:124
#: client/components/Windows/Connect.vue:132
msgctxt "connect.server"
msgid "Server"
msgstr "Serveur"

#. aria-label of the server host text input (e.g. irc.example.org) on the connect form; the visible label is on the row.
#: client/components/Windows/Connect.vue:139
msgctxt "connect.serverAddress"
msgid "Server address"
msgstr "Adresse du serveur"

#. aria-label of the numeric port input next to the server host field on the connect form.
#: client/components/Windows/Connect.vue:156
msgctxt "connect.serverPort"
msgid "Server port"
msgstr "Port du serveur"

#. Intro line above the sign-in form; intentionally empty by default, fill only if the deploy wants one.
#: client/js/branding.ts
msgctxt "connect.signInIntro"
msgid ""
msgstr ""

#. Button that submits the sign-in form.
#: client/js/branding.ts
msgctxt "connect.signInSubmit"
msgid "Sign in"
msgstr "Connexion"

#. Heading of the sign-in panel (features.signIn on).
#: client/js/branding.ts
msgctxt "connect.signInTitle"
msgid "Sign in"
msgstr "Connexion"

#. Lobby status line when the connection is dropped to be redialled over TLS. {port} is the secure port the server's policy named.
#: client/js/irc/client.ts
msgctxt "connect.stsReconnect"
msgid "Server requires a secure connection (STS): reconnecting on port {port}…"
msgstr "Le serveur exige une connexion sécurisée (STS) : relancement sur le port {port}…"

#. Lobby status line when the server's strict-transport-security policy upgrades a plain connection to TLS. {port} is the new TLS port.
#: client/js/irc/client.ts
msgctxt "connect.stsUpgrade"
msgid "Upgrading to TLS on port {port} (STS policy)"
msgstr "Mise à jour vers TLS sur le port {port} (politique STS)"

#. Button on the connect form: submits it and dials the server.
#: client/js/branding.ts
msgctxt "connect.submit"
msgid "Connect"
msgstr "Connexion"

#. Heading of the connect form (features.signIn off).
#: client/js/branding.ts
msgctxt "connect.title"
msgid "Connect to IRC"
msgstr "Connexion à IRC"

#. Checkbox under the server fields on the connect form: connect over TLS instead of a plain connection.
#: client/components/Windows/Connect.vue:166
msgctxt "connect.useTls"
msgid "Use secure connection (TLS)"
msgstr "Utiliser une connexion sécurisée (TLS)"

#. Heading of the user section of the connect form (nick, channels, authentication follow below it).
#: client/components/Windows/Connect.vue:171
msgctxt "connect.user"
msgid "User"
msgstr "Utilisateur"

#. Error line the app shows when the connection to the chat server failed (also flashed on the loading splash). {message} is the verbatim technical message from the server or browser — never translate or reword its content.
#: client/js/socket-events/connection.ts
msgctxt "connection.error"
msgid "Connection error: {message}"
msgstr "Erreur de connexion : {message}"

#. Label of a date marker between message groups in the scrollback: tooltip of the divider between the messages sent today.
#: client/components/DateMarker.vue:4
msgctxt "dates.today"
msgid "Today"
msgstr "Aujourd'hui"

#. Label of a date marker between message groups in the scrollback: tooltip of the divider between the messages sent the day before; older groups show the date itself.
#: client/components/DateMarker.vue:4
msgctxt "dates.yesterday"
msgid "Yesterday"
msgstr "Hier"

#. Name of WebSocket close code 1001 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1001"
msgid "server going away"
msgstr "serveur qui part"

#. Name of WebSocket close code 1002 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1002"
msgid "WebSocket protocol error"
msgstr "Erreur de protocole WebSocket"

#. Name of WebSocket close code 1006 (abnormal closure: refused, unreachable, TLS failure — the browser never says which) in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1006"
msgid "connection lost"
msgstr "Connexion perdue"

#. Name of WebSocket close code 1008 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1008"
msgid "policy violation"
msgstr "Violation de politique"

#. Name of WebSocket close code 1009 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1009"
msgid "message too large"
msgstr "Message trop grand"

#. Name of WebSocket close code 1011 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1011"
msgid "server error"
msgstr "Erreur du serveur"

#. Name of WebSocket close code 1012 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1012"
msgid "server restarting"
msgstr "serveur en redémarrage"

#. Name of WebSocket close code 1013 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1013"
msgid "server asked to try again later"
msgstr "serveur demande de réessayer plus tard"

#. Name of WebSocket close code 1015 in a connection-failure report. Lowercase mid-sentence by position.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.code1015"
msgid "TLS handshake failed"
msgstr "main d'authentification TLS échouée"

#. Detail of a connection-failure report when the WebSocket closed with a code the app has no name for. {code} is the numeric close code, verbatim.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.codeUnknown"
msgid "code {code}"
msgstr ""

#. Connection-failure report when the WebSocket never opened. {url} is the address that was dialled, verbatim. {error} is ' (<the browser's error text>)' or empty — the browser hides why a dial failed, so the slot often stays empty.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.couldNotConnect"
msgid "Could not connect to {url}{error}."
msgstr "Impossible de se connecter à {url}{error}."

#. Headline when a network the client is dialling never opened and the retry schedule is standing down (the browser refused or could not reach the address). {url} is the WebSocket URL that was dialled; {error} is the browser's error text in parentheses, or empty.
#: client/js/irc/disconnect.ts:78
msgctxt "disconnect.couldNotConnectNotReconnecting"
msgid "Could not connect to {url}{error}. Not reconnecting."
msgstr "Impossible de se connecter à {url}{error}. Pas de réessai."

#. Connection-failure report once the network was registered. {host} is the network's configured host name, verbatim. {detail} is ' (<server close reason>)', ' (<close-code name>)' or empty.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.disconnected"
msgid "Disconnected from {host}{detail}."
msgstr "Déconnecté de {host}{detail}."

#. Headline when a registered connection closed and the retry schedule is standing down. {host} is the host as the user typed it; {detail} is the close detail in parentheses, or empty.
#: client/js/irc/disconnect.ts:127
msgctxt "disconnect.disconnectedNotReconnecting"
msgid "Disconnected from {host}{detail}. Not reconnecting."
msgstr "Déconnecté de {host}{detail}. Pas de réessai."

#. Follow-up hint under a failed connection dialled with ws:// from an https:// page: the browser blocks mixed content, so the fix is on the network's settings.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.httpsBlocked"
msgid "This page was loaded over HTTPS, so the browser blocks plain ws:// connections. Enable TLS for this network, or open the app over http://."
msgstr "Cette page a été chargée via HTTPS, donc le navigateur bloque les connexions ws:// simples. Activez TLS pour ce réseau, ou ouvrez l'application via http://."

#. Follow-up hint under a failed plain (ws://) dial from a non-secure page.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.plainCauses"
msgid "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or it does not accept WebSocket connections on that port."
msgstr "Le navigateur ne révèle pas la raison. Causes possibles : le serveur est down, le port est incorrect, ou il ne accepte pas les connexions WebSocket sur ce port."

#. Follow-up hint under a connection the server dropped during IRC registration, when the close reason named no live session.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.registration"
msgid "The WebSocket opened but the server dropped it before registration finished - check that this port really speaks IRC over WebSocket, and look for a server notice above for the reason."
msgstr "Le WebSocket est ouvert mais le serveur l'a perdue avant la registration terminée - vérifiez que ce port utilise vraiment IRC via WebSocket, et cherchez un message du serveur ci-dessus pour la raison."

#. Follow-up hint when the server's close reason names a live session: retrying alone cannot fix it, the other client has to go.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.sessionConflict"
msgid "This account is already connected on this network - another tab, window or device is using it. Close that client; this tab then connects on its next retry (a dead connection is reclaimed within about a minute)."
msgstr "Ce compte est déjà connecté sur ce réseau - un autre onglet, fenêtre ou appareil l'utilise. Fermez ce client ; ce onglet se connecte ensuite à la prochaine tentative (une connexion morte est récupérée en environ une minute)."

#. Follow-up hint under a failed secure (wss://) dial. {url} is the network's address with https: in place of wss:, for accepting a self-signed certificate once.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.hint.wssCauses"
msgid "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or its TLS certificate is not trusted — for a self-signed certificate, open {url} in a new tab, accept the warning, then reconnect."
msgstr "Le navigateur ne révèle pas la raison. Causes possibles : le serveur est down, le port est incorrect, ou son certificat TLS n'est pas reconnu — pour un certificat auto-signé, ouvrez {url} dans un nouvel onglet, acceptez l'avertissement, puis reconnectez."

#. Connection-failure report when the server dropped the socket before registration finished. {host} is the network's configured host name, verbatim. {detail} is ' (<server close reason>)', ' (<close-code name>)' or empty.
#: client/js/irc/disconnect.ts
msgctxt "disconnect.registeringClosed"
msgid "Connection to {host} closed during IRC registration{detail}."
msgstr "Connexion à {host} fermée pendant l'enregistrement IRC{detail}."

#. Headline when the connection was closed between connecting and completing IRC registration and the retry schedule is standing down. {host} is the host as the user typed it; {detail} is the close detail in parentheses (a server reason, a connection-lost note or the close code), or empty.
#: client/js/irc/disconnect.ts:112
msgctxt "disconnect.registeringClosedNotReconnecting"
msgid "Connection to {host} closed during IRC registration{detail}. Not reconnecting."
msgstr "Connexion à {host} fermée pendant l'enregistrement IRC{detail}. Pas de réessai."

#. Join refusal (475) phrased by the client. {channel} is the refused channel name, user data, never translated; the '- <cause>.' layout follows the server's cause ordering.
#: client/components/MessageTypes/error.vue
msgctxt "error.badChannelKey"
msgid "Cannot join {channel} - Bad channel key."
msgstr "Impossible de rejoindre {channel} - clé de canal incorrecte."

#. Join refusal (474) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.bannedFromChannel"
msgid "Cannot join {channel} - You have been banned from the channel."
msgstr "Impossible de rejoindre {channel} - vous avez été banni du canal."

#. Send refusal (404) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.cannotSendToChannel"
msgid "Cannot send to channel {channel}"
msgstr "Impossible d'envoyer à la channel {channel}"

#. Join refusal (471) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.channelIsFull"
msgid "Cannot join {channel} - Channel is full."
msgstr "Impossible de rejoindre {channel} - canal plein."

#. Refusal (482) phrased by the client, e.g. a mode change without operator status.
#: client/components/MessageTypes/error.vue
msgctxt "error.chanopPrivsNeeded"
msgid "Cannot perform action: You're not a channel operator."
msgstr "Impossible d'effectuer l'action : vous n'êtes pas opérateur de canal."

#. Join refusal (473) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.inviteOnlyChannel"
msgid "Cannot join {channel} - Channel is invite only."
msgstr "Impossible de rejoindre {channel} - Le canal est uniquement invitable."

#. Error shown in a network's own window when the chat server does not offer a protocol capability the client requires. {caps} is the server's own list of capability names, space separated and never translated.
#: client/js/irc/handlers/cap.ts
msgctxt "error.missingCaps"
msgid "Missing required capabilities: {caps}"
msgstr "Capabilités requises manquantes : {caps}"

#. Send refusal (401) phrased by the client; {nick} is the addressed nick, user data.
#: client/components/MessageTypes/error.vue
msgctxt "error.noSuchNick"
msgid "User {nick} hasn't logged in or does not exist."
msgstr "L'utilisateur {nick} n'a pas encore connecté ou n'existe pas."

#. Refusal (442) phrased by the client, e.g. a topic change from outside.
#: client/components/MessageTypes/error.vue
msgctxt "error.notOnChannel"
msgid "Cannot perform action: You're not on the channel."
msgstr "Impossible d'effectuer l'action : vous n'êtes pas sur le canal."

#. Login refusal (464) phrased by the client.
#: client/components/MessageTypes/error.vue
msgctxt "error.passwordMismatch"
msgid "Password mismatch."
msgstr "Mauvais mot de passe."

#. Join refusal (405) phrased by the client; {channel} is the refused channel name.
#: client/components/MessageTypes/error.vue
msgctxt "error.tooManyChannels"
msgid "Cannot join {channel} - You've already reached the maximum number of channels allowed."
msgstr "Impossible de rejoindre {channel} - Vous avez déjà atteint le nombre maximum de canaux autorisé."

#. Server rejection (421) phrased by the client; {command} is the unknown slash command as typed, user input.
#: client/components/MessageTypes/error.vue
msgctxt "error.unknownCommand"
msgid "Unknown command: {command}"
msgstr "Commande inconnue : {command}"

#. Refusal (441) phrased by the client, e.g. a kick of a user who has left; {nick} is user data.
#: client/components/MessageTypes/error.vue
msgctxt "error.userNotInChannel"
msgid "User {nick} is not on the channel."
msgstr "L'utilisateur {nick} n'est pas sur le canal."

#. Refusal (443) phrased by the client; {nick} is user data.
#: client/components/MessageTypes/error.vue
msgctxt "error.userOnChannel"
msgid "User {nick} is already on the channel."
msgstr "L'utilisateur {nick} est déjà sur le canal."

#. Label of the services account (login name) field on the network edit form, shown when SASL is on.
#: client/components/NetworkForm.vue:168
msgctxt "form.account"
msgid "Account"
msgstr "Compte"

#. Button on the network edit form's status row while a connection is being dialled: stop trying.
#: client/components/NetworkForm.vue:505
msgctxt "form.actionCancel"
msgid "Cancel"
msgstr "Annuler"

#. Button on the network edit form's status row: dial this network now.
#: client/components/NetworkForm.vue:505
msgctxt "form.actionConnect"
msgid "Connect"
msgstr "Se connecter"

#. Button on the network edit form's status row while the network is online: hang up.
#: client/components/NetworkForm.vue:505
msgctxt "form.actionDisconnect"
msgid "Disconnect"
msgstr "Se déconnecter"

#. Note on the network edit form, shown while the network is up: edits to these fields wait for the next connection.
#: client/components/NetworkForm.vue:98
msgctxt "form.applyNote"
msgid "Server, port, TLS, channels and authentication changes apply the next time this network connects (a network that is waiting to reconnect retries right away)."
msgstr "Les modifications du serveur, du port, du TLS, des canaux et de l'authentification s'appliquent la prochaine fois que ce réseau se reconnecte (un réseau en attente de reconnexion le fait tout de suite)."

#. aria-label of the network edit form window (Settings → Networks → a network).
#: client/components/NetworkForm.vue:6
msgctxt "form.ariaEdit"
msgid "Edit network"
msgstr "Editer le réseau"

#. Heading of the authentication section of the network edit form; the radio choices and SASL fields follow.
#: client/components/NetworkForm.vue:154
msgctxt "form.authentication"
msgid "Authentication"
msgstr "Authentification"

#. Checkbox on the network edit form: dial this network every time the app opens.
#: client/components/NetworkForm.vue:90
msgctxt "form.autoconnect"
msgid "Connect automatically when the app starts"
msgstr "Se connecter automatiquement lors du lancement de l'application"

#. Checkbox on the network edit form: show desktop notifications for this network's messages; the browser's permission ask fires when first saved.
#: client/components/NetworkForm.vue:260
msgctxt "form.browserNotifications"
msgid "Browser notifications for this network"
msgstr "Notifications du navigateur pour ce réseau"

#. Tooltip of the question-mark icon next to the browser notifications checkbox on the network edit form.
#: client/components/NetworkForm.vue:263
msgctxt "form.browserNotificationsHelp"
msgid "Show browser notifications for highlights and queries on this network. Needs the browser's permission; asks when first saved. Each network is set up independently."
msgstr "Afficher les notifications du navigateur pour les highlights et les requêtes sur ce réseau. Il faut la permission du navigateur ; elle est demandée la première fois qu'elle est sauvegardée. Chaque réseau est configuré indépendamment."

#. Label of the field listing channels to join automatically after connecting, on the network edit form.
#: client/components/NetworkForm.vue:119
msgctxt "form.channels"
msgid "Channels"
msgstr "Canaux"

#. Placeholder of the channels field on the network edit form: example channel names, where a name may be followed by its door key.
#: client/components/NetworkForm.vue:125
msgctxt "form.channelsPlaceholder"
msgid "#channel, #another key (joined on connect)"
msgstr "#channel, #another clé (rejoint lors de la connexion)"

#. Label of the field holding IRC commands sent automatically when this network connects, on the network edit form.
#: client/components/NetworkForm.vue:133
msgctxt "form.commands"
msgid "Commands"
msgstr "Commandes"

#. Tooltip of the question-mark icon next to the Commands field on the network edit form (three lines).
#: client/components/NetworkForm.vue:136
msgctxt "form.commandsHelp"
msgid "One /command per line.\nEach command will be executed in\nthe server tab on new connection"
msgstr ""

#. Status line on the network edit form while the network is online without TLS.
#: client/components/NetworkForm.vue:490
msgctxt "form.connectedInsecure"
msgid "Connected (not secure)"
msgstr "Connecté (non sécurisé)"

#. Status line on the network edit form while the network is online over TLS.
#: client/components/NetworkForm.vue:490
msgctxt "form.connectedTls"
msgid "Connected (TLS)"
msgstr "Connecté (TLS)"

#. Status line on the network edit form while the network is being dialled.
#: client/components/NetworkForm.vue:493
msgctxt "form.connecting"
msgid "Connecting…"
msgstr "En cours de connexion…"

#. Status line on the network edit form when the network is not connected.
#: client/components/NetworkForm.vue:493
msgctxt "form.disconnected"
msgid "Disconnected"
msgstr "Déconnecté"

#. Heading of the network edit form; {name} is the network's current display name.
#: client/components/NetworkForm.vue:14
msgctxt "form.editTitle"
msgid "Edit {name}"
msgstr "Éditer {name}"

#. Label of the display-name field of a saved network on the network edit form.
#: client/components/NetworkForm.vue:42
msgctxt "form.name"
msgid "Name"
msgstr "Nom"

#. Placeholder of the network display-name field on the network edit form: the field may stay empty.
#: client/components/NetworkForm.vue:49
msgctxt "form.namePlaceholder"
msgid "Optional, defaults to the server's network name"
msgstr "Facultatif, par défaut au nom du réseau du serveur"

#. Heading of the server half of the network edit form (name, server, TLS, autoconnect).
#: client/components/NetworkForm.vue:40
msgctxt "form.networkSettings"
msgid "Network settings"
msgstr "Paramètres réseau"

#. Label of the nickname field on the network edit form.
#: client/components/NetworkForm.vue:104
msgctxt "form.nick"
msgid "Nick"
msgstr "Surnom"

#. Radio option on the network edit form: connect without a services account.
#: client/components/NetworkForm.vue:158
msgctxt "form.noAuth"
msgid "No authentication"
msgstr "Aucune authentification"

#. Label of the services account password field on the network edit form, shown when SASL is on.
#: client/components/NetworkForm.vue:183
msgctxt "form.password"
msgid "Password"
msgstr "Mot de passe"

#. Placeholder of the SASL password field on the network edit form: saving without typing keeps the stored password.
#: client/components/NetworkForm.vue:196
msgctxt "form.passwordPlaceholder"
msgid "Leave empty to keep the current password"
msgstr "Laissez vide pour conserver le mot de passe actuel"

#. Tooltip of the question-mark icon next to the push notifications checkbox on the network edit form.
#: client/components/NetworkForm.vue:225
msgctxt "form.pushHelp"
msgid "Register this device for push notifications on this network. The server must support the draft/webpush capability. Push needs authentication, so this only appears with SASL configured. Each network is set up independently."
msgstr "Inscrire ce dispositif pour les notifications par push sur ce réseau. Le serveur doit prendre en charge la fonctionnalité draft/webpush. Les notifications par push nécessitent une authentification, donc elles ne s'affichent que si SASL est configuré. Chaque réseau est configuré de manière indépendante."

#. Checkbox on the network edit form: register this device for this network's push notifications.
#: client/components/NetworkForm.vue:222
msgctxt "form.pushNotifications"
msgid "Push notifications for this network"
msgstr "Notifications par push pour ce réseau"

#. Button on the network edit form next to the stale-push warning: re-subscribes this device for the network.
#: client/components/NetworkForm.vue:244
msgctxt "form.pushRenew"
msgid "Renew push notifications"
msgstr "Renouveler les notifications par push"

#. Warning on the network edit form when the server announced a new push key and this device's subscription must be renewed.
#: client/components/NetworkForm.vue:240
msgctxt "form.pushStaleHint"
msgid "This server's push identity (its key) changed, so this device's push subscription for it no longer works."
msgstr "L'identité par push de ce serveur (sa clé) a changé, donc cette souscription par push du dispositif pour lui n'est plus valide."

#. Checkbox on the network edit form: keep this network's SASL password in the browser's storage.
#: client/components/NetworkForm.vue:209
msgctxt "form.rememberPassword"
msgid "Remember password on this device"
msgstr "Se souvenir du mot de passe sur ce dispositif"

#. Radio option on the network edit form: authenticate with an account name and password (SASL PLAIN).
#: client/components/NetworkForm.vue:162
msgctxt "form.saslPlain"
msgid "Username + password (SASL PLAIN)"
msgstr "Utilisateur + mot de passe (SASL PLAIN)"

#. Submit button of the network edit form.
#: client/components/NetworkForm.vue:273
msgctxt "form.save"
msgid "Save network"
msgstr "Enregistrer le réseau"

#. Label of the server host field on the network edit form.
#: client/components/NetworkForm.vue:53
msgctxt "form.server"
msgid "Server"
msgstr "Serveur"

#. aria-label of the server host text input (e.g. irc.example.org) on the network edit form; the visible label is on the row.
#: client/components/NetworkForm.vue:60
msgctxt "form.serverAddress"
msgid "Server address"
msgstr "Adresse du serveur"

#. aria-label of the numeric port input next to the server host field on the network edit form.
#: client/components/NetworkForm.vue:76
msgctxt "form.serverPort"
msgid "Server port"
msgstr "Port du serveur"

#. Label of the connection-status row at the top of the network edit form (shown only while the app knows the network's live state).
#: client/components/NetworkForm.vue:26
msgctxt "form.status"
msgid "Status"
msgstr "Statut"

#. Checkbox on the network edit form: connect to this network over TLS instead of a plain connection.
#: client/components/NetworkForm.vue:86
msgctxt "form.useTls"
msgid "Use secure connection (TLS)"
msgstr "Utiliser une connexion sécurisée (TLS)"

#. Heading of the user half of the network edit form (nick, channels, commands, authentication).
#: client/components/NetworkForm.vue:102
msgctxt "form.userPreferences"
msgid "User preferences"
msgstr "Prférences de l'utilisateur"

#. About line at the top of the Help window, before the app name.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.about"
msgid "About"
msgstr "À propos"

#. Word between the two version numbers inside the compare links of the help window's past-release list. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.and"
msgid "and"
msgstr "et"

#. Description of the # autocompletion trigger in the help window: typing # suggests channel names.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.channel"
msgid "Channel"
msgstr "Canal"

#. Description of the / autocompletion trigger in the help window: typing / suggests slash commands; the parenthesized phrase points at the command list further down this page.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.commands"
msgid "Commands (see list of commands below)"
msgstr "Commandes (voir la liste des commandes ci-dessous)"

#. Line after the autocompletion intro in the help window; points at the app's settings.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.disabled"
msgid "Autocompletion can be disabled in settings."
msgstr "L'autocomplétion peut être désactivée dans les paramètres."

#. Description of the : autocompletion trigger in the help window; a code fragment with a smiley example follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.emoji"
msgid "Emoji (note: requires two search characters, to avoid conflicting with common emoticons like"
msgstr "Émoticônes (note : nécessite deux caractères de recherche, pour éviter de confondre avec les émoticônes courantes comme"

#. Heading of the autocompletion section of the help window; explains the prefix characters that open suggestion lists.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.heading"
msgid "Autocompletion"
msgstr "Autocomplétion"

#. First part of the autocompletion intro in the help window; keycap symbols (arrow up) follow it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.introA"
msgid "To auto-complete nicknames, channels, commands, and emoji, type one of the characters below to open a suggestion list. Use the"
msgstr "Pour auto-compléter les noms d'utilisateur, canaux, commandes et émoticônes, tapez l'un des caractères suivants pour ouvrir une liste de suggestions. Utilisez la"

#. Word between the two arrow keycaps inside the autocompletion intro in the help window. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.introB"
msgid "and"
msgstr "et"

#. Continuation of the autocompletion intro in the help window, after the two arrow keycaps; the Tab and Enter keycaps follow it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.introC"
msgid "keys to highlight an item, and insert it by pressing"
msgstr "pour mettre en évidence un élément, et insérez-le en appuyant sur"

#. Word between the Tab and Enter keycaps inside the autocompletion intro in the help window. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.introD"
msgid "or"
msgstr "ou"

#. End of the autocompletion intro in the help window, after the Tab and Enter keycaps; the parenthesized phrase offers clicking as the third way.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.introE"
msgid "(or by clicking the desired item)."
msgstr "(ou en cliquant sur l'élément souhaité)."

#. Description of the @ autocompletion trigger in the help window: typing @ suggests user names.
#: client/components/Windows/Help.vue
msgctxt "help.autocomplete.nick"
msgid "Nickname"
msgstr "Nom d'utilisateur"

#. Purpose clause ending the second compare item of the help window's past-release list (comparing the running build with the development branch). Starts lowercase because it follows the link.
#: client/components/Windows/Help.vue
msgctxt "help.behindDevelop"
msgid "to see what you are missing"
msgstr "voir ce que vous manquez"

#. Word that starts the link in the help window's compare items; the two version numbers being compared follow it inside the same link. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.between"
msgid "between"
msgstr "entre"

#. End of the help window's past-release sentence, after the link naming the source commit. {version} is the release number the build follows, kept with its v. Keep the comma.
#: client/components/Windows/Help.vue
msgctxt "help.builtAfter"
msgid ", after v{version}"
msgstr ", après v{version}"

#. Part of the sentence in the help window shown when the running build is newer than its release; the app's name precedes it and a link naming the source commit follows. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.builtFrom"
msgid "is built from"
msgstr "est construit à partir de"

#. Lead-in of the alias line under a command description in the help window; the alternative command follows it as a code fragment. Keep the trailing colon.
#: client/components/Windows/Help.vue
msgctxt "help.commands.alias"
msgid "Alias:"
msgstr ""

#. Lead-in of the alias line under a command description in the help window when the command has several alternative names; the alternatives follow as code fragments. Keep the trailing colon.
#: client/components/Windows/Help.vue
msgctxt "help.commands.aliases"
msgid "Aliases:"
msgstr "Alias :"

#. Description of the /away command in the help window; the command syntax (/away [message]) is shown beside it and stays untranslated.
#: client/components/Windows/Help.vue
msgctxt "help.commands.away"
msgid "Mark yourself as away with an optional message."
msgstr "Marquez-vous comme absent avec un message optionnel."

#. Start of the /back command description in the help window; a code fragment with the /away command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.back"
msgid "Remove your away status (set with"
msgstr "Supprimez votre statut d'absence (défini avec"

#. Start of the /ban command description in the help window; a code fragment with the +b mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.banA"
msgid "Ban ("
msgstr "Interdire ("

#. Continuation of the /ban command description in the help window, after the +b code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.banB"
msgid ") a user from the current channel. This can be a nickname or a hostmask."
msgstr ") un utilisateur du canal actuel. Cela peut être un pseudonyme ou un masque d'hôte."

#. Description of the /banlist command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.banlist"
msgid "Load the banlist for the current channel."
msgstr "Charger la liste d'interdits du canal actuel."

#. Description of the /cleartopic command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.cleartopic"
msgid "Clear the topic in the current channel."
msgstr "Effacer le sujet du canal actuel."

#. Description of the /collapse command in the help window; a code fragment with the /expand command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.collapse"
msgid "Collapse all previews in the current channel (opposite of"
msgstr "Coller tous les aperçus du canal actuel (opposé de"

#. Start of the /connect command description in the help window; a code fragment with the port parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.connectA"
msgid "Connect to a new IRC network. If"
msgstr "Se connecter à un nouveau réseau IRC. Si"

#. Middle of the /connect command description in the help window, after the port parameter; a code fragment with the plus sign follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.connectB"
msgid "starts with a"
msgstr "commence par un"

#. End of the /connect command description in the help window, after the plus-sign code fragment; TLS stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.connectC"
msgid "sign, the connection will be made secure using TLS."
msgstr "signe, la connexion sera faite en utilisant TLS."

#. Start of the /ctcp command description in the help window; the CTCP abbreviation follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpA"
msgid "Send a"
msgstr "Envoyer un"

#. Continuation of the /ctcp command description in the help window, after the CTCP abbreviation; the link text follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpB"
msgid "request. Read more about this on"
msgstr "demande. En savoir plus sur"

#. Text of the link at the end of the /ctcp command description in the help window; it opens the external Wikipedia article. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpLink"
msgid "the dedicated Wikipedia article"
msgstr "l'article Wikipedia dédié"

#. Expansion of the acronym CTCP, shown as the abbreviation's hover tooltip in the help window's /ctcp command description.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ctcpTitle"
msgid "Client-to-client protocol"
msgstr "Protocole client-à-client"

#. Start of the /deop command description in the help window; a code fragment with the -o mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.deopA"
msgid "Remove op ("
msgstr "Supprime op ("

#. Continuation of the /deop command description in the help window, after the -o code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.deopB"
msgid ") from one or several users in the current channel."
msgstr ") d'un ou plusieurs utilisateurs dans le canal actuel."

#. Start of the /devoice command description in the help window; a code fragment with the -v mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.devoiceA"
msgid "Remove voice ("
msgstr "Supprime voice ("

#. Continuation of the /devoice command description in the help window, after the -v code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.devoiceB"
msgid ") from one or several users in the current channel."
msgstr ") d'un ou plusieurs utilisateurs dans le canal actuel."

#. Description of the /disconnect command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.disconnectLong"
msgid "Disconnect from the current network with an optionally-provided message."
msgstr "Désconnecte du réseau actuel avec un message optionnel."

#. Description of the /expand command in the help window; a code fragment with the /collapse command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.expand"
msgid "Expand all previews in the current channel (opposite of"
msgstr "Affiche toutes les prévues dans le canal actuel (opposé de"

#. Heading of the commands section of the help window; one row per slash command with its syntax and description.
#: client/components/Windows/Help.vue
msgctxt "help.commands.heading"
msgid "Commands"
msgstr "Commandes"

#. Description of the /ignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ignore"
msgid "Block any messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "Bloque tout message de l'utilisateur spécifié sur le réseau actuel. Cela peut être un pseudonyme ou une masque d'hôte."

#. Description of the /ignorelist command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.ignorelist"
msgid "Load the list of ignored users for the current network."
msgstr "Charge la liste d'utilisateurs ignorés pour le réseau actuel."

#. Start of the /invite command description in the help window; a code fragment with the channel parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.inviteA"
msgid "Invite a user to the specified channel. If"
msgstr "Invite un utilisateur au canal spécifié. Si"

#. Continuation of the /invite command description in the help window, after the channel-parameter code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.inviteB"
msgid "is omitted, user will be invited to the current channel."
msgstr "est omis, l'utilisateur sera invité au canal actuel."

#. Description of the /join command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.join"
msgid "Join a channel. Password is only needed in protected channels and can usually be omitted."
msgstr "Rejoins un canal. Le mot de passe est requis uniquement pour les canaux protégés et peut généralement être omis."

#. Description of the /kick command in the help window; it removes the user from the channel (they may rejoin).
#: client/components/Windows/Help.vue
msgctxt "help.commands.kick"
msgid "Kick a user from the current channel."
msgstr "Expulse un utilisateur du canal actuel."

#. Start of the /kickban command description in the help window; a code fragment with the +b mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickbanA"
msgid "Kick and ban ("
msgstr "Expulse et bannit ("

#. Middle of the /kickban command description in the help window, after the +b code fragment; a code fragment with the /ban command follows it. Starts with the closing parenthesis. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickbanB"
msgid ") a user from the current channel. Unlike"
msgstr ") un utilisateur du canal actuel. Contrairement à"

#. End of the /kickban command description in the help window, after the /ban code fragment. Starts with a comma.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickbanC"
msgid ", only nicknames (and not host masks) can be used."
msgstr ", uniquement les pseudonymes (et non les masques d'hôte) peuvent être utilisés."

#. Description of the /list command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.list"
msgid "Retrieve a list of available channels on this network."
msgstr "Récupère la liste des canaux disponibles sur ce réseau."

#. Description of the /me command in the help window. {appName} is the chat app's display name.
#: client/components/Windows/Help.vue
msgctxt "help.commands.me"
msgid "Send an action message to the current channel. {appName} will display it inline, as if the message was posted in the third person."
msgstr "Envoye un message d'action au canal actuel. {appName} le montrera en ligne, comme si le message avait été posté en troisième personne."

#. Description of the /mode command in the help window; explains whose modes the flags apply to depending on the active window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mode"
msgid "Set the given flags to the current channel if the active window is a channel, another user if the active window is a private message window, or yourself if the current window is a server window."
msgstr "Met les drapeons donnés au canal actuel si la fenêtre active est un canal, à un autre utilisateur si la fenêtre active est un message privé, ou vous-même si la fenêtre actuelle est une fenêtre serveur."

#. Description of the /msg command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.msg"
msgid "Send a message to the specified channel."
msgstr "Envoye un message au canal spécifié."

#. Description of the /mute command in the help window; a code fragment with the /unmute command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mute"
msgid "Prevent messages from generating any feedback for a channel. This turns off the highlight indicator, hides mentions and inhibits push notifications. Muting a network lobby mutes the entire network. Not specifying any channel target mutes the current channel. Revert with"
msgstr "Empêche les messages de générer tout type de réaction pour un canal. Cela désactive l'indicateur de mise en avant, masque les mentions et inhibite les notifications par push. Le silence d'un réseau de jeu silencie l'ensemble du réseau. Si aucun canal cible n'est spécifié, le canal actuel est silencie. Annuler avec"

#. Description of the /nick command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.nick"
msgid "Change your nickname on the current network."
msgstr "Changer votre pseudo sur le réseau actuel."

#. Description of the /notice command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.notice"
msgid "Sends a notice message to the specified channel."
msgstr "Envoyer un message d'information au canal spécifié."

#. Start of the /op command description in the help window; a code fragment with the +o mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.opA"
msgid "Give op ("
msgstr "Donner l'autorité ("

#. Continuation of the /op command description in the help window, after the +o code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.opB"
msgid ") to one or several users in the current channel."
msgstr ") à un ou plusieurs utilisateurs dans le canal actuel."

#. Start of the /part command description in the help window; a code fragment with the channel parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.part"
msgid "Close the specified channel or private message window, or the current channel if"
msgstr "Fermer la fenêtre du canal ou du message privé spécifié, ou le canal actuel si"

#. End of the /part command description in the help window, after the channel-parameter code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.partB"
msgid "is omitted."
msgstr "est omis."

#. Description of the /query command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.query"
msgid "Send a private message to the specified user."
msgstr "Envoyer un message privé à l'utilisateur spécifié."

#. Description of the /quit command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.quit"
msgid "Disconnect from the current network with an optional message."
msgstr "Découpler du réseau actuel avec un message optionnel."

#. Description of the /raw command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.raw"
msgid "Send a raw message to the current IRC network."
msgstr "Envoyer un message brut au réseau IRC actuel."

#. Description of the /rejoin command in the help window; ChanServ (the IRC channel service) stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.rejoin"
msgid "Leave and immediately rejoin the current channel. Useful to quickly get op from ChanServ in an empty channel, for example."
msgstr "Quitter et rejoindre immédiatement le canal actuel. Utile pour rapidement obtenir l'autorité de ChanServ dans un canal vide, par exemple."

#. Description of the /search command in the help window. No trailing period in the source; keep it as is.
#: client/components/Windows/Help.vue
msgctxt "help.commands.search"
msgid "Search for messages in the current channel / user"
msgstr "Chercher des messages dans le canal actuel / utilisateur"

#. Description of the /slap command in the help window; a playful IRC tradition. Keep the exclamation mark.
#: client/components/Windows/Help.vue
msgctxt "help.commands.slap"
msgid "Slap someone in the current channel with a trout!"
msgstr "Donner un coup de poing à quelqu'un dans le canal actuel avec un truite !"

#. Start of the /topic command description in the help window; a code fragment with the newtopic parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.topicA"
msgid "Get the topic in the current channel. If"
msgstr "Obtenir le sujet du canal actuel. Si"

#. End of the /topic command description in the help window, after the newtopic-parameter code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.topicB"
msgid "is specified, sets the topic in the current channel."
msgstr "est spécifié, définir le sujet du canal actuel."

#. Start of the /unban command description in the help window; a code fragment with the -b mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unbanA"
msgid "Unban ("
msgstr "Désinterdire ("

#. Continuation of the /unban command description in the help window, after the -b code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unbanB"
msgid ") a user from the current channel. This can be a nickname or a hostmask."
msgstr ") un utilisateur du canal actuel. Cela peut être un pseudo ou un masque d'hôte."

#. Description of the /unignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unignore"
msgid "Unblock messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "Désactiver les messages d'un utilisateur spécifié sur le réseau actuel. Cela peut être un pseudo ou un masque d'hôte."

#. Start of the /unmute command description in the help window; a code fragment with the /mute command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unmuteA"
msgid "Un-mutes the given channel(s) or the current channel if no channel is provided. See"
msgstr "Désactiver le silence du canal(s) donné ou du canal actuel si aucun canal n'est fourni. Voir"

#. End of the /unmute command description in the help window, after the /mute code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unmuteB"
msgid "for more information."
msgstr "pour plus d'informations."

#. Start of the /ver command description in the help window; the CTCP abbreviation follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.verA"
msgid "Ask a user which client they run: a"
msgstr "Demander à un utilisateur quel client ils utilisent : a"

#. Middle of the /ver command description in the help window: follows the CTCP abbreviation, and the literal command '/ctcp nick version' follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.verB"
msgid "VERSION request, the same as"
msgstr "demande de VERSION, la même que"

#. Last sentence of the /ver command description in the help window; a whole sentence on its own.
#: client/components/Windows/Help.vue
msgctxt "help.commands.verC"
msgid "The answer shows where you asked."
msgstr "La réponse montre où vous avez demandé."

#. Start of the /voice command description in the help window; a code fragment with the +v mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.voiceA"
msgid "Give voice ("
msgstr "Donner voix ("

#. Continuation of the /voice command description in the help window, after the +v code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.voiceB"
msgid ") to one or several users in the current channel."
msgstr ") à un ou plusieurs utilisateurs dans le canal actuel."

#. Description of the /whois command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.whois"
msgid "Retrieve information about the given user on the current network."
msgstr "Récupérer des informations sur l'utilisateur donné sur le réseau actuel."

#. Word inside the link of the help window's past-release sentence; the linked text names the source code commit the running build was made from, and the commit hash follows it. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commitLink"
msgid "commit"
msgstr ""

#. First word of the two list items under the help window's past-release sentence; each continues with a link comparing two versions. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.compare"
msgid "Compare"
msgstr "Comparer"

#. Label of the documentation link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.documentation"
msgid "Documentation"
msgstr ""

#. Shared first part of the descriptions of the Ctrl+B, Ctrl+U, Ctrl+I, Ctrl+S and Ctrl+M formatting shortcuts in the help window; the formatted example word (bold, underlined, italics, struck through, monospaced) follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.as"
msgid "Mark all text typed after this shortcut as"
msgstr "Marquer tous les textes tapés après ce raccourci comme"

#. The example word shown in bold lettering in the help window's Ctrl+B formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.bold"
msgid "bold"
msgstr "gras"

#. Text of the link at the end of the Ctrl+K description in the help window's formatting section; it opens an external IRC color reference. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorHere"
msgid "here"
msgstr "ici"

#. First part of the Ctrl+K description in the help window's formatting section; a code fragment with the numeric range follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP1a"
msgid "Mark any text typed after this shortcut to be colored. After hitting this shortcut, enter an integer in the range"
msgstr "Marquer n'importe quel texte tapé après ce raccourci pour être coloré. Après avoir frappé ce raccourci, entrez un entier dans la plage"

#. Continuation of the Ctrl+K description in the help window's formatting section, after the code fragment with the numeric range.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP1b"
msgid "to select the desired color, or use the autocompletion menu to choose a color name (see below)."
msgstr "pour sélectionner la couleur souhaitée, ou utilisez le menu d'autocomplétion pour choisir un nom de couleur (voir ci-dessous)."

#. Start of the second paragraph of the Ctrl+K description in the help window's formatting section; a code fragment with the numeric range follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP2a"
msgid "Background color can be specified by putting a comma and another integer in the range"
msgstr "La couleur d'arrière-plan peut être spécifiée en ajoutant une virgule et un autre entier dans la plage"

#. Continuation of the second paragraph of the Ctrl+K description in the help window's formatting section, after the code fragment with the numeric range.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP2b"
msgid "after the foreground color number (autocompletion works too)."
msgstr "après le numéro de couleur principale (le menu d'autocomplétion fonctionne également)."

#. Start of the last paragraph of the Ctrl+K description in the help window's formatting section; the link text follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorRef"
msgid "A color reference can be found"
msgstr "Une référence de couleur peut être trouvée"

#. Heading of the formatting-shortcuts section of the help window; each row shows a key combination and the message formatting it inserts.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.heading"
msgid "Formatting Shortcuts"
msgstr "Raccourcis de formatage"

#. The example word shown in italics in the help window's Ctrl+I formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.italic"
msgid "italics"
msgstr "italiques"

#. The example word shown in a monospaced font in the help window's Ctrl+M formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.monospace"
msgid "monospaced"
msgstr ""

#. Description of the Ctrl+O formatting shortcut in the help window; it removes any formatting applied so far in the message.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.reset"
msgid "Mark all text typed after this shortcut to be reset to its original formatting."
msgstr "Marquer tous les textes tapés après ce raccourci pour être réinitialisés à leur format original."

#. The example word shown with a line through it in the help window's Ctrl+S formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.strikethrough"
msgid "struck through"
msgstr "traversé"

#. The example word shown underlined in the help window's Ctrl+U formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.underline"
msgid "underlined"
msgstr "sousliné"

#. Heading of the touch-gestures section of the help window; lists what swiping on the sidebar does.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.heading"
msgid "Gestures"
msgstr "Gestes"

#. Description of the single-finger swipe-left gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.hideSidebar"
msgid "Hide sidebar."
msgstr "Cacher le menu latéral."

#. Description of the single-finger swipe-right gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.showSidebar"
msgid "Show sidebar."
msgstr "Afficher le menu latéral."

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar left with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeLeft"
msgid "Single-Finger Swipe Left"
msgstr "Glisser une main gauche"

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar right with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeRight"
msgid "Single-Finger Swipe Right"
msgstr "Glisser une main droite"

#. Name of the touch gesture in the help window's gestures section: swiping left with two fingers anywhere in the chat. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.twoSwipeLeft"
msgid "Two-Finger Swipe Left"
msgstr "Glisser deux doigts gauche"

#. Name of the touch gesture in the help window's gestures section: swiping right with two fingers anywhere in the chat. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.twoSwipeRight"
msgid "Two-Finger Swipe Right"
msgstr "Glisser deux doigts droite"

#. Label of the privacy policy link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.privacy"
msgid "Privacy policy"
msgstr "Politique de confidentialité"

#. Link beside the version number in the help window's title line; opens the changelog window. Mid-sentence between parentheses.
#: client/components/Windows/Help.vue
msgctxt "help.releaseNotesLink"
msgid "release notes"
msgstr "Notes de sortie"

#. Button of the update banner in the help window; clicking reloads the app to pick up the new build.
#: client/components/Windows/Help.vue
msgctxt "help.reload"
msgid "Reload"
msgstr "Recharger"

#. Link in the help window's about section; opens the bug-report page of the app's source repository. Ellipsis is part of the copy.
#: client/components/Windows/Help.vue
msgctxt "help.reportIssue"
msgid "Report an issue…"
msgstr "Signaler un problème…"

#. Description of the Alt+Shift+Left keyboard shortcut in the help window; it folds the current network's channel list in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.collapseNetwork"
msgid "Collapse current network."
msgstr "Coller le réseau actuel."

#. Description of the Escape key in the help window; it dismisses whatever popup or editor is open, or leaves the input field.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.escape"
msgid "Close current contextual window (context menu, image viewer, topic edit, etc) and remove focus from input."
msgstr "Fermer la fenêtre contextuelle actuelle (menu contextuel, visionneur d'images, éditeur de sujet, etc.) et retirer le focus de l'entrée."

#. Description of the Alt+Shift+Right keyboard shortcut in the help window; it unfolds the current network's channel list in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.expandNetwork"
msgid "Expand current network."
msgstr "Déplier le réseau actuel."

#. Description of the Alt+A keyboard shortcut in the help window; it jumps to the earliest conversation with unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.firstUnread"
msgid "Switch to the first window with unread messages."
msgstr "Passer à la première fenêtre avec des messages non lus."

#. Heading of the keyboard shortcuts section of the help window; each row shows the key combination and what it does.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.heading"
msgid "Keyboard Shortcuts"
msgstr "Raccourcis clavier"

#. Description of the Alt+/ keyboard shortcut in the help window; it opens this help page.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.helpMenu"
msgid "Switch to the help menu."
msgstr "Passer au menu d'aide."

#. Description of the Alt+Shift+Down keyboard shortcut in the help window; it moves to the next network's home view in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextLobby"
msgid "Switch to the next lobby in the channel list."
msgstr "Passer à la prochaine salle dans la liste des canaux."

#. Description of the Alt+Ctrl+Down keyboard shortcut in the help window; it jumps to the next conversation that has unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextUnread"
msgid "Switch to the next window with unread messages in the channel list."
msgstr "Passer à la prochaine fenêtre avec des messages non lus dans la liste des canaux."

#. Description of the Alt+Down keyboard shortcut and of the two-finger swipe-left gesture in the help window; both move to the conversation after the current one in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextWindow"
msgid "Switch to the next window in the channel list."
msgstr "Passer à la prochaine fenêtre dans la liste des canaux."

#. Description of the Alt+Shift+Up keyboard shortcut in the help window; it moves to the previous network's home view in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevLobby"
msgid "Switch to the previous lobby in the channel list."
msgstr "Passer au lobby précédent dans la liste des canaux."

#. Description of the Alt+Ctrl+Up keyboard shortcut in the help window; it jumps to the previous conversation that has unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevUnread"
msgid "Switch to the previous window with unread messages in the channel list."
msgstr "Passer à la fenêtre précédente avec des messages non lus dans la liste des canaux."

#. Description of the Alt+Up keyboard shortcut and of the two-finger swipe-right gesture in the help window; both move to the conversation before the current one in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevWindow"
msgid "Switch to the previous window in the channel list."
msgstr "Passer à la fenêtre précédente dans la liste des canaux."

#. Description of the Alt+J keyboard shortcut in the help window; it opens or closes the search field for jumping to a conversation.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleJump"
msgid "Toggle jump to channel switcher."
msgstr "Activer/désactiver le switch pour passer directement au répertoire des canaux."

#. Description of the Alt+K keyboard shortcut in the help window; it switches message formatting (bold, code, spoilers) on or off.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleMarkdown"
msgid "Toggle Markdown rendering."
msgstr "Activer/désactiver le rendu en Markdown."

#. Description of the Alt+M keyboard shortcut in the help window; it opens or closes the popup listing messages that mention you.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleMentions"
msgid "Toggle recent mentions popup."
msgstr "Activer/désactiver la popup des mentions récentes."

#. Description of the Alt+S keyboard shortcut in the help window; it shows or hides the sidebar network list.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleSidebar"
msgid "Toggle sidebar."
msgstr "Activer/désactiver le panneau latéral."

#. Description of the Alt+U keyboard shortcut in the help window; it shows or hides the panel listing the channel's members.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleUserlist"
msgid "Toggle channel user list."
msgstr "Activer/désactiver la liste des utilisateurs par canal."

#. Purpose clause ending the first compare item of the help window's past-release list (comparing the release with the running build). Starts lowercase because it follows the link.
#: client/components/Windows/Help.vue
msgctxt "help.sinceRelease"
msgid "to see what changed since the release"
msgstr "Pour voir ce qui a changé depuis la sortie."

#. Title of the help window: its heading, its dialog aria-label, and the accessible name of the whole page.
#: client/components/Windows/Help.vue
msgctxt "help.title"
msgid "Help"
msgstr "Aide"

#. Text of the banner at the top of the help window shown when a newer build of the app was published; a Reload button follows it.
#: client/components/Windows/Help.vue
msgctxt "help.updateAvailable"
msgid "New version available"
msgstr "Une nouvelle version est disponible"

#. Label of the network's website link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.website"
msgid "Website"
msgstr "Site web"

#. aria-label of the ✕ control of the image viewer that fills the screen; clicking closes it.
#: client/components/ImageViewer.vue
msgctxt "image.close"
msgid "Close"
msgstr "Fermer"

#. aria-label of the forward arrow of the image viewer; clicking shows the next image from the conversation.
#: client/components/ImageViewer.vue
msgctxt "image.next"
msgid "Next image"
msgstr "Image suivante"

#. aria-label of the back arrow of the image viewer; clicking shows the previous image from the conversation.
#: client/components/ImageViewer.vue
msgctxt "image.previous"
msgid "Previous image"
msgstr "Image précédente"

#. Password input eye toggle, shown when the password is currently visible; clicking hides it.
#: client/components/RevealPassword.vue
msgctxt "input.hidePassword"
msgid "Hide password"
msgstr "Cacher le mot de passe"

#. Password input eye toggle, shown while the password is masked.
#: client/components/RevealPassword.vue
msgctxt "input.showPassword"
msgid "Show password"
msgstr "Afficher le mot de passe"

