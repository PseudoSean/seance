#: client/js/hooks/use-close-channel.ts:13
msgctxt "lobby.removeText"
msgid "Are you sure you want to quit and remove {name}? This cannot be undone."
msgstr "هل تتأكد أنك تريد التخلي عن {name} وحذفه؟ لا يمكن التراجع عن هذا."

#. Title of the confirmation dialog shown from the sidebar when removing a whole chat network: the connection quits and the saved network is deleted from this browser.
#: client/js/hooks/use-close-channel.ts:11
