#: client/js/helpers/mediaTrustMenu.ts
#: client/components/LinkPreview.vue
msgctxt "link.trustFromHost"
msgid "from {name}"
msgstr "mula {name}"

#. Name of a media-trust scope in the trust menu of a media preview and in the toolbar tooltip summarizing active rules: always allowing media posted in the chat channel. {name} is that channel's name. Starts lowercase; it follows the words 'Always show' or 'Stop always showing'.
#: client/js/helpers/mediaTrustMenu.ts
#: client/components/LinkPreview.vue
msgctxt "link.trustInChannel"
msgid "in {name}"
msgstr "sa {name}"

