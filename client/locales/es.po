#. Title (hover hint) of the channel name input in the sidebar's join-channel form, shown when the typed name is invalid.
#: client/components/JoinChannel.vue:20
msgctxt "join.channelHint"
msgid "The channel name may not contain spaces"
msgstr "El nombre del canal no puede contener espacios"

#. Placeholder of the channel name input in the join-channel form that opens under a network in the sidebar.
#: client/components/JoinChannel.vue:17
msgctxt "join.channelPlaceholder"
msgid "Channel"
msgstr "Canal"

#. Title (hover hint) of the channel key input in the sidebar's join-channel form, shown when the typed key is invalid.
#: client/components/JoinChannel.vue:31
msgctxt "join.passwordHint"
msgid "The channel password may not contain spaces"
msgstr "La contraseña del canal no puede contener espacios"

#. Placeholder of the channel key (password) input in the sidebar's join-channel form; private channels need one.
#: client/components/JoinChannel.vue:28
msgctxt "join.passwordPlaceholder"
msgid "Password (optional)"
msgstr "Contraseña (opcional)"

#. Submit button of the join-channel form under a network in the sidebar.
#: client/components/JoinChannel.vue:34
msgctxt "join.submit"
msgid "Join"
msgstr "Unirse"

#. Title on the placeholder of a media preview that failed to load. {kind} is the media kind as a lowercase English word: 'image', 'video' or 'audio'.
#: client/components/LinkPreview.vue
msgctxt "link.cannotLoad"
msgid "Couldn't load this {kind}"
msgstr "No se pudo cargar este {kind}"

#. Hint on the placeholder of a media preview with no file name to show; clicking reveals the media.
#: client/components/LinkPreview.vue
msgctxt "link.clickToShow"
msgid "Click to show"
msgstr "Hacer clic para mostrar"

#. Hint on the placeholder of a media preview that has not been revealed, when the file name is known: clicking reveals the media. {file} is the file's own name, shown verbatim — never translate it. The middle dot separates the two; move or replace it as the language wants.
#: client/components/LinkPreview.vue
msgctxt "link.clickToShowFile"
msgid "{file} · Click to show"
msgstr "{file} · Haz clic para mostrar"

