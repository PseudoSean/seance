msgstr "{kind} está vacío"

#. Name of the channel-ban (+b) list, inserted into '{kind} is empty' and '{kind} for {channel}'.
#: client/js/irc/handlers/lists.ts
msgctxt "list.kindBans"
msgid "Ban list"
msgstr "Lista de baneos"

#. Name of the ban-exception (+e) list, inserted into '{kind} is empty' and '{kind} for {channel}'.
#: client/js/irc/handlers/lists.ts
msgctxt "list.kindExcepts"
msgid "Exception list"
msgstr "Lista de excepciones"

#. Name of the channel-invite (+I) list, inserted into '{kind} is empty' and '{kind} for {channel}'.
#: client/js/irc/handlers/lists.ts
msgctxt "list.kindInvites"
msgid "Invite list"
msgstr "Lista de invitaciones"

