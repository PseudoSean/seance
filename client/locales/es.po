#. The word for a group chat room, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeChannel"
msgid "channel"
msgstr "canal"

#. Word for a whole chat server connection, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeNetwork"
msgid "network"
msgstr "red"

#. The word for a private one-on-one chat, filling {type} in the context-menu mute items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.chanTypeQuery"
msgid "conversation"
msgstr "conversación"

#. Context-menu item on a conversation; deletes the locally loaded messages of that conversation after a confirmation. Also the title and confirmation button of that dialog.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.clearHistory"
msgid "Clear history"
msgstr "Limpiar historial"

#. Body of the confirmation dialog before the locally loaded messages of a conversation are deleted. {channel} is the conversation's name.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.clearHistoryText"
msgid "Are you sure you want to clear history for {channel}? This cannot be undone."
msgstr "¿Estás seguro de que quieres borrar el historial para {channel}? No se puede deshacer."

#. Context-menu item on a channel in the sidebar network list; clicking leaves the channel (the app stops showing it and tells the server so).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeChannel"
msgid "Leave"
msgstr "Salir"

#. Context-menu item on a chat network's home row in the sidebar network list; clicking forgets the saved network connection. Shown instead of 'Close' because a network cannot be merely closed.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeLobby"
msgid "Remove"
msgstr "Eliminar"

#. Context-menu item on a private one-on-one conversation or a list window in the sidebar; clicking closes the window without leaving anything on the server.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.closeQuery"
msgid "Close"
msgstr "Cerrar"

#. Context-menu item on a chat network's home row while the network is offline; clicking dials the network again.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.connect"
msgid "Connect"
msgstr "Conectar"

#. Context-menu item on a user; opens (or switches to) the private one-on-one conversation with that user.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.directMessages"
msgid "Direct messages"
msgstr "Mensajes directos"

#. Context-menu item on a chat network's home row while the network is connected; clicking hangs up the connection to that network.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.disconnect"
msgid "Disconnect"
msgstr "Desconectar"

