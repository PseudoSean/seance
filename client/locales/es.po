msgid "Close settings"
msgstr "Cerrar ajustes"

#. Button in the footer of the settings window; clicking closes the settings and returns to the chat.
#: client/components/Windows/Settings.vue
msgctxt "windows.settings.done"
msgid "Done"
msgstr "Terminado"

#. Line in the footer of the settings window, beside the Done button; explains that settings apply instantly and nothing needs saving.
#: client/components/Windows/Settings.vue
msgctxt "windows.settings.note"
msgid "Changes are saved as you make them."
msgstr "Los cambios se guardan a medida que los haces."

#. Title of the settings window: the heading of the modal, its dialog aria-label, and the accessible name of the whole settings pane.
#: client/components/Windows/Settings.vue
