#: client/components/MessageActions.vue:195
#: client/components/MessageActions.vue
msgctxt "message.deleteTitle"
msgid "Delete message"
msgstr "Borrar mensaje"

#. Part of the delete-confirmation dialog's body: fills the {who} placeholder when the message to be deleted was written by someone else. {nick} is that user's name.
#: client/components/MessageActions.vue:190
msgctxt "message.deleteWhoOther"
msgid "{nick}'s message"
msgstr "{nick}'s mensaje"

#. Part of the delete-confirmation dialog's body: fills the {who} placeholder when the message to be deleted is the reader's own.
#: client/components/MessageActions.vue:189
msgctxt "message.deleteWhoSelf"
msgid "your message"
msgstr "Tu mensaje"

#. Visible text standing in for a deleted chat message when the deletion gave no reason. {nick} is the name of the user who deleted it. Square brackets are part of the copy.
#: client/components/Message.vue:333
msgctxt "message.deleted"
msgid "[Message deleted by {nick}]"
msgstr "[Mensaje eliminado por {nick}]"

#. Visible text standing in for a deleted chat message when the deletion gave a reason. {nick} is the name of the user who deleted it, {reason} the reason they gave. Square brackets are part of the copy.
#: client/components/Message.vue:331
msgctxt "message.deletedWithReason"
msgid "[Message deleted by {nick}: {reason}]"
msgstr "[Mensaje eliminado por {nick}: {reason}]"

#. Tooltip and aria-label of the pencil button in a chat message's hover toolbar, shown on your own messages; clicking starts editing that message.
#: client/components/MessageActions.vue:44
msgctxt "message.edit"
msgid "Edit"
msgstr "Editar"

#. Tooltip on the edited marker of a chat message when the time of the edit is unknown.
#: client/components/Message.vue:265
msgctxt "message.edited"
msgid "This message was edited"
msgstr "Este mensaje fue editado"

#. Tooltip on the edited marker of a chat message that was edited after being sent; {time} is the date and time the edit was made, already formatted in the reader's locale.
#: client/components/Message.vue:264
msgctxt "message.editedAt"
msgid "Edited {time}"
msgstr "Editado {time}"

#. Small marker shown after a chat message that was edited after being sent. Parenthesized; keep the lowercase form.
#: client/components/Message.vue:77
msgctxt "message.editedBadge"
msgid "(edited)"
msgstr "(editado)"

#. Tooltip and aria-label of the smiley button in a chat message's hover toolbar; clicking opens the emoji picker to add a reaction to that message.
#: client/components/MessageActions.vue:21
msgctxt "message.react"
msgid "React"
msgstr "Reaccionar"

#. Tooltip on the revealed text of a deleted chat message; clicking hides the text again.
#: client/components/Message.vue:72
msgctxt "message.redactedHide"
msgid "Click to hide again"
msgstr "Hacer clic para mostrar de nuevo"

#. aria-label of the placeholder button that replaces a deleted chat message; clicking shows the deleted text.
#: client/components/Message.vue:65
msgctxt "message.redactedReveal"
msgid "Deleted message, click to reveal"
msgstr "Mensaje eliminado, hacer clic para mostrarlo de nuevo"

#. Tooltip and aria-label of the reply button in a chat message's hover toolbar; clicking starts a reply quoting that message.
#: client/components/MessageActions.vue:11
msgctxt "message.reply"
msgid "Reply"
msgstr "Responder"

#. aria-label of the quoted-message button on a chat message when the message being replied to is not in the loaded scrollback, so it cannot be jumped to.
#: client/components/Message.vue:294
msgctxt "message.replyMissing"
msgid "Replying to a message that is not loaded"
msgstr "Respondiendo a un mensaje no cargado"

#. Visible text of the quoted-message button on a chat message when the message being replied to is not in the loaded scrollback; it stands in for the quoted text. Parenthesized.
#: client/components/Message.vue:53
msgctxt "message.replyUnknown"
msgid "(unknown message)"
msgstr "(mensaje desconocido)"

#. aria-label of the small quoted-message button on a chat message that is a reply; clicking scrolls to the message being replied to. {nick} is the name of the user who wrote the quoted message, {text} its content as plain text.
#: client/components/Message.vue:291
msgctxt "message.replyingTo"
msgid "Replying to {nick}: {text}. Jump to that message."
msgstr "Respondiendo a {nick}: {text}. Saltear a ese mensaje."

#. Tooltip of the small marker on a chat message that arrived while you had another channel open; the server delivered it to the active window only.
#: client/components/Message.vue:118
msgctxt "message.shownInActive"
msgid "This message was shown in your active channel"
msgstr "Este mensaje fue mostrado en su canal activo"

#. Tooltip of the small mode-prefix marker (a character such as + or @) shown before messages that the server delivered only to the part of the channel holding that status. {mode} is the mode character itself, inserted verbatim.
#: client/components/StatusmsgMarker.vue:4
msgctxt "message.statusmsg"
msgid "This message was only shown to users with {mode} mode"
msgstr "Este mensaje solo fue mostrado a usuarios con {mode} modo"

#. Tooltip of the 'CTCP' abbreviation inside the CTCP-request system message; the abbreviation itself is the protocol's name and stays verbatim.
#: client/components/MessageTypes/ctcp_request.vue
msgctxt "msg.ctcpTitle"
msgid "Client-to-client protocol"
msgstr "Protocolo cliente a cliente"

#. System message announcing a channel's modes (324). The mode string in <b> is protocol text and stays verbatim.
#: client/components/MessageTypes/mode_channel.vue
msgctxt "msg.modeChannelIs"
msgid "Channel mode is"
msgstr "El modo del canal es"

#. System message announcing the reader's own user modes (221). The mode string in <b> is protocol text and stays verbatim.
#: client/components/MessageTypes/mode_user.vue
msgctxt "msg.modeUserIs"
msgid "Your user mode is"
msgstr "Su modo de usuario es"

#. Lobby error when the server refused a nick as taken (433) and gave no reason of its own; shown as '<nick>: <reason>'. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.nickInUse"
msgid "Nickname is already in use."
msgstr "El apodo ya está en uso."

#. Lobby error when the server refused a nick as malformed (432) and gave no reason of its own; shown as '<nick>: <reason>'. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.nickInvalid"
msgid "Nickname is invalid."
msgstr "El apodo es inválido."

#. Lobby error when a whois/whowas named a nick the server does not know; {nick} is the nick as typed, user input.
#: client/js/irc/handlers/whois.ts
msgctxt "msg.noSuchNick"
msgid "No such nick: {nick}"
msgstr ""

#. System message when a user changes a channel's topic. Renders after the user's name (direction-isolated in <bdi>); the new topic is channel content and stays verbatim.
#: client/components/MessageTypes/topic.vue
msgctxt "msg.topicChanged"
msgid "has changed the topic to:"
msgstr "ha cambiado el tema a:"

#. Reply to a topic request for a channel the client is not in: the channel name and the topic itself are verbatim channel data.
#: client/js/irc/handlers/topic.ts
msgctxt "msg.topicFor"
msgid "Topic for {channel}: {topic}"
msgstr "Tema para {channel}: {topic}"

#. System message announcing a channel's topic (no changer known, e.g. on join). The topic itself is channel content and stays verbatim.
#: client/components/MessageTypes/topic.vue
msgctxt "msg.topicIs"
msgid "The topic is:"
msgstr "El tema es:"

#. System message naming who set the topic (333). Renders before the setter's name (direction-isolated in <bdi>); the time follows through the next fragment.
#: client/components/MessageTypes/topic_set_by.vue
msgctxt "msg.topicSetBy"
msgid "Topic set by"
msgstr "Tema establecido por"

#. Topic-set-by system message, after the setter's name. {time} is the pre-formatted timestamp of when the topic was set; keep it in the position the language's preposition wants.
#: client/components/MessageTypes/topic_set_by.vue
msgctxt "msg.topicSetOn"
msgid "on {time}"
msgstr "en {time}"

#. Channel message answering a topic request when the channel has none (331).
#: client/js/irc/handlers/topic.ts
msgctxt "msg.topicUnset"
msgid "No topic is set."
msgstr "No hay tema establecido."

#. Reply to a topic request for a channel the client is not in that has no topic; {channel} is the channel name, verbatim.
#: client/js/irc/handlers/topic.ts
msgctxt "msg.topicUnsetFor"
msgid "No topic is set for {channel}."
msgstr "No hay tema establecido para {channel}."

#. Lobby status line when your own nick change is confirmed. {nick} is the new nick, user content, never translated.
#: client/js/irc/handlers/nick.ts
msgctxt "msg.youAreKnownAs"
msgid "You're now known as {nick}"
msgstr "Ahora eres conocido como {nick}"

#. Reason under 'Not sent: {message}' when a multi-line message's framing leaves no space for any text. {prefix} and {maxBytes} are byte counts.
#: client/js/irc/multiline.ts
msgctxt "multiline.noRoom"
msgid "No room for message text: {prefix} bytes of line prefix, {maxBytes} bytes per message"
msgstr "No espacio para texto del mensaje: {prefix} bytes de prefijo de línea, {maxBytes} bytes por mensaje"

#. Desktop notification title when another user invites the reader to a channel; the body names the inviter and channel.
#: client/js/socket-events/msg.ts
msgctxt "notify.channelInvite"
msgid "New channel invite:"
msgstr "Nuevo invitación a canal:"

#. Desktop notification body when another user invites the reader to a channel; {nick} and {channel} are the inviter's name and the channel name, both verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.inviteBody"
msgid "{nick} invited you to {channel}"
msgstr "{nick} te invitó a {channel}"

#. Desktop notification title for a channel event that is not a message (e.g. an action); {nick} is the sender's name and {channel} the channel name, both verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.titleChannel"
msgid "{nick} ({channel})"
msgstr "{nick} ({channel})"

#. Desktop notification title for a channel message; {nick} is the sender's name and {channel} the channel name, both verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.titleChannelSays"
msgid "{nick} ({channel}) says:"
msgstr "{nick} ({channel}) dice:"

#. Desktop notification title for a private message; {nick} is the sender's name, verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.titleSays"
msgid "{nick} says:"
msgstr "{nick} dice:"

#. Reason fragment of 'Not sent ({reason}): {text}' when the connection dropped with the message still unconfirmed. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
#: client/js/irc/pending.ts
msgctxt "pending.connectionLost"
msgid "connection lost"
msgstr "conexión perdida"

#. Reason fragment of 'Not sent ({reason}): {text}' when the server stayed silent for a minute. Lowercase mid-sentence by position.
#: client/js/irc/pending.ts
msgctxt "pending.noAcknowledgement"
msgid "no acknowledgement from the server"
msgstr "no confirmación del servidor"

#. Error under a message the server never confirmed. {reason} is a short cause (one of the pending.* fragments or the server's own rejection text, verbatim); {text} is the message as typed, user content, verbatim.
#: client/js/irc/pending.ts
msgctxt "pending.notSent"
msgid "Not sent ({reason}): {text}"
msgstr "No enviado ({reason}): {text}"

#. Reason fragment of 'Not sent ({reason}): {text}' when a labelled rejection numeric names no text. {code} is the numeric, verbatim. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "pending.numericError"
msgid "error {code}"
msgstr ""

#. Lobby passthrough of a PERSISTENCE reply the app does not otherwise understand; {params} is the server's own words, verbatim.
#: client/js/irc/handlers/persistence.ts
msgctxt "persistence.echo"
msgid "Persistence: {params}"
msgstr "Persistencia: {params}"

#. Lobby status line confirming the state change the user asked for. {state} is the server's ON/OFF token, verbatim.
#: client/js/irc/handlers/persistence.ts
msgctxt "persistence.set"
msgid "Session persistence set to: {state}"
msgstr "Persistencia de sesión establecida a: {state}"

#. Lobby status line reporting the bouncer session's state. {state} is the server's ON/OFF token, verbatim.
#: client/js/irc/handlers/persistence.ts
msgctxt "persistence.status"
msgid "Session persistence (the server keeps you in your channels while disconnected): {state}"
msgstr "Persistencia de sesión (el servidor te mantiene en canales mientras estás desconectado): {state}"

#. Lobby status line reporting the bouncer session's state when the client's own persistence setting differs from what the server reports. {state} is the server's ON/OFF token, verbatim; {setting} is the client setting's value.
#: client/js/irc/handlers/persistence.ts:89
msgctxt "persistence.statusClientSetting"
msgid "Session persistence (the server keeps you in your channels while disconnected): {state} (your setting: {setting})"
msgstr "Persistencia de sesión (el servidor te mantiene en canales mientras estás desconectado): {state} (tu configuración: {setting})"

#. Body of the push opt-in prompt; explains what allowing push does and that it is chosen per network.
#: client/components/PushPrompt.vue
msgctxt "push.enableBody"
msgid "This server can wake this app when it has messages for you while it is closed. You can change this per network, in each network's settings."
msgstr "Este servidor puede despertar esta aplicación cuando tiene mensajes para ti mientras está cerrada. Puedes cambiar esto por red, en las configuraciones de cada red."

#. Title of the prompt shown at connect time asking whether to enable web push notifications for that chat network.
#: client/components/PushPrompt.vue
msgctxt "push.enableTitle"
msgid "Enable push notifications?"
msgstr "Habilitar notificaciones por push?"

#. Fallback for the network name in the push prompt's target line when no name is known for the chat network being asked about.
#: client/components/PushPrompt.vue
msgctxt "push.fallbackNetwork"
msgid "this network"
msgstr "esta red"

#. Button of the push opt-in prompt; declines and stops the app from ever asking again for that network.
#: client/components/PushPrompt.vue
msgctxt "push.never"
msgid "Never"
msgstr "Nunca"

#. Button of the push opt-in prompt; declines for now without disabling future prompts.
#: client/components/PushPrompt.vue
msgctxt "push.no"
msgid "No"
msgstr ""

#. Body of the push-renewal prompt; explains why the subscription broke and that re-subscribing can be done later from that network's settings.
#: client/components/PushPrompt.vue
msgctxt "push.renewBody"
msgid "This server's push key changed, so this device's push subscription for it no longer works. Subscribe again to keep being notified while the app is closed. You can also do this later from this network's settings."
msgstr "El clave de push de este servidor cambió, por lo que la suscripción por push de este dispositivo para él ya no funciona. Suscríbete de nuevo para seguir siendo notificado mientras la aplicación está cerrada. También puedes hacerlo más tarde en las configuraciones de esta red."

#. Title of the prompt shown at connect time when a chat server's push identity (its key) changed and the device's subscription must be renewed.
#: client/components/PushPrompt.vue
msgctxt "push.renewTitle"
msgid "Renew push notifications?"
msgstr "¿Volver a enviar notificaciones de actualización?"

#. Button of the push opt-in prompt; allows web push (the click doubles as the browser's permission gesture).
#: client/components/PushPrompt.vue
msgctxt "push.yes"
msgid "Yes"
msgstr "Sí"

#. Tooltip and aria-label of the ➕ button at the end of a message's reaction row; clicking opens the emoji picker.
#: client/components/MessageReactions.vue
msgctxt "reactions.add"
msgid "Add a reaction"
msgstr "Añadir una reacción"

#. Preview-bar hint in the emoji picker while a reaction is being composed; shift-clicking an emoji appends it instead of sending.
#: client/components/ReactionPicker.vue
msgctxt "reactions.buildingHint"
msgid "Shift-click to add more emoji"
msgstr "Haz clic con el botón izquierdo para agregar más emojis"

#. Preview-bar title in the emoji picker while the user is composing a reaction out of several emoji or typing one.
#: client/components/ReactionPicker.vue
msgctxt "reactions.buildingName"
msgid "Building a reaction"
msgstr "Creando una reacción"

#. aria-label of a reaction badge under a chat message. {reaction} is the emoji or word reaction, {users} the comma-joined names of who sent it.
#: client/components/MessageReactions.vue
msgctxt "reactions.by"
msgid "{reaction} by {users}"
msgstr "{reaction} por {users}"

#. Tooltip and aria-label of the ✕ button in the emoji picker's search field; clicking empties the field.
#: client/components/ReactionPicker.vue
msgctxt "reactions.clearSearch"
msgid "Clear search"
msgstr "Limpiar búsqueda"

#. Suffix appended to a reaction badge's aria-label when you took part in it, saying that clicking removes your reaction. Parenthesized.
#: client/components/MessageReactions.vue
msgctxt "reactions.clickToRemoveSuffix"
msgid "(click to remove yours)"
msgstr "(haz clic para eliminar la tuya)"

#. aria-label of the emoji picker popup that opens from a chat message to add a reaction to it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.dialogAria"
msgid "Add a reaction"
msgstr "Añadir una reacción"

#. Preview-bar hint of the emoji picker when nothing is highlighted or being composed; sums up the three ways to react.
#: client/components/ReactionPicker.vue
msgctxt "reactions.emptyHint"
msgid "Pick an emoji, type a word, or shift-click to combine several."
msgstr "Elige un emoji, escribe una palabra o haz clic con el botón izquierdo para combinar varios."

#. Label shown before the typed text on the emoji picker's free-text row, which sends what was typed as the reaction; the typed text follows it. Mid-sentence by position.
#: client/components/ReactionPicker.vue
msgctxt "reactions.freePrefix"
msgid "React with"
msgstr "Reaccionar con"

#. aria-label of the row of reaction badges under a chat message, listing who reacted with what.
#: client/components/MessageReactions.vue
msgctxt "reactions.groupAria"
msgid "Reactions"
msgstr "Reacciones"

#. Preview-bar hint in the emoji picker for a single emoji; shift-clicking another appends it to the reaction instead of sending. Keep the shift symbol.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintCombine"
msgid "⇧ to combine"
msgstr "⇧ para combinar"

#. Preview-bar hint in the emoji picker when the highlighted emoji is already on the message; clicking it takes the reaction back off.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintRemove"
msgid "Remove"
msgstr "Eliminar"

#. Preview-bar hint in the emoji picker for a typed reaction (a word or several emoji): pressing Enter sends it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintSend"
msgid "Enter to send"
msgstr "Entrar para enviar"

#. aria-label of the emoji picker's scrollable grid of emoji to pick from.
#: client/components/ReactionPicker.vue
msgctxt "reactions.listAria"
msgid "Emoji"
msgstr "Emoji"

#. Error note shown inside the emoji picker when the emoji catalog failed to download; the search field above still accepts any reaction as text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loadFailed"
msgid "The emoji list could not be loaded. You can still type a reaction above."
msgstr "La lista de emojis no se pudo cargar. Aún así puedes escribir una reacción arriba."

#. Note shown inside the emoji picker while its catalog is being fetched. Ellipsis is part of the copy.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loading"
msgid "Loading emoji…"
msgstr "Cargando emojis…"

#. Heading of the emoji picker's list while a search matched nothing (what was typed can still be sent as a reaction).
#: client/components/ReactionPicker.vue
msgctxt "reactions.noMatch"
msgid "No emoji match"
msgstr "No hay emojis coincidentes"

#. Heading of the emoji picker's section of suggested starter reactions, shown when nothing has been used recently, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.quickReactions"
msgid "Quick reactions"
msgstr "Reacciones rápidas"

#. Heading of the emoji picker's section of recently sent reactions, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.recentlyUsed"
msgid "Recently used"
msgstr "Recientemente usado"

#. Placeholder and aria-label of the emoji picker's search field; the same field doubles as the entry for a custom reaction (any text or emoji).
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchPlaceholder"
msgid "Search emoji, or type any reaction"
msgstr "Buscar emoji o escribir cualquier reacción"

#. Heading of the emoji picker's list while a search is showing matches.
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchResults"
msgid "Search results"
msgstr "Resultados de búsqueda"

#. Button in the emoji picker's preview bar; clicking sends the reaction being composed.
#: client/components/ReactionPicker.vue
msgctxt "reactions.send"
msgid "Send"
msgstr "Enviar"

#. Preview-bar note in the emoji picker for a remembered reaction that is not an emoji, saying it will be sent as words. Starts lowercase because it follows other text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.sentAsText"
msgid "sent as text"
msgstr "Enviado como texto"

#. aria-label of the row of tab buttons in the emoji picker that jumps to a group of emoji (smileys, animals, food…).
#: client/components/ReactionPicker.vue
msgctxt "reactions.tabsAria"
msgid "Emoji groups"
msgstr "Grupos de emoji"

#. Tooltip of the emoji picker's free-text row and its spoken form, offering to send what was typed as the reaction. {reaction} is that text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.titleTemplate"
msgid "React with {reaction}"
msgstr "Reaccionar con {reaction}"

#. aria-label of the magnifier button in a chat window's header; clicking it opens the message-search field for the conversation.
#: client/components/MessageSearchForm.vue:19
msgctxt "search.openForm"
msgid "Search messages in this channel"
msgstr "Buscar mensajes en este canal"

#. Placeholder of the message-search field that opens from the magnifier in a chat window's header; it filters this conversation's history.
#: client/components/MessageSearchForm.vue:10
msgctxt "search.placeholder"
msgid "Search messages…"
msgstr "Buscar mensajes…"

#. aria-label of the search-results view of the chat window, which lists the messages matching a search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.aria"
msgid "Search results"
msgstr "Resultados de búsqueda"

#. Tooltip and aria-label of the ✕ button in the search-results header; clicking closes the search and returns to the conversation.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.close"
msgid "Close search window"
msgstr "Cerrar ventana de búsqueda"

#. Shown in the search-results view when the search matched no messages.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.none"
msgid "No results found."
msgstr "No se encontraron resultados."

#. Note under the search results, explaining that the search covers only the messages currently loaded in the app, not the full history on the server. Em dash is part of the copy.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.scopeNote"
msgid "Only messages loaded in this session are searched — older history is not searched."
msgstr "Solo los mensajes cargados en esta sesión se buscan — el historial anterior no se busca."

#. Second fragment of the search-results window header, rendered after the styled channel-name element; the search term itself follows the header. The element (the channel's or query window's name — user content, never translated) sits between this fragment and the one before it. Word order inside each fragment is free; the fragments cannot cross the element. Ends mid-sentence.
#: client/components/Windows/SearchResults.vue:21
msgctxt "search.results.searchingInAfter"
msgid "for"
msgstr "para"

#. First fragment of the search-results window header, rendered before the styled channel-name element. That element (the channel's or query window's name — user content, never translated, like a <Username>) sits between this fragment and the one after it. Word order inside each fragment is free; the fragments cannot cross the element.
#: client/components/Windows/SearchResults.vue:19
msgctxt "search.results.searchingInBefore"
msgid "Searching in"
msgstr "Búsqueda en"

#. Button at the top of the search results list that fetches more matches. {count} is how many further matches are available.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.showOlder"
msgid "Show older results ({count} more)"
msgstr "Mostrar resultados antiguos ({count} más)"

#. Shown in the search-results view when the search field is empty; invites typing a query.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.typePrompt"
msgid "Type something to search for."
msgstr "Escribir algo para buscar."

#. Lobby error when the server never answered the redaction an edit depends on.
#: client/js/irc/client.ts
msgctxt "send.editNoReply"
msgid "Edit not sent: no reply from the server."
msgstr "Edición no enviada: no hay respuesta del servidor."

#. Lobby error when a second edit of the same message was sent before the first one settled.
#: client/js/irc/client.ts
msgctxt "send.editWaiting"
msgid "Edit not sent: an edit of that message is already waiting for the server."
msgstr "Edición no enviada: una edición de ese mensaje ya está esperando al servidor."

#. Lobby error when a command or message was typed while the network is down; nothing was sent.
#: client/js/irc/client.ts
#: client/js/irc/commands/index.ts:215
#: client/js/irc/commands/index.ts:224
msgctxt "send.notConnected"
msgid "You are not connected to the IRC network, unable to send your command."
msgstr "No estás conectado a la red IRC, no puedes enviar tu comando."

#. Lobby error when an IRC line could not be written to the socket. {message} is a technical transport error, left verbatim.
#: client/js/irc/client.ts
msgctxt "send.notSent"
msgid "Not sent: {message}"
msgstr "No enviado: {message}"

#. Lobby error when the server's push-subscription registration line exceeds the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.pushTooLong"
msgid "Not sent: the push subscription does not fit on one line"
msgstr "No enviado: la suscripción de empuje no cabe en una línea"

#. Lobby error when a reaction was sent on a server without message-tags.
#: client/js/irc/client.ts
msgctxt "send.reactNeedsTags"
msgid "Reactions need the message-tags capability, which this server did not enable."
msgstr "Las reacciones necesitan la capacidad de mensaje-etiqueta, que este servidor no habilitó."

#. Lobby error when a reaction was sent in a window that carries no messages.
#: client/js/irc/client.ts
msgctxt "send.reactTargets"
msgid "Reactions can only be sent in channels and queries."
msgstr "Las reacciones solo pueden enviarse en canales y consultas."

#. Lobby error when deletion was tried outside a channel.
#: client/js/irc/client.ts
msgctxt "send.redactChannels"
msgid "Messages can only be deleted in channels."
msgstr "Los mensajes solo pueden borrarse en canales."

#. Lobby error when deletion was tried on a server without the redaction capability.
#: client/js/irc/client.ts
msgctxt "send.redactUnavailable"
msgid "Deleting messages is not available: the server did not enable draft/message-redaction."
msgstr "Borrar mensajes no está disponible: el servidor no habilitó el borrador/mensaje-redacción."

#. Lobby error when a message's client tags exceed the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.tagsTooLong"
msgid "Not sent: the tags do not fit on one line"
msgstr "No enviado: las etiquetas no caben en una línea"

#. Button under the alias table: appends a new, empty alias row to edit.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.add"
msgid "Add alias"
msgstr "Agregar alias"

#. aria-label of an alias row's commands (body) input. {name} is the alias's name — or, while the name is empty, the row's number; verbatim user content either way, never translated.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyAria"
msgid "Commands for alias {name}"
msgstr "Comandos para el alias {name}"

#. Example body shown in the alias-body input: an IRC action waving at the first argument. Keep the /me command and the $1 token verbatim; the action wording is an example and may be adapted.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyPlaceholder"
msgid "/me waves at $1"
msgstr "/me saluda a $1"

#. Shown in place of the alias table when no aliases are defined.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.empty"
msgid "No aliases yet."
msgstr "No hay alias aún."

#. Row error: the alias has a name but no commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorBody"
msgid "Say what the alias runs."
msgstr "Decir lo que hace el alias."

#. Row error: another row already defines this alias. {name} is the other alias's name, verbatim user content; the slash before it is the command prefix.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorDuplicate"
msgid "There is already a /{name}."
msgstr "Ya existe un /{name}."

#. Row error under an alias row: the alias has no name.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorName"
msgid "Give the alias a name."
msgstr "Dar un nombre al alias."

#. Row error: the alias name contains characters other than letters, digits, hyphen and underscore. The - and _ are literal characters, keep them.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorNameChars"
msgid "Names are letters, digits, - and _ — no spaces or slashes."
msgstr "Los nombres son letras, números, - y _ — no espacios ni barras."

#. Row error: the body exceeds the length limit. {limit} is the maximum number of characters (a number).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorTooLong"
msgid "The body is too long (over {limit} characters)."
msgstr "El cuerpo es demasiado largo (más de {limit} caracteres)."

#. Column heading of the alias editor table: the name of the slash command being defined. The header row is aria-hidden; each input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headName"
msgid "Alias"
msgstr "Apodo"

#. Column heading of the alias editor table: the command lines the alias runs (its body). The header row is aria-hidden; the body input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headRuns"
msgid "Runs"
msgstr "Ejecuta"

#. Joins the last two entries of the alias-body variable list ($2- or $*). Single word; the spaces around it come from the template.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.introOr"
msgid "or"
msgstr "o"

#. Intro fragment (Settings -> Aliases): leads into the example alias invocation that follows in code style; the fragment ends where the example begins.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.introOwn"
msgid "An alias is a slash command of your own. Typing"
msgstr "Un alias es un comando slash propio. Escribir"

#. Intro fragment between the example invocation and the variable list: what defining an alias does. Sits in front of the $1 token.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.introRuns"
msgid "runs what you define here — one command per line, with the arguments filled in where the body says"
msgstr "corre lo que defines aquí — un comando por línea, con los argumentos completados donde el cuerpo lo indica"

#. aria-label of an alias row's name input. {number} is the row's position, counting from 1.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nameAria"
msgid "Alias name {number}"
msgstr "Nombre de alias {number}"

#. Placeholder of the alias-name input: the alias's name goes here.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.namePlaceholder"
msgid "name"
msgstr "nombre"

#. Nested-alias fragment between the two example commands: the first command can be rewritten as the second.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nestedBecomes"
msgid "can become"
msgstr "puede convertirse en"

#. Nested-alias fragment: aliases may call other aliases and shadow built-in commands; the two example commands follow in code style.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nestedMain"
msgid "A body line can invoke another alias, and an alias named after a built-in command replaces it —"
msgstr "Una línea de cuerpo puede invocar otro alias, y un alias nombrado después de un comando integrado lo reemplaza —"

#. Nested-alias fragment: closes the example — shadowing a built-in does not recurse for ever.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nestedTail"
msgid "without looping."
msgstr "sin bucles."

#. aria-label of the whole aliases pane (a role=group in Settings); heard by screen readers when they enter the pane.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.paneAria"
msgid "Command aliases"
msgstr "Aliases de comandos"

#. Live preview: the typed text matched no alias, so it would go to the server exactly as typed.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.previewMiss"
msgid "Not an alias — this would be sent as typed."
msgstr "No es un alias — esto se enviaría tal como se escribió."

#. aria-label of an alias row's remove button (trash icon; no visible text). {name} is the alias's name — or the row's number while the name is empty; verbatim user content.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.removeAria"
msgid "Remove alias {name}"
msgstr "Eliminar alias {name}"

#. Status line when some rows have errors and are not saved yet. {count} is the number of saved aliases; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusBroken"
msgid "{count} alias saved — rows with errors are not saved."
msgid_plural "{count} aliases saved — rows with errors are not saved."
msgstr[0] "{count} alias guardados — las filas con errores no se guardan."
msgstr[1] "{count} aliasess guardadas — las filas con errores no se guardan."

#. Status line under the alias table: how many aliases are saved. {count} is the number; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusSaved"
msgid "{count} alias saved."
msgid_plural "{count} aliases saved."
msgstr[0] "{count} alias guardados."
msgstr[1] "{count} aliasess guardadas."

#. Heading of the command-aliases pane in Settings, where the user defines their own slash commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.titleHeading"
msgid "Command aliases"
msgstr "Aliases de comandos"

#. aria-label of the try-it input: type an alias invocation to preview its expansion.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryAria"
msgid "Try an alias"
msgstr "Intenta un alias"

#. Try-it placeholder when at least one valid alias exists: an example invocation of that alias. {name} is the alias's name, verbatim; the rest is example prose.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryExample"
msgid "/{name} some arguments"
msgstr "/{name} algunos argumentos"

#. Heading of the live preview: type an alias invocation and see the commands it expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryHeading"
msgid "Try it"
msgstr "Inténtalo"

#. Variable reference: what $chan expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varChan"
msgid "the current channel or query"
msgstr "el canal actual o la consulta"

#. Variable reference fragment: introduces the $$ escape, which follows in code style as a single dollar sign.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varLiteral"
msgid "a literal"
msgstr "un literal"

#. Variable reference: what $me expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varMe"
msgid "your nick on that network"
msgstr "tu nick en esa red"

#. Variable reference: what $1 expands to in an alias body.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varOne"
msgid "one argument (empty when not given)"
msgstr "un argumento (en blanco cuando no se proporciona)"

#. Variable reference: what $2- expands to (everything from the second argument on).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varRest"
msgid "arguments from the 2nd to the last"
msgstr "argumentos desde el segundo hasta el último"

#. Variable reference: what $* expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varStar"
msgid "everything after the alias name"
msgstr ""

#. Heading of the variables reference: the dollar placeholders an alias body can use.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.variablesHeading"
msgid "Variables"
msgstr ""

#. Checkbox in Settings > Appearance; when ticked, typing in the message input suggests completions for names, emoji and commands.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.autocomplete"
msgid "Enable autocomplete"
msgstr "Habilitar autocompletar"

#. Checkbox in Settings > Appearance; when ticked, each user's name in chat is drawn in its own consistent color.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.coloredNicks"
msgid "Enable colored nicknames"
msgstr "Habilitar nombres de usuario coloreados"

#. Heading of the section in Settings > Appearance holding the user's own CSS. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheet"
msgid "Custom Stylesheet"
msgstr "Estilo personalizado"

#. Visually hidden label of the custom stylesheet text area in Settings > Appearance, where CSS rules overriding the app's own styles can be entered.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetHelp"
msgid "Custom stylesheet. You can override any style with CSS here."
msgstr "Estilo personalizado. Puedes sobrescribir cualquier estilo con CSS aquí."

#. Placeholder of the custom stylesheet text area in Settings > Appearance, written as a CSS comment. Keep the /* */ comment markers.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetPlaceholder"
msgid "/* You can override any style with CSS here */"
msgstr "/* Puedes sobreescribir cualquier estilo con CSS aquí */"

#. aria-label of the slider in Settings > Appearance that changes the size of chat text and the interface with it.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeAria"
msgid "Message font size"
msgstr "Tamaño de la fuente del mensaje"

#. Heading of the text size control in Settings > Appearance; a slider that scales the whole interface.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeHeading"
msgid "Font size"
msgstr "Tamaño de la fuente"

#. Label of the largest step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:458
msgctxt "settings.appearance.fontSizeHuge"
msgid "Huge"
msgstr "Gigante"

#. Label of the default step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:456
msgctxt "settings.appearance.fontSizeLarge"
msgid "Large"
msgstr "Grande"

#. Label of the middle step of the font-size slider in Settings → Appearance: the browser's default size. One word.
#: client/components/Settings/Appearance.vue:455
msgctxt "settings.appearance.fontSizeMedium"
msgid "Medium"
msgstr "Mediano"

#. Label of the second step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:454
msgctxt "settings.appearance.fontSizeSmall"
msgid "Small"
msgstr "Pequeño"

#. Label of the smallest step of the font-size slider in Settings → Appearance: the datalist stop and the value shown while dragging. One word.
#: client/components/Settings/Appearance.vue:453
msgctxt "settings.appearance.fontSizeTiny"
msgid "Tiny"
msgstr "Chico"

#. Label of the second-largest step of the font-size slider in Settings → Appearance.
#: client/components/Settings/Appearance.vue:457
msgctxt "settings.appearance.fontSizeXlarge"
msgid "Extra large"
msgstr "Extra grande"

#. Checkbox in Settings > Appearance; when ticked, chat messages are rendered with Markdown styling such as bold text, code blocks and spoiler marks. Ellipsis is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.markdown"
msgid "Render Markdown formatting (bold, code, spoilers…)"
msgstr "Renderizar formato Markdown (negrita, código, spoilers...)"

#. Checkbox in Settings > Appearance; when ticked, links to media are shown as an inline playable preview inside the chat instead of a plain link.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.media"
msgid "Preview images, video and audio links inline"
msgstr "Vistas previas de imágenes, videos y audios en línea"

#. Radio option in Settings > Appearance; media previews load on their own as soon as a message contains one, which exposes your address to the media site. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaAlways"
msgid "Show automatically — the media site sees your address as soon as a link appears"
msgstr "Mostrar automáticamente — el sitio de medios lo ve como tu dirección en cuanto aparece un enlace"

#. Radio option in Settings > Appearance; media previews stay behind a placeholder until you click them, so nothing is loaded from the media site before that. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaClick"
msgid "Click to reveal — nothing is fetched from the media site until you ask to see it"
msgstr "Hacer clic para revelar — nada se carga del sitio de medios hasta que lo pides"

#. Heading of the media preview section in Settings > Appearance, which controls how links to images, video and audio are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaHeading"
msgid "Media previews"
msgstr "Vistas previas de medios"

#. Visually hidden group label of the two radio choices in Settings > Appearance that decide when media previews are fetched from their site.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaRevealGroup"
msgid "When to load previews"
msgstr "Cuándo cargar previsualizaciones"

#. Heading of the message display section in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.messagesHeading"
msgid "Messages"
msgstr "Mensajes"

#. Expansion of the acronym MOTD, shown as the abbreviation's hover tooltip on the Message Of The Day checkbox in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.motdTitle"
msgid "Message Of The Day"
msgstr "Mensaje del Día"

#. Label of the text field in Settings > Appearance that sets the character(s) inserted after a completed user's name, for example a comma.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfix"
msgid "Nick autocomplete postfix"
msgstr "Postfix de autocompletado de nick"

#. Tooltip on the nick autocomplete postfix field in Settings > Appearance; explains what the field sets.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixHelp"
msgid "Nick autocomplete postfix (for example a comma)"
msgstr "Postfix de autocompletado de nick (por ejemplo, una coma)"

#. Placeholder of the nick autocomplete postfix field in Settings > Appearance; keep the example punctuation (the quoted comma) as it shows what would be typed.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixPlaceholder"
msgid "Nick autocomplete postfix (e.g. ', ')"
msgstr "Postfix de autocompletado de nick (por ejemplo, ', ')"

#. Third line of the sample chat under the font-size slider in Settings → Appearance: the extreme steps are intentionally unusable.
#: client/components/Settings/Appearance.vue:486
msgctxt "settings.appearance.sampleEnds"
msgid "The ends are meant to be too small and too big."
msgstr "Los extremos están diseñados para ser demasiado pequeños y demasiado grandes."

#. First line of the sample chat under the font-size slider in Settings → Appearance, written by the sample nick grandma: it asks whether the text is comfortable to read.
#: client/components/Settings/Appearance.vue:474
msgctxt "settings.appearance.sampleGlasses"
msgid "Can you read this without your glasses?"
msgstr "¿Puedes leer esto sin tus lentes?"

#. Second line of the sample chat under the font-size slider in Settings → Appearance, the reply telling the reader to drag the slider until the text is comfortable.
#: client/components/Settings/Appearance.vue:480
msgctxt "settings.appearance.sampleSlide"
msgid "Yes! Slide it until this is comfortable."
msgstr "Sí! Desliza hasta que esto esté cómodo."

#. First word of the checkbox label in Settings > Appearance that displays the server's Message Of The Day; the untranslated acronym 'MOTD' follows it as a marked abbreviation, so only this word is translated.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showMotd"
msgid "Show"
msgstr "Mostrar"

#. Checkbox in Settings > Appearance; when ticked, message timestamps include the seconds as well as hours and minutes.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showSeconds"
msgid "Include seconds in timestamp"
msgstr "Incluir segundos en la marca de tiempo"

#. Radio option in Settings > Appearance; joins and parts are compressed into one summary line to keep the chat short.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusCondensed"
msgid "Condense status messages together"
msgstr "Condensar los mensajes de estado"

#. Heading of the section in Settings > Appearance that controls how join, part and similar service notices are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHeading"
msgid "Status messages"
msgstr "Mensajes de estado"

#. Tooltip on the status messages heading in Settings > Appearance; lists the kinds of notices meant (people joining or leaving, being removed, renaming, and permission changes).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHelp"
msgid "Joins, parts, quits, kicks, nick changes, and mode changes"
msgstr "Unirse, partir, salir, expulsar, cambios de nick y cambios de modo"

#. Radio option in Settings > Appearance; joins, parts and similar service notices are not shown at all.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHidden"
msgid "Hide all status messages"
msgstr "Ocultar todos los mensajes de estado"

#. Radio option in Settings > Appearance; every join, part or similar notice appears as its own line in the chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusShown"
msgid "Show all status messages individually"
msgstr "Mostrar todos los mensajes de estado individualmente"

#. Heading of the theme section in Settings > Appearance, and the visually hidden label of the theme dropdown beneath it; picks the color scheme of the app.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.theme"
msgid "Theme"
msgstr "Tema"

#. The name of the button on a media preview that marks its site, sender or channel as always allowed to load; the words appear quoted inside the always-shown list's help sentence in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedButtonName"
msgid "Always show"
msgstr "Mostrar siempre"

#. Subheading in the always-shown media list of Settings > Appearance above the chat channel entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedChannels"
msgid "Channels"
msgstr "Canales"

#. Button in Settings > Appearance beside the always-shown list heading; clicking removes every entry from that list.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedClear"
msgid "Clear all"
msgstr "Limpiar todo"

#. Shown under the always-shown media list in Settings > Appearance when it has no entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedEmpty"
msgid "Nothing yet."
msgstr "Nada aún."

#. Heading of the list in Settings > Appearance of sites, people and channels whose media always loads without asking.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHeading"
msgid "Always shown"
msgstr "Siempre mostrado"

#. First part of the help line under the always-shown list in Settings > Appearance; the second part and the words 'Always show' (the name of the button on any media preview) follow it. Ends mid-sentence.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHelpA"
msgid "Media in these scopes loads without asking. Add one with"
msgstr "Los medios en estos alcances se cargan sin preguntar. Agregar uno con"

#. Last part of the help line under the always-shown list in Settings > Appearance, after the words 'Always show' marking the preview button's name. Ends the sentence.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHelpB"
msgid "on any preview."
msgstr "en cualquier antebrazo."

#. Subheading in the always-shown media list of Settings > Appearance above the user account entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedPeople"
msgid "People"
msgstr "Personas"

#. Subheading in the always-shown media list of Settings > Appearance above the website entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedSites"
msgid "Sites"
msgstr "Sitios"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a website or a person. {name} is that site's host or the person's name. Clicking stops their media from loading automatically.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustFrom"
msgid "Stop always showing from {name}"
msgstr "Detener siempre mostrar desde {name}"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a chat channel. {name} is that channel's name.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustIn"
msgid "Stop always showing in {name}"
msgstr "Detener siempre mostrar en {name}"

#. Checkbox in Settings > Appearance; when ticked, message timestamps use a 12-hour clock (am/pm) instead of a 24-hour clock.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.use12hClock"
msgid "Use 12-hour timestamps"
msgstr "Usar las horas 12"

#. Heading of the section in Settings > Appearance holding readability helpers such as nickname colors and autocomplete. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.visualAids"
msgid "Visual Aids"
msgstr "Ayudas visuales"

#. Heading of the away section in Settings > General, and the visually hidden label of the away-message input beneath it; names the setting that marks you away with a message when the app is closed.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayHeading"
msgid "Automatic away message"
msgstr "Mensaje de ausencia automático"

#. Placeholder of the away-message field in Settings > General; shows the message that is sent automatically while the app is not open. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayPlaceholder"
msgid "Away message if {appName} is not open"
msgstr "Mensaje de ausencia si {appName} no está abierto"

#. Sentence shown in the restore-confirmation dialog in Settings > General, saying when the backup file was made. {date} is that day written out in the reader's language (e.g. 9 September 2026). A whole sentence: the dialog puts the separating space in.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupExported"
msgid "Exported {date}."
msgstr "Exportado {date}."

#. Body of the confirmation dialog before restoring a settings backup in Settings > General. {parts} is a comma-joined list ('your settings, 1 network, mutes and ignore lists'), {file} the chosen backup file's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupFrame"
msgid "This replaces {parts} with the contents of {file}, then reloads."
msgstr "Esto reemplaza {parts} con el contenido de {file}, luego se recarga."

#. Heading of the settings backup section in Settings > General, which exports preferences to a file and restores them.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupHeading"
msgid "Backup and restore"
msgstr "Backup y restauración"

#. Intro line under the Backup and restore heading in Settings > General; says what exporting does.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupIntro"
msgid "Save your settings to a file. You can restore here or on another device."
msgstr "Guardar tus ajustes en un archivo. Puedes restaurar aquí o en otro dispositivo."

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for muted users and ignored users. Comma-joined by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupMutes"
msgid "mutes and ignore lists"
msgstr "Mutes e ignorancias"

#. Part of the settings-restore confirmation in Settings > General; fills the list of what a restore replaces with how many saved chat networks the file carries. The singular shows with exactly one network, the plural otherwise.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupNetworks"
msgid "{count} network"
msgid_plural "{count} networks"
msgstr[0] "{count} red"
msgstr[1] "{count} redes"

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for the app's own preferences. Comma-joined with the other parts by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPartSettings"
msgid "your settings"
msgstr "tus ajustes"

#. Sentence shown in the restore-confirmation dialog in Settings > General when the backup file contains saved network passwords. It is a whole sentence: the dialog puts the separating space in, so the translation needs no padding of its own.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPasswords"
msgid "The file includes network passwords."
msgstr "El archivo incluye contraseñas de red."

#. Button in Settings > General; downloads the settings backup file to the device. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.export"
msgid "Export settings…"
msgstr "Exportar ajustes…"

#. Error message in Settings > General shown when exporting the settings backup failed and no file was produced.
#: client/components/Settings/General.vue
msgctxt "settings.general.exportFailed"
msgid "Couldn't create the file."
msgstr "No se pudo crear el archivo."

#. Visually hidden but screen-reader-spoken label of the hidden file picker behind the Import settings button; it accepts a previously exported settings file.
#: client/components/Settings/General.vue
msgctxt "settings.general.fileAria"
msgid "Settings file to restore"
msgstr "Archivo de configuración para restaurar"

#. Button in Settings > General; opens a file picker to restore a previously exported settings backup file. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.import"
msgid "Import settings…"
msgstr "Importar configuraciones…"

#. Confirmation button of the settings-restore dialog in Settings > General; clicking restores the file and reloads the app.
#: client/components/Settings/General.vue
msgctxt "settings.general.importButton"
msgid "Import and reload"
msgstr "Importar y recargar"

#. Error notice under the import control in Settings → General when the backup file is corrupt or truncated. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importDamaged"
msgid "This file is damaged."
msgstr "Este archivo está dañado."

#. Error message in Settings > General shown when the chosen file could not be read as a settings backup.
#: client/components/Settings/General.vue
msgctxt "settings.general.importFailed"
msgid "Couldn't read the file."
msgstr "No se pudo leer el archivo."

#. Error notice under the import control in Settings → General when the backup was written by a newer build of the app that this one cannot read. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNewer"
msgid "This file was made by a newer version."
msgstr "Este archivo fue creado por una versión más reciente."

#. Error notice under the import control in Settings → General when the browser lacks the DecompressionStream API the compressed backup needs. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNoDecompression"
msgid "This browser can't read compressed files."
msgstr "Este navegador no puede leer archivos comprimidos."

#. Error notice under the import control in Settings → General when the chosen file is not a settings backup (wrong shape, unparseable). Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNotSettings"
msgid "This isn't a settings file."
msgstr "Esto no es un archivo de configuración."

#. Title of the confirmation dialog shown before a settings backup file is restored from Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.importTitle"
msgid "Import settings?"
msgstr "Importar configuraciones?"

#. Checkbox in Settings > General's backup section; when ticked, the exported settings file also contains the saved chat network passwords.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswords"
msgid "Include network passwords"
msgstr "Incluir contraseñas de red"

#. Tooltip on the include-network-passwords checkbox in Settings > General; warns that the export keeps passwords in plain text.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswordsHelp"
msgid "Passwords are stored in the file unencrypted."
msgstr "Las contraseñas se almacenan en el archivo sin cifrar."

#. Button in Settings > General; clicking shows the browser's prompt that installs this web app to the device's home screen or app list. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.installApp"
msgid "Install {appName} as an app"
msgstr "Instalar {appName} como una aplicación"

#. Heading of the Native app section in Settings > General; groups the install and link-handler options for using the chat app as an installed application.
#: client/components/Settings/General.vue
msgctxt "settings.general.nativeApp"
msgid "Native app"
msgstr "Aplicación nativa"

#. Button in Settings > General; registers this web app as the handler for web+irc:// chat links so clicking one anywhere opens it in the app. Keep the web+irc:// scheme verbatim. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.openLinks"
msgid "Open web+irc:// links with {appName}"
msgstr "Abrir enlaces web+irc:// con {appName}"

#. Checkbox in Settings > General; when ticked, other people in the channel are told while you are typing a message.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTyping"
msgid "Send typing notifications"
msgstr "Notificaciones de teclado"

#. Tooltip on the send-typing-notifications checkbox in Settings > General; mentions the IRCv3 +typing tag in parentheses.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTypingHelp"
msgid "Lets people in the channel see when you are typing (IRCv3 +typing)."
msgstr "Permite que las personas en el canal vean cuando estás escribiendo (IRCv3 + typing)."

#. Heading of the typing indicator section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.typingHeading"
msgid "Typing notifications"
msgstr "Notificaciones de teclado"

#. Checkbox in Settings > General. When ticked, images are re-drawn through a canvas before they are sent to the chat server, which strips photo metadata such as camera model and GPS location. Affects image uploads only.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvas"
msgid "Attempt to remove metadata from images before uploading"
msgstr "Intentar eliminar metadatos de imágenes antes de subir"

#. Tooltip on the metadata-removal upload checkbox in Settings > General; explains how the option works and that it can mis-rotate photos in browsers without canvas orientation support.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvasHelp"
msgid "This option renders the image into a canvas element to remove metadata from the image. This may break orientation if your browser does not support that."
msgstr "Opción que convierte la imagen en un elemento canvas para eliminar metadatos de la imagen. Esto podría romper la orientación si su navegador no lo soporta."

#. Heading of the file upload options section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadsHeading"
msgid "File uploads"
msgstr "Subida de archivos"

#. The first option of the interface-language picker: the language the browser asks for is used. {language} is that language's name, written in itself.
#: client/components/LanguageSelect.vue
msgctxt "settings.locale.auto"
msgid "System default ({language})"
msgstr "Sistema predeterminado ({language})"

#. Button on the networks settings page; opens the connect form to set up a new chat network connection.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.add"
msgid "Add network"
msgstr "Agregar red"

#. Button on a saved network row in the networks settings page while that network is offline; clicking dials the chat network again.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connect"
msgid "Connect"
msgstr "Conectar"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is up.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connected"
msgid "Connected"
msgstr "Conectado"

#. Status label on a saved network row in the networks settings page, and the caption of the same row's button, while the connection to that chat network is being established. Ellipsis is part of the copy.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connecting"
msgid "Connecting…"
msgstr "Conectando…"

#. Button on a saved network row in the networks settings page; opens a confirmation before the saved network is removed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.delete"
msgid "Delete"
msgstr "Eliminar"

#. Confirmation button of the dialog that removes a saved chat network.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteButton"
msgid "Delete network"
msgstr "Eliminar red"

#. Body of the confirmation dialog before removing a saved chat network; explains what the deletion does.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteText"
msgid "This removes the saved network and disconnects it if it is running."
msgstr "Esto elimina la red guardada y la desconecta si está en ejecución."

#. Title of the confirmation dialog before removing a saved chat network. {name} is the network's display name.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteTitle"
msgid "Delete {name}?"
msgstr "Borrar {name}?"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is down.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.disconnected"
msgid "Disconnected"
msgstr "Desconectado"

#. Button on a saved network row in the networks settings page; opens the form where that network's address and credentials are changed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.edit"
msgid "Edit"
msgstr "Editar"

#. Empty state of the networks settings page, shown when no chat network has been saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.empty"
msgid "No networks saved yet."
msgstr "No se han guardado redes aún."

#. Heading of the networks page in the chat app's settings, which lists the IRC network connections saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.heading"
msgid "Networks"
msgstr "Redes"

#. Line under the Networks heading in the settings, saying what the page is for.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.intro"
msgid "Manage the IRC networks saved in this browser."
msgstr "Administrar las redes IRC guardadas en este navegador."

#. Button on a saved network row in the networks settings page while that network is connected; clicking opens the network's chat view.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.open"
msgid "Open"
msgstr "Abrir"

#. Warning line in Settings > Notifications when notification permission has been denied in the browser.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserBlocked"
msgid "Notifications are blocked by your browser."
msgstr "Las notificaciones están bloqueadas por su navegador."

#. Heading of the section in Settings > Notifications about the browser's own notifications while the app is open.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserHeading"
msgid "Browser Notifications"
msgstr "Notificaciones del navegador"

#. Intro line of the browser notifications section in Settings > Notifications; the quoted phrase names the toggle in each network's edit form. Keep the curly quotes.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserPerNetwork"
msgid "Browser notifications are also per network — enabled by default, toggled in each network's settings (Edit network → “Browser notifications for this network”)."
msgstr "Las notificaciones del navegador también son por red — activadas por defecto, y se pueden alternar en cada configuración de red (Editar red → “Notificaciones del navegador para esta red”)."

#. Warning line in Settings > Notifications when the browser cannot show notifications at all.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserUnsupported"
msgid "Notifications are not supported by your browser."
msgstr "Las notificaciones no están soportadas por su navegador."

#. Placeholder of the custom-highlights and highlight-exceptions fields in Settings > Notifications; shows the expected input format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.commaList"
msgid "Comma-separated, e.g.: word, some more words, anotherword"
msgstr "separados por comas, por ejemplo: palabra, algunas palabras más, otropalabra"

#. Checkbox in Settings > Notifications; when ticked, messages mentioning you are drawn with a colored background and can notify.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlight"
msgid "Highlight messages that mention you"
msgstr "Destacar mensajes que mencionen a usted"

#. Label of the text field in Settings > Notifications for words that suppress highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptions"
msgid "Highlight exceptions"
msgstr "Destacar excepciones"

#. Tooltip on the highlight-exceptions field in Settings > Notifications; explains that these words suppress highlight treatment.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptionsHelp"
msgid "If a message contains any of these comma-separated expressions, it will not trigger a highlight even if it contains your nickname or expressions defined in custom highlights."
msgstr "Si un mensaje contiene alguna de estas expresiones separadas por comas, no activará un destacado incluso si contiene su apodo o expresiones definidas en destacados personalizados."

#. Tooltip on the highlight checkbox in Settings > Notifications; explains the visual effect of highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightHelp"
msgid "Messages that mention you or match a custom highlight get a colored background and border in the channel."
msgstr "Los mensajes que mencionen a usted o coincidan con un destacado personalizado tendrán un fondo y un borde coloridos en el canal."

#. Label of the text field in Settings > Notifications for extra words that count as mentions of you.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlights"
msgid "Custom highlights"
msgstr "Destacados personalizados"

#. Tooltip on the custom highlights field in Settings > Notifications; explains the field's comma-separated format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightsHelp"
msgid "If a message contains any of these comma-separated expressions, it will trigger a highlight."
msgstr "Si un mensaje contiene alguna de estas expresiones separadas por comas, activará un destacado."

#. Warning line in Settings > Notifications, shown on an iPhone browsing the app without installing it; the parenthesized phrase is the iOS share menu's action.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.iosNotInstalled"
msgid "On iOS, push notifications are only available after installing the app to the Home Screen (Share → Add to Home Screen)."
msgstr "En iOS, las notificaciones por push solo están disponibles después de instalar la app en la pantalla principal (Compartir → Añadir a la pantalla principal)."

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: show a confirmation prompt before the device re-subscribes. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeAsk"
msgid "Wary — ask before renewing the subscription"
msgstr "Cuidadoso — pregunta antes de renovar la suscripción"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: do nothing, so push stays off for that server until renewed from its network settings. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIgnore"
msgid "Suspicious — leave it alone; push from that server stays off until you renew from the network settings"
msgstr "sospechoso — déjalo en paz; las notificaciones de ese servidor permanecerán desactivadas hasta que las renueves desde los ajustes de red"

#. Heading-like line in Settings > Notifications introducing the three radio choices for what to do when a chat server's push identity changes; the colon leads into the choices.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIntro"
msgid "When a server's push identity (its key) changes, this device's subscription for it stops working. Then:"
msgstr "Cuando el identificador de notificación de un servidor (su clave) cambia, la suscripción de este dispositivo para él deja de funcionar. Luego:"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: re-subscribe immediately and silently. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeTrust"
msgid "Naive — renew it on the spot, without asking"
msgstr "Naiivo — renueva la suscripción inmediatamente, sin preguntar"

#. Warning line in Settings > Notifications when the page is not served over a secure connection, which browsers require for notifications.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.noHttps"
msgid "Notifications are only supported over HTTPS connections."
msgstr "Las notificaciones solo se admiten mediante conexiones HTTPS."

#. Checkbox in Settings > Notifications; when ticked, every chat message notifies, not only mentions and highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.notifyAll"
msgid "Enable notification for all messages"
msgstr "Habilitar notificaciones para todos los mensajes"

#. Button in Settings > Notifications beside the notification-sound checkbox; clicking plays the notification sound once as a preview.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.playSound"
msgid "Play sound"
msgstr "Reproducir sonido"

#. Warning line in Settings > Notifications when the chat server refused the push subscription; SASL (the IRC login mechanism) stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushBlocked"
msgid "The server refused the push subscription. It may require logging in (SASL) before subscribing."
msgstr "El servidor rechazó la suscripción por push. Puede requerir iniciar sesión (SASL) antes de suscribirse."

#. Warning line in Settings > Notifications when notification permission was denied; points at the browser's site settings to re-enable.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushDenied"
msgid "Notifications are blocked by your browser. Allow them in the browser's site settings, then try again."
msgstr "Las notificaciones están bloqueadas por su navegador. Permítelas en los ajustes del sitio del navegador, luego intente de nuevo."

#. Heading of the push notification section in Settings > Notifications; push wakes the app on new messages while it is closed.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushHeading"
msgid "Push Notifications"
msgstr "Notificaciones por push"

#. Intro line of the push section in Settings > Notifications; explains that push is enabled per chat network from that network's edit form (the quoted phrase names that setting) and that each server decides whether to support it. Keep the curly quotes and the arrow.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushPerNetwork"
msgid "Push is set up per network — turn it on or off in each network's settings (Edit network → “Push notifications for this network”), where the enrollment status is also shown. The browser delivers the notifications; each push-capable server decides whether to wake this app."
msgstr "Las notificaciones por push están configuradas por red — active o desactive en los ajustes de cada red (Editar red → “Notificaciones por push para esta red”), donde también se muestra el estado de inscripción. El navegador entrega las notificaciones; cada servidor capaz de notificaciones decide si despierta esta aplicación."

#. Warning line in Settings > Notifications when the chat server itself does not offer web push; names the IRCv3 draft/webpush capability, which stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.serverUnsupported"
msgid "Push notifications need a connected server that supports the draft/webpush capability and you to be logged in to an account."
msgstr "Las notificaciones por push necesitan un servidor conectado que admita la capacidad draft/webpush y que"

#. Snooze button in Settings > Notifications; pauses push notifications for fifteen minutes.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snooze15"
msgid "15 min"
msgstr "15 minutos"

#. Snooze button in Settings > Notifications; pauses push notifications for eight hours.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snooze480"
msgid "8 hours"
msgstr "8 horas"

#. Snooze button in Settings > Notifications; pauses push notifications for one hour.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snooze60"
msgid "1 hour"
msgstr "1 hora"

#. Lead-in above the snooze buttons in Settings > Notifications, shown while push is enabled; the buttons pause push notifications for all networks. Keep the trailing colon.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snoozeIntro"
msgid "Snooze pushes everywhere:"
msgstr "Snooze envía a todas partes:"

#. Snooze button in Settings > Notifications; ends the pause and resumes push notifications immediately.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snoozeOff"
msgid "Off"
msgstr "Apagado"

#. Checkbox in Settings > Notifications; when ticked, a sound plays alongside a notification.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.sound"
msgid "Enable notification sound"
msgstr "Habilitar sonido de notificación"

#. Warning line in Settings > Notifications shown after a chat server changed its push identity; tells the reader to re-subscribe from that network's edit form, whose control is named in the quoted phrase.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.stale"
msgid "A server's push identity (its key) changed, so this device's push subscription for it no longer works. Renew it from that network's settings (Edit network → “Renew push notifications”) to keep being notified while the app is closed."
msgstr "El identidad de emisión de un servidor (su clave) ha cambiado, por lo que la suscripción de emisión de este dispositivo para él ya no funciona. Renuévelo desde los ajustes de esa red (Editar red → “Renovar notificaciones por emisión”) para seguir siendo notificado mientras el aplicación está cerrada."

#. Warning line in Settings > Notifications when the browser cannot do web push; the parentheses name the browser features push requires.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.unsupported"
msgid "Push notifications are not supported by this browser (they need the Push API, a service worker and a secure context)."
msgstr "Las notificaciones por emisión no se admiten en este navegador (necesitan el API de emisión, un trabajador de servicio y un contexto seguro)."

#. Word rendered bold at the start of several warning lines in Settings > Notifications (push and browser notification problems); a colon follows it.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.warning"
msgid "Warning"
msgstr "Advertencia"

#. Label of the Settings modal's Aliases tab (tab strip); switching tabs navigates to the Aliases settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.aliases"
msgid "Aliases"
msgstr "Alias"

#. Label of the Settings modal's Appearance tab (tab strip); switching tabs navigates to the Appearance settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.appearance"
msgid "Appearance"
msgstr "Apariencia"

#. aria-label of the row of tab buttons across the top of the settings window, used to switch between its pages.
#: client/components/Settings/Navigation.vue
msgctxt "settings.tabs.aria"
msgid "Settings tabs"
msgstr "pestañas de ajustes"

#. Label of the Settings modal's General tab (tab strip); switching tabs navigates to the General settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.general"
msgid "General"
msgstr ""

#. Label of the Settings modal's Networks tab (tab strip); switching tabs navigates to the Networks settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.networks"
msgid "Networks"
msgstr "Redes"

#. Label of the Settings modal's Notifications tab (tab strip); switching tabs navigates to the Notifications settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.notifications"
msgid "Notifications"
msgstr "Notificaciones"

#. Name of the Translation tab in the Settings tab strip: on-device translation of messages.
#: client/components/Settings/Navigation.vue
msgctxt "settings.tabs.translation"
msgid "Translation"
msgstr "Traducción"

#. Tooltip of the developer badge next to the sidebar logo, shown only in development builds; {app} is the app's display name.
#: client/components/Sidebar.vue:8
msgctxt "sidebar.devBuildTitle"
msgid "{app} has been built in development mode"
msgstr "{app} ha sido construido en modo de desarrollo"

#. Small orange badge next to the sidebar logo, shown only in development builds so a dev build is never mistaken for a deploy.
#: client/components/Sidebar.vue:16
msgctxt "sidebar.developerBadge"
msgid "DEVELOPER"
msgstr "DESARROLLADOR"

#. Message shown in the sidebar when there are no networks at all; the connect form is open beside it.
#: client/components/NetworkList.vue:8
msgctxt "sidebar.empty"
msgid "You are not connected to any networks yet."
msgstr "No estás conectado a ninguna red aún."

#. aria-label of the question-mark button in the sidebar footer: opens the help window.
#: client/components/Sidebar.vue:51
msgctxt "sidebar.help"
msgid "Help"
msgstr "Ayuda"

#. aria-label of the help button in the sidebar footer when a newer build is available; the parenthetical sits on its own line.
#: client/components/Sidebar.vue:50
msgctxt "sidebar.helpUpdate"
msgid "Help\n(update available)"
msgstr ""

#. Placeholder of the sidebar's jump-to search field that filters the channel list.
#: client/components/NetworkList.vue:17
msgctxt "sidebar.jumpTo"
msgid "Jump to..."
msgstr "Salta a..."

#. Tooltip and screen-reader label of the globe button beside the sidebar logo, which opens the language panel (the same selector the connect form and Settings → Appearance carry).
#: client/components/Sidebar.vue:8
msgctxt "sidebar.language"
msgid "Display language"
msgstr "Idioma de display"

#. Part of a sidebar channel row's aria-label and tooltip, after the channel name: how many messages highlight (mention) the user.
#: client/components/ChannelWrapper.vue:97
msgctxt "sidebar.mentions"
msgid "{count} mention"
msgid_plural "{count} mentions"
msgstr[0] "{count} mención"
msgstr[1] "{count} menciones"

#. aria-label of the sidebar's navigation region (the network/channel list).
#: client/components/NetworkList.vue:6
#: client/components/NetworkList.vue:10
msgctxt "sidebar.networkList"
msgid "Network and Channel list"
msgstr "Lista de red y canales"

#. Shown under the sidebar's jump-to search field when nothing matches.
#: client/components/NetworkList.vue:55
msgctxt "sidebar.noResults"
msgid "No results found."
msgstr "No se encontraron resultados."

#. Screen-reader-only label of the sidebar's jump-to search input (visually hidden).
#: client/components/NetworkList.vue:12
msgctxt "sidebar.searchLabel"
msgid "Search among the channel list"
msgstr "Buscar en la lista de canales"

#. aria-label of the gear button in the sidebar footer: opens the settings window.
#: client/components/Sidebar.vue:32
msgctxt "sidebar.settings"
msgid "Settings"
msgstr "Ajustes"

#. aria-label of the hamburger button that opens and closes the sidebar (channel list) on narrow screens.
#: client/components/SidebarToggle.vue:2
msgctxt "sidebar.toggle"
msgid "Toggle channel list"
msgstr "Alternar lista de canales"

#. Title and aria-label of the ladybird button in the sidebar, shown only in development builds: opens or closes the eruda in-page devtools.
#: client/components/Sidebar.vue:22
msgctxt "sidebar.toggleDevtools"
msgid "Toggle eruda devtools"
msgstr "Alternar herramientas de desarrollo de eruda"

#. Part of a sidebar channel row's aria-label and tooltip, after the channel name: how many unread messages it holds.
#: client/components/ChannelWrapper.vue:89
msgctxt "sidebar.unread"
msgid "{count} unread message"
msgid_plural "{count} unread messages"
msgstr[0] "{count} mensaje no leído"
msgstr[1] "{count} mensajes no leídos"

#. Column header of the channel-ban list: the banned hostmask, verbatim server data.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.banned"
msgid "Banned"
msgstr "Baneado"

#. Column header of the channel-ban list: when the ban was set, locale-formatted.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.bannedAt"
msgid "Banned At"
msgstr "Baneado el"

#. Column header of the channel-ban list: the operator who set the ban, verbatim.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.bannedBy"
msgid "Banned By"
msgstr "Baneado por"

#. Column header of the channel list: the channel name, verbatim server data.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.channel"
msgid "Channel"
msgstr "Canal"

#. Column header of the channel list: the channel's topic, verbatim server data.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.topic"
msgid "Topic"
msgstr "Tema"

#. Column header of the channel list: how many visible users the channel has.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.users"
msgid "Users"
msgstr "Usuarios"

#. Column header of the ban-exception list: the exempted hostmask, verbatim server data.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exempted"
msgid "Exempted"
msgstr "Excluido"

#. Column header of the ban-exception list: when the exception was set, locale-formatted.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exemptedAt"
msgid "Exempted At"
msgstr "Excluido el"

#. Column header of the ban-exception list: who set the exception, verbatim.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exemptedBy"
msgid "Exempted By"
msgstr "Excluido por"

#. Column header of the ignore list: the ignored hostmask, verbatim server data.
#: client/components/Special/ListIgnored.vue
msgctxt "special.ignored.hostmask"
msgid "Hostmask"
msgstr "máscara de host"

#. Column header of the ignore list: when the ignore was set, locale-formatted.
#: client/components/Special/ListIgnored.vue
msgctxt "special.ignored.ignoredAt"
msgid "Ignored At"
msgstr "Ignorado en"

#. Column header of the channel-invite list: the invited hostmask, verbatim server data.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invited"
msgid "Invited"
msgstr "Invitado"

#. Column header of the channel-invite list: when the invite was set, locale-formatted.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invitedAt"
msgid "Invited At"
msgstr "Invitado en"

#. Column header of the channel-invite list: who set the invite, verbatim.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invitedBy"
msgid "Invited By"
msgstr "Invitado por"

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_INVALID_TARGET). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.invalidTarget"
msgid "its lines did not all go to the same target."
msgstr "sus líneas no se dirigieron a un mismo destino."

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_MAX_BYTES without a limit named). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxBytes"
msgid "it was too long for one multi-line message."
msgstr "era demasiado largo para un mensaje multilínea."

#. Why fragment of 'Message not sent: {why}'; {limit} is the byte limit the server named.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxBytesLimit"
msgid "it was too long for one multi-line message (the server's limit is {limit} bytes)."
msgstr "era demasiado largo para un mensaje multilínea (el límite del servidor es {limit} bytes)."

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_MAX_LINES without a limit named). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxLines"
msgid "it had too many lines for one multi-line message."
msgstr "tenía demasiadas líneas para un mensaje multilínea."

#. Why fragment of 'Message not sent: {why}'; {limit} is the line limit the server named.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxLinesLimit"
msgid "it had too many lines for one multi-line message (the server's limit is {limit})."
msgstr "tenía demasiadas líneas para un mensaje multilínea (el límite del servidor es {limit})."

#. Why fragment of 'Message not sent: {why}' when the server's rejection named no cause. Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.rejected"
msgid "the server rejected the multi-line batch."
msgstr "el servidor rechazó el lote multilínea."

#. Channel error when the server threw away a whole multi-line message; {why} is one of the sr.multiline* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multilineNotSent"
msgid "Message not sent: {why}"
msgstr "Mensaje no enviado: {why}"

#. Channel error for a refused deletion (FAIL REDACT DISABLED); the server's own copy is replaced with this phrasing.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactDisabled"
msgid "Deleting messages is disabled on this server."
msgstr "Borrar mensajes está desactivado en este servidor."

#. Channel error when a message edit was dropped because its redaction was refused; {why} is one of the sr.redact* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactEditPrefix"
msgid "Edit not sent: {why}"
msgstr "Edición no enviada: {why}"

#. Channel error for a refused deletion (FAIL REDACT REDACT_FORBIDDEN).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactForbidden"
msgid "You are not allowed to delete that message."
msgstr "No estás autorizado para borrar ese mensaje."

#. Channel error for a refused deletion aimed at a non-channel (FAIL REDACT INVALID_TARGET).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactInvalidTarget"
msgid "Messages can only be deleted in channels."
msgstr "Los mensajes solo pueden borrarse en canales."

#. Channel error for a refused deletion; {why} is one of the sr.redact* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactPrefix"
msgid "Could not delete message: {why}"
msgstr "No se pudo borrar el mensaje: {why}"

#. Channel error for a deletion naming a message the server has forgotten (FAIL REDACT UNKNOWN_MSGID).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactUnknownMsgid"
msgid "The server no longer has that message."
msgstr "El servidor ya no tiene ese mensaje."

#. Channel error for a deletion past the server's edit window (FAIL REDACT REDACT_WINDOW_EXPIRED).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactWindowExpired"
msgid "That message is too old to delete."
msgstr "Ese mensaje es demasiado antiguo para borrar."

#. Title of the left action button on a push notification (shown on every platform): marks the conversation read on the server at this notification's newest message, which also closes the notification on the reader's other devices.
#: client/service-worker.js:1146
msgctxt "sw.markRead"
msgid "Mark read"
msgstr "Marcar como leído"

#. Body of the fallback notification shown when a push payload cannot be parsed into a conversation message, or the worker hit an error: something happened, but there is nothing to show. The title is the app name and is never translated.
#: client/service-worker.js:1194
#: client/service-worker.js:1212
msgctxt "sw.newActivity"
msgid "New activity while you were away."
msgstr "Actividad nueva mientras estabas fuera."

#. Body of a notification for a push payload that named no message text (a degraded opt-down tier): the conversation saw activity whose content was not delivered.
#: client/service-worker.js:992
msgctxt "sw.newMessage"
msgid "New message"
msgstr "Nuevo mensaje"

#. Title of the right action button on a push notification; where the platform has an inline reply field it opens that, else it opens the conversation. Kept last so a thumb lands on it.
#: client/service-worker.js:1150
msgctxt "sw.reply"
msgid "Reply"
msgstr "Respuesta"

#. Placeholder of the notification's inline reply text field (platforms that show one, e.g. desktop Chrome); what the reader types goes to the conversation as one IRC message.
#: client/service-worker.js:1151
msgctxt "sw.replyPlaceholder"
msgid "Reply…"
msgstr "Respuesta…"

#. Notification title for a message in a channel: {nick} is the sender's nickname, {target} the channel name. Translated as a whole so word order is free; the unread-count suffix is appended after it, never inside.
#: client/service-worker.js:1134
msgctxt "sw.titleChannel"
msgid "{nick} in {target}"
msgstr "{nick} en {target}"

#. Push-notification title for a channel conversation carrying more than one unread message. {nick} is the nick of the newest message's author and {target} is the channel name — both verbatim, never translate them; {count} is the number of unread messages the notification carries.
#: client/service-worker.js:1137
msgctxt "sw.titleChannelCount"
msgid "{nick} in {target} ({count})"
msgstr "{nick} en {target} ({count})"

#. Push-notification title for a query (direct-message) conversation carrying more than one unread message. {nick} is the other side's nick, verbatim — never translate it; {count} is the number of unread messages.
#: client/service-worker.js:1141
msgctxt "sw.titleNickCount"
msgid "{nick} ({count})"
msgstr "{nick} ({count})"

#. System line when a user is marked away. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element. The away reason (user-set, verbatim) follows in parentheses.
#: client/components/MessageTypes/away.vue:10
msgctxt "system.away"
msgid "{nick} is away"
msgstr "{nick} está de viaje"

#. System line when a user returns from away. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element.
#: client/components/MessageTypes/back.vue:10
msgctxt "system.back"
msgid "{nick} is back"
msgstr "{nick} está de regreso"

#. System line tail case: a user's username/hostname changed but neither value arrived (degenerate). {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:4
msgctxt "system.chghost"
msgid "{nick} has changed"
msgstr "{nick} ha cambiado"

#. System line when a user's username AND hostname change together. {nick} and {ident} are VERBATIM user content; {host} is a verbatim technical value; {nick} renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:12
msgctxt "system.chghostBoth"
msgid "{nick} has changed username to {ident} and hostname to {host}"
msgstr "{nick} ha cambiado su nombre de usuario a {ident} y su nombre de host a {host}"

#. System line when a user's hostname changes. {nick} is the user's nick (VERBATIM, renders as the interactive username element) and {host} the new hostname (verbatim technical value).
#: client/components/MessageTypes/chghost.vue:9
msgctxt "system.chghostHost"
msgid "{nick} has changed hostname to {host}"
msgstr "{nick} ha cambiado su nombre de host a {host}"

#. System line when a user's username (ident) changes. {nick} is the user's nick and {ident} the new username — both VERBATIM, never translate; {nick} renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:6
msgctxt "system.chghostIdent"
msgid "{nick} has changed username to {ident}"
msgstr "{nick} ha cambiado su nombre de usuario a {ident}"

#. System line for an incoming CTCP request. {nick} is the sender's nick (VERBATIM user content, renders as the interactive username element); {ctcp} is the fixed abbreviation CTCP (never translate); {message} is the verbatim CTCP payload.
#: client/components/MessageTypes/ctcp_request.vue:5
msgctxt "system.ctcpRequest"
msgid "{nick} sent a {ctcp} request: {message}"
msgstr "{nick} ha enviado una solicitud de {ctcp}: {message}"

#. System line when a user invites someone else. {nick} is the inviter's nick and {target} the invited user's nick — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands; {channel} is the channel name (verbatim).
#: client/components/MessageTypes/invite.vue:9
msgctxt "system.inviteTarget"
msgid "{nick} has invited {target} to {channel}"
msgstr "{nick} ha invitado a {target} a {channel}"

#. System line when the invite targets the reader. {nick} is the inviter's nick (VERBATIM user content, renders as the interactive username element) and {channel} the channel name (verbatim).
#: client/components/MessageTypes/invite.vue:7
msgctxt "system.inviteYou"
msgid "{nick} has invited you to {channel}"
msgstr "{nick} ha invitado a usted a {channel}"

#. System line when a user joins a channel. {nick} is the joining user's nick, VERBATIM user content — never translate or inflect it; it renders as the interactive username element inline where the placeholder stands, so word order around it is the translator's.
#: client/components/MessageTypes/join.vue:8
msgctxt "system.join"
msgid "{nick} has joined the channel"
msgstr "{nick} ha entrado al canal"

#. System line when a user is kicked from a channel. {nick} is the kicker's nick and {target} the kicked user's nick — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands.
#: client/components/MessageTypes/kick.vue:6
msgctxt "system.kick"
msgid "{nick} has kicked {target}"
msgstr "{nick} ha expulsado a {target}"

#. System line when a channel or user mode changes. {nick} is the nick that set the mode, VERBATIM user content; {modes} is the verbatim mode change (e.g. +o nick), rendered as-is.
#: client/components/MessageTypes/mode.vue:6
msgctxt "system.mode"
msgid "{nick} sets mode {modes}"
msgstr "{nick} establece el modo {modes}"

#. System line when a user changes nick. {nick} is the old nick and {newNick} the new one — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands.
#: client/components/MessageTypes/nick.vue:6
msgctxt "system.nick"
msgid "{nick} is now known as {newNick}"
msgstr "{nick} ahora se conoce como {newNick}"

#. System line when a user parts a channel. {nick} is the parting user's nick, VERBATIM user content — never translate or inflect it; it renders as the interactive username element.
#: client/components/MessageTypes/part.vue:6
msgctxt "system.part"
msgid "{nick} has left the channel"
msgstr "{nick} ha dejado el canal"

#. System line when a user disconnects from the network. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element. The quit reason (user-set, verbatim) follows the sentence in parentheses.
#: client/components/MessageTypes/quit.vue:6
msgctxt "system.quit"
msgid "{nick} has quit"
msgstr "{nick} ha dejado"

#. Reason given when pending token requests (upload tokens) are dropped because the connection closed; shown inside the upload error notice.
#: client/js/irc/authtoken.ts
msgctxt "token.disconnected"
msgid "Disconnected"
msgstr "Desconectado"

#. Reason given when the server answered a TOKEN GENERATE request with a FAIL that carried no text; shown inside the upload error notice. {code} is the server's error code, verbatim.
#: client/js/irc/authtoken.ts
msgctxt "token.failed"
msgid "Token request failed ({code})"
msgstr "Solicitud de token fallida ({code})"

#. Reason given when a TOKEN GENERATE request (an upload token from the network's own file host) got no answer in time; shown inside the upload error notice.
#: client/js/irc/authtoken.ts
msgctxt "token.timeout"
msgid "The server did not answer the token request"
msgstr "El servidor no respondió a la solicitud de token"

#. Tooltip and aria-label of the translate button in a message's hover toolbar when the message's translation was hidden; it brings it back.
#: client/components/MessageActions.vue
msgctxt "translate.action.showTranslation"
msgid "Show translation"
msgstr "Mostrar traducción"

#. Tooltip and aria-label of the translate button in a message's hover toolbar: it translates that one message.
#: client/components/MessageActions.vue
msgctxt "translate.action.translate"
msgid "Translate"
msgstr "Traducir"

#. Verdict of the device check in Settings → Translation: the large graphics-processor model cannot run, the smaller main-processor ones can. Any reasons follow as their own list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.cpu"
msgid "The GPU model is unavailable here; the CPU models still work."
msgstr "El modelo de GPU no está disponible aquí; los modelos de CPU aún funcionan."

#. Verdict of the device check in Settings → Translation: the graphics processor is good enough for the large model. GPU is the usual abbreviation for the graphics processor.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.gpu"
msgid "This device can run the GPU model."
msgstr "Este dispositivo puede ejecutar el modelo de GPU."

#. Verdict of the device check in Settings → Translation: no model can run at all. Any reasons follow as their own list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.none"
msgid "Translation cannot run on this device."
msgstr "La traducción no puede ejecutarse en este dispositivo."

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the page is not served securely. WebGPU, HTTPS and localhost are technical names.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.insecureOrigin"
msgid "insecure origin: WebGPU needs HTTPS or localhost — serve the app over HTTPS"
msgstr "origen inseguro: WebGPU necesita HTTPS o localhost — sirva la aplicación mediante HTTPS"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the browser has WebGPU but gave out no device. WebGPU is a web standard's name.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noAdapter"
msgid "WebGPU adapter unavailable"
msgstr "adaptador WebGPU no disponible"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the graphics hardware lacks half-precision arithmetic.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noF16"
msgid "no 16-bit float shaders"
msgstr "no hay shaders de float de 16 bits"

#. One reason no model can run, listed under the device verdict in Settings → Translation: the browser lacks the WebAssembly SIMD instructions. Both are technical names.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noWasmSimd"
msgid "no WebAssembly SIMD"
msgstr "no hay WebAssembly SIMD"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the browser offers no WebGPU. WebGPU is a web standard's name.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noWebgpu"
msgid "no WebGPU"
msgstr ""

#. One reason listed under the device verdict in Settings → Translation: the check of what the device can do threw an error, so nothing could be measured.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.probeFailed"
msgid "the device check itself failed"
msgstr "el propio comprobación del dispositivo falló"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: too little addressable graphics memory. GiB is the binary gigabyte symbol and stays as it is.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.smallBuffer"
msgid "GPU buffer limit under 1 GiB"
msgstr "límite de búfer de GPU inferior a 1 GiB"

#. Tooltip and aria-label of a translation line's chip, skipped because the line is already in the reading language. {language} is its name in the reading language.
#: client/components/TranslationLine.vue
msgctxt "translate.chip.alreadyIn"
msgid "Already in {language}, not translated. Translation options"
msgstr "Ya en {language}, no traducido. Opciones de traducción"

#. Tooltip and aria-label of a translation line's chip: the languages it names, then the standard suffix.
#: client/components/TranslationLine.vue
msgctxt "translate.chip.options"
msgid "{languages}. Translation options"
msgstr "{languages}. Opciones de traducción"

#. Tooltip and aria-label of a translation line's chip, skipped because the detector could not tell the language apart.
#: client/components/TranslationLine.vue
msgctxt "translate.chip.unsure"
msgid "Language not told apart, not translated. Translation options"
msgstr "El lenguaje no se distingue, no se traduce. Opciones de traducción"

#. Placeholder of the message composer in a channel or private conversation whose outgoing messages are translated. {name} is the channel or nickname; {language} is the language messages are sent in.
#: client/components/ChatInput.vue
msgctxt "translate.composer.placeholder"
msgid "Write to {name} · sent in {language}"
msgstr "Escribir a {name} · enviado en {language}"

#. Why a translation failed, shown after 'Couldn't translate': the request was cancelled before it finished. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.aborted"
msgid "aborted"
msgstr "abortado"

#. Why a translation failed, shown after 'Couldn't translate': the engine did not answer in time. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.timedOut"
msgid "timed out"
msgstr "tiempo agotado"

#. Why a translation failed, shown after 'Couldn't translate': no model on this device can handle that pair of languages. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.unavailable"
msgid "no translation engine can take this request"
msgstr "ningún motor de traducción puede tomar este pedido"

#. Why a translation failed, shown after 'Couldn't translate': no model on this device can handle that pair of languages. {detail} is the library's own untranslated error text. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.unavailableDetail"
msgid "no translation engine can take this request: {detail}"
msgstr "ningún motor de traducción puede tomar este pedido: {detail}"

#. Why a translation failed, shown after 'Couldn't translate': the background process doing the translating was shut down. Lowercase: it follows a colon or a dash.
#: client/js/helpers/translateErrors.ts
msgctxt "translate.error.workerDisposed"
msgid "translation worker disposed"
msgstr "trabajador de traducción eliminado"

#. Text in front of the failure reason on a message whose translation failed (with a retry button beside it).
#: client/components/TranslationLine.vue
msgctxt "translate.failed"
msgid "Couldn't translate"
msgstr "no se pudo traducir"

#. Choice for how formally a translation addresses people: keep whatever the original message did.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.auto"
msgid "As the original does"
msgstr "como el original"

#. The same choice as translate.formality.auto, shortened for the narrow segmented control on a phone: keep whatever the original message did.
#: client/components/TranslationPanel.vue
msgctxt "translate.formality.autoShort"
msgid "As written"
msgstr "como está escrito"

#. Choice for how formally a translation addresses people: always use the familiar form.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.casual"
msgid "Casually"
msgstr "de manera casual"

#. Choice for how formally a translation addresses people: always use the polite form.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.formal"
msgid "Formally"
msgstr "de manera formal"

#. Label of the control that chooses how formally the translation addresses people, in the translation panel and in Settings.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.formality.label"
msgid "Address people"
msgstr "dirigirse a las personas"

#. Tooltip of the translate button in a chat window's header while translation is off; clicking it turns reading on. {reading} is a language name.
#: client/components/Chat.vue
msgctxt "translate.header.off"
msgid "Translate messages into {reading}"
msgstr "traducir mensajes a {reading}"

#. Tooltip of the translate button in a chat window's header when translation is off and the engine has paused. {reading} is a language name; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.offPaused"
msgid "Translate messages into {reading}, paused: {reason}"
msgstr "traducir mensajes a {reading}, pausado: {reason}"

#. Tooltip of the translate button in a chat window's header while incoming messages are not translated but outgoing ones are. {reading} and {writing} are language names.
#: client/components/Chat.vue
msgctxt "translate.header.offWrite"
msgid "Translate messages into {reading}, sending in {writing}"
msgstr "traducir mensajes a {reading}, enviando en {writing}"

#. Tooltip of the translate button in a chat window's header when only outgoing messages are translated and the engine has paused. {reading} and {writing} are language names; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.offWritePaused"
msgid "Translate messages into {reading}, sending in {writing}, paused: {reason}"
msgstr "traducir mensajes a {reading}, enviando en {writing}, pausado: {reason}"

#. Tooltip of the translate button in a chat window's header while incoming messages are being translated. {reading} is a language name.
#: client/components/Chat.vue
msgctxt "translate.header.read"
msgid "Translating into {reading}"
msgstr "traduciendo a {reading}"

#. Tooltip of the translate button in a chat window's header when translation is on but the engine has paused. {reading} is a language name; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.readPaused"
msgid "Translating into {reading}, paused: {reason}"
msgstr "traduciendo a {reading}, pausado: {reason}"

#. Tooltip of the translate button in a chat window's header while incoming messages are translated and outgoing ones are too. {reading} and {writing} are language names.
#: client/components/Chat.vue
msgctxt "translate.header.readWrite"
msgid "Translating into {reading}, sending in {writing}"
msgstr "traduciendo a {reading}, enviando en {writing}"

#. Tooltip of the translate button in a chat window's header when reading and writing are both translated but the engine has paused. {reading} and {writing} are language names; {reason} is the engine's own untranslated message.
#: client/components/Chat.vue
msgctxt "translate.header.readWritePaused"
msgid "Translating into {reading}, sending in {writing}, paused: {reason}"
msgstr "traduciendo a {reading}, enviando en {writing}, pausado: {reason}"

#. Tooltip and aria-label of the translate button in a chat window's header on a touch device, where tapping it opens the translation panel.
#: client/components/Chat.vue
msgctxt "translate.header.settings"
msgid "Translation settings"
msgstr "Configuración de traducción"

#. Warning shown under a language choice, in the translation panel and in Settings, when the available models translate that language poorly.
#: client/components/TranslationPanel.vue
#: client/components/Settings/Translation.vue
msgctxt "translate.limitedLanguage"
msgid "Translations into and out of this language are often wrong."
msgstr "Las traducciones a y desde este idioma a menudo son incorrectas."

#. Note shown in the composer's translation strip or under a message while the model it needs is being fetched for the first time. {model} is the model's name, {percent} a number from 0 to 100.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.load.downloading"
msgid "Downloading {model}… {percent}%"
msgstr "Descargando {model}… {percent}%"

#. Note shown in the composer's translation strip or under a message while a model already on the device is being loaded back into memory. {model} is the model's name, {percent} a number from 0 to 100.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.load.loading"
msgid "Loading {model} into memory… {percent}%"
msgstr "Cargando {model} en memoria… {percent}%"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.copy"
msgid "Copy translation"
msgstr "Copiar traducción"

#. Item in a channel's context menu in the sidebar; it opens that channel's translation panel.
#: client/js/helpers/contextMenu.ts
msgctxt "translate.menu.panel"
msgid "Translation…"
msgstr "Traducción…"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.retranslate"
msgid "Retranslate"
msgstr "Retraducir"

#. A translation chip's menu item. {language} is the language's name in the reading language.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.retranslateFrom"
msgid "Retranslate from: {language}"
msgstr "Retraducir desde: {language}"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.retranslateFromPicker"
msgid "Retranslate from…"
msgstr "Retraducir desde…"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.showOriginal"
msgid "Show original only"
msgstr "Mostrar solo el original"

#. A translation chip's menu item.
#: client/components/TranslationLine.vue
msgctxt "translate.menu.translateAnyway"
msgid "Translate anyway"
msgstr "Traducir de todos modos"

#. Button on a model row in Settings → Translation that removes the downloaded model from this device.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.delete"
msgid "Delete"
msgstr "Borrar"

#. Button on a model row in Settings → Translation that fetches the model onto this device.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.download"
msgid "Download"
msgstr "Descargar"

#. State of a model row in Settings → Translation: the model is on this device.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.downloaded"
msgid "Downloaded"
msgstr "Descargado"

#. State of a model row in Settings → Translation after a download failed. {error} is the library's own untranslated message.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.failed"
msgid "Failed: {error}"
msgstr "Fallo: {error}"

#. State of a model row in Settings → Translation after a download failed with no message of its own.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.failedUnknown"
msgid "Failed: unknown error"
msgstr "Fallo: error desconocido"

#. The name of a translation model in Settings → Translation: a large language model that runs on the graphics processor. {name} is the model's product name, never translated; GPU is the usual abbreviation for the graphics processor.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.model.llm"
msgid "{name} (GPU, all languages)"
msgstr "{name} (GPU, todos los idiomas)"

#. State of a model row in Settings → Translation: it is already on the device and is being loaded into memory. {percent} is a number from 0 to 100.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.loadingPercent"
msgid "Loading… {percent}%"
msgstr "Cargando… {percent}%"

#. The name of a translation model in Settings → Translation. NLLB-200 600M is a product name; CPU is the usual abbreviation for the main processor; it covers 200 languages.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.model.nllb"
msgid "NLLB-200 600M (CPU, 200 languages)"
msgstr "NLLB-200 600M (CPU, 200 idiomas)"

#. State of a model row in Settings → Translation: the model is not on this device yet.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.notDownloaded"
msgid "Not downloaded"
msgstr "No descargado"

#. The name of a translation model in Settings → Translation: an OPUS-MT pair that runs on the main processor. {from} and {to} are language names. OPUS-MT is a product name and CPU is the usual abbreviation for the main processor.
#: client/js/helpers/modelLabel.ts
msgctxt "translate.model.opus"
msgid "OPUS-MT {from} → {to} (CPU)"
msgstr "OPUS-MT {from} → {to} (CPU)"

#. State of a model row in Settings → Translation while it downloads: how far it has got. {percent} is a number from 0 to 100.
#: client/components/Settings/Translation.vue
msgctxt "translate.model.percent"
msgid "{percent}%"
msgstr "{percent}%"

#. Label of the compact equals-icon chip shown in place of a translation that failed because the engine returned the source line as its own answer. Also the chip's tooltip and aria-label; the reason text beside it only appears in development builds.
#: client/components/TranslationLine.vue
msgctxt "translate.notTranslated"
msgid "Not translated"
msgstr "No traducido"

#. The placeholder option of the picker that adds a language to the list of languages spoken in this conversation, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.addLanguage"
msgid "Add a language…"
msgstr "Añadir un idioma…"

#. Tooltip and aria-label of the ✕ button that closes the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.close"
msgid "Close"
msgstr "Cerrar"

#. Heading of the translation panel, a dialog of translation settings for one conversation; the conversation's name is shown next to it.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.heading"
msgid "Translation"
msgstr "Traducción"

#. Explanatory note under the list of languages spoken in this conversation, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.languagesHint"
msgid "Lines in these languages are recognised even when they are short or look alike."
msgstr "Las líneas en estos idiomas se reconocen incluso cuando son cortas o parecen iguales."

#. The off choice: the segmented switch for translating incoming messages, and the first option of the 'send my messages in' picker, both in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.off"
msgid "Off"
msgstr "Apagado"

#. The on choice of the segmented switch for translating incoming messages, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.on"
msgid "On"
msgstr "Encendido"

#. Explanatory note under the reading switch in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.readHint"
msgid "Lines others send are shown with a translation underneath."
msgstr "Las líneas que otros envían se muestran con una traducción debajo."

#. Label of the on/off switch for translating incoming messages in the translation panel. {language} is the language name they would be translated into.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.readIn"
msgid "Read messages in {language}"
msgstr "Leer mensajes en {language}"

#. Heading of the translation panel's section about incoming messages, and the label of the on/off control in it.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.reading"
msgid "Reading"
msgstr "Leyendo"

#. Link at the foot of the translation panel; it opens the application's Translation settings page.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.settingsLink"
msgid "Language and models in Settings"
msgstr "Idioma y modelos en Configuración"

#. aria-label of the translation panel, a dialog of translation settings for one conversation. {channel} is the channel name or nickname.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.title"
msgid "Translation for {channel}"
msgstr "Traducción para {channel}"

#. Label of the free-text field naming a regional variety of the target language, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.variant"
msgid "Variant"
msgstr "Variente"

#. Explanatory note under the regional variety field in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.variantHint"
msgid "A regional flavour the model should aim for."
msgstr "Un tono regional que el modelo debería intentar."

#. Placeholder of the free-text field naming a regional variety of the target language, in the translation panel. Replace the example with one that suits the target language.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.variantPlaceholder"
msgid "e.g. Brazilian Portuguese"
msgstr "Por ejemplo: portugués brasileño"

#. Explanatory note under the 'send my messages in' picker in the translation panel. Enter is the keyboard key of that name.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.writeHint"
msgid "Enter shows the translation first; Enter again sends it."
msgstr "Entrar muestra la traducción primero; volver a pulsar envía."

#. Label of the picker that chooses the language the user's own messages are translated into before sending, in the translation panel.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.writeLabel"
msgid "Send my messages in"
msgstr "Enviar mis mensajes en"

#. Heading of the translation panel's section about the messages the user sends.
#: client/components/TranslationPanel.vue
msgctxt "translate.panel.writing"
msgid "Writing"
msgstr "Escribiendo"

#. Button that closes the retranslate-from dialog without doing anything.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.cancel"
msgid "Cancel"
msgstr "Cancelar"

#. Button that translates the message again from the language picked in the retranslate-from dialog.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.confirm"
msgid "Translate"
msgstr "Traducir"

#. aria-label of the small dialog that translates one message again from a language the user picks.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.dialog"
msgid "Retranslate from another language"
msgstr "Traducir de otro idioma"

#. Label of the language picker in the dialog that translates one message again from a language the user picks.
#: client/components/SourceLanguagePicker.vue
msgctxt "translate.picker.label"
msgid "Translate this line from"
msgstr "Traduce esta línea desde"

#. Failure reason after 'Couldn't translate': the model replied to a question it found in the message rather than translating the message. Lowercase; reads as the tail of that sentence.
#: client/components/TranslationLine.vue
msgctxt "translate.reason.answered"
msgid "answered the question instead of translating it"
msgstr "Respondió a la pregunta en lugar de traducirla"

#. Failure reason after 'Couldn't translate': the model returned runs of symbols or punctuation with no usable words. Lowercase; reads as the tail of that sentence.
#: client/components/TranslationLine.vue
msgctxt "translate.reason.degenerate"
msgid "the answer was symbol garbage"
msgstr "La respuesta era basura simbólica"

#. Failure reason after 'Couldn't translate': the model replied to the message's request (acknowledging it, describing what it would do) rather than translating the message. Lowercase; reads as the tail of that sentence.
#: client/components/TranslationLine.vue
msgctxt "translate.reason.narration"
msgid "talked about the request instead of translating"
msgstr "Habló sobre la solicitud en lugar de traducirla"

#. Tooltip and aria-label of the circular-arrow button that retries a failed translation.
#: client/components/TranslationLine.vue
msgctxt "translate.retry"
msgid "Retry the translation"
msgstr "Reintentar la traducción"

#. Shown in place of the Translation settings when the site's operator has disabled the feature.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.disabled"
msgid "Translation is turned off in this deployment."
msgstr "La traducción está desactivada en esta implementación."

#. The first option of the GPU model picker in Settings → Translation: the client picks the largest model the device can run.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuAutomatic"
msgid "Automatic — best for this device"
msgstr "Automático — mejor para este dispositivo"

#. Label of the picker in Settings → Translation that chooses which large graphics-processor model to use. GPU is the usual abbreviation for the graphics processor.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuModel"
msgid "GPU model"
msgstr "Modelo de GPU"

#. Explanatory note under the GPU model picker in Settings → Translation.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.gpuModelHint"
msgid "The larger model translates more naturally, needs about 3.4 GB of graphics memory and is slower."
msgstr "El modelo más grande traduce de manera más natural, necesita aproximadamente 3,4 GB de memoria gráfica y es más lento."

#. Heading of the Translation tab in Settings.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.heading"
msgid "Translation"
msgstr "Traducir"

#. Badge next to the model row in Settings → Translation that the GPU model picker currently selects.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.inUse"
msgid "In use"
msgstr "En uso"

#. Introductory paragraph of the Translation tab in Settings, explaining that translation runs locally.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.intro"
msgid "Messages are translated on this device by a model it downloads once; nothing is sent to a translation service. Turn it on per channel from the translate button in the channel header."
msgstr "Los mensajes se traducen en este dispositivo mediante un modelo que descarga una vez; nada se envía a un servicio de traducción. Actívalo por canal desde el botón de traducción en el encabezado del canal."

#. Explanatory note under the language picker in Settings → Translation.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.languageHint"
msgid "The language the interface is written in and messages are translated into — one control. Automatic follows your browser's language."
msgstr "El idioma en el que está escrita la interfaz y en el que se traducen los mensajes — un control. Automático sigue el idioma del navegador."

#. Label of the picker in Settings → Translation that chooses one language for both the interface and the translations of incoming messages.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.languageLabel"
msgid "Interface and reading language"
msgstr "Idioma de la interfaz y de lectura"

#. One option of the GPU model picker in Settings → Translation. {name} is the model's product name, {size} its download size.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.modelOption"
msgid "{name} · {size}"
msgstr "{name} · {size}"

#. Heading of the section of Settings → Translation that lists the translation models and lets them be downloaded or deleted.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.models"
msgid "Models"
msgstr "Modelos"

#. Label of the checkbox in Settings → Translation that allows the smaller main-processor models. CPU is the usual abbreviation for the main processor.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.useCpu"
msgid "Use the CPU models where they are the better choice"
msgstr "Use los modelos de CPU donde son la mejor opción"

#. Label of the checkbox in Settings → Translation that allows the large graphics-processor model. GPU is the usual abbreviation for the graphics processor.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.useGpu"
msgid "Use the GPU model where it is the better choice"
msgstr "Usa el modelo de GPU donde es la mejor opción"

#. Error shown in Settings → Translation when the background process that does the translating could not be reached. {error} is its own untranslated message.
#: client/components/Settings/Translation.vue
msgctxt "translate.settings.workerError"
msgid "Could not reach the translation worker: {error}"
msgstr "No se pudo alcanzar al worker de traducción: {error}"

#. Text of the second row of the composer's translation strip when translating the translation back into the user's own language failed.
#: client/components/ChatInput.vue
msgctxt "translate.strip.checkFailed"
msgid "couldn't check"
msgstr "No se pudo verificar"

#. Tooltip and aria-label of the copy button in the composer's translation strip, for two seconds after the translation was put on the clipboard.
#: client/components/ChatInput.vue
msgctxt "translate.strip.copied"
msgid "Copied"
msgstr "Copiado"

#. Tooltip and aria-label of the copy button in the composer's translation strip; it puts the translated text on the clipboard.
#: client/components/ChatInput.vue
msgctxt "translate.strip.copy"
msgid "Copy the translation"
msgstr "Copia la traducción"

#. Text of the strip above the message composer when the outgoing translation failed; the user can press Enter again to send the message as they wrote it.
#: client/components/ChatInput.vue
msgctxt "translate.strip.failed"
msgid "couldn't translate, send as written?"
msgstr "No se pudo traducir, envíalo como está?"

#. Tooltip and aria-label of the button in the composer's translation strip that dismisses the translation and returns to the draft. Escape is the keyboard key of the same name.
#: client/components/ChatInput.vue
msgctxt "translate.strip.keepTyping"
msgid "Keep typing (Escape)"
msgstr "Continúa escribiendo (Escape)"

#. Tooltip of the composer translation strip's direction chip, naming the route a translation took. {from} and {to} are language names (or the word from translate.strip.sourceAuto), {model} is the model's technical id. This one ran on the main processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeCpu"
msgid "{from} → {to} · {model} (CPU)"
msgstr "{from} → {to} · {model} (CPU)"

#. Tooltip of the composer translation strip's direction chip when the first attempt was tried again with no source language named. {from} and {to} are language names, {model} is the model's technical id. This one ran on the main processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeCpuRetried"
msgid "{from} → {to} · {model} (CPU) · retried without a source"
msgstr "{from} → {to} · {model} (CPU) · se intentó nuevamente sin fuente"

#. Tooltip of the composer translation strip's direction chip, naming the route a translation took. {from} and {to} are language names (or the word from translate.strip.sourceAuto), {model} is the model's technical id. This one ran on the graphics processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeGpu"
msgid "{from} → {to} · {model} (GPU)"
msgstr "{from} → {to} · {model} (GPU)"

#. Tooltip of the composer translation strip's direction chip when the first attempt was tried again with no source language named. {from} and {to} are language names, {model} is the model's technical id. This one ran on the graphics processor.
#: client/components/ChatInput.vue
msgctxt "translate.strip.routeGpuRetried"
msgid "{from} → {to} · {model} (GPU) · retried without a source"
msgstr "{from} → {to} · {model} (GPU) · se intentó nuevamente sin fuente"

#. Tooltip and aria-label of the send button in the composer's translation strip after the translation failed: the message goes out in the language the user typed it in.
#: client/components/ChatInput.vue
msgctxt "translate.strip.sendAsWritten"
msgid "Send as written"
msgstr "Envíalo como está"

#. Tooltip and aria-label of the send button in the composer's translation strip: the translated text is what gets sent.
#: client/components/ChatInput.vue
msgctxt "translate.strip.sendTranslation"
msgid "Send the translation"
msgstr "Envía la traducción"

#. Stands in for the source language in the composer translation strip's route tooltip when no source was named and the model was left to work it out. Substituted as {from} in translate.strip.routeGpu and its siblings.
#: client/components/ChatInput.vue
msgctxt "translate.strip.sourceAuto"
msgid "auto"
msgstr "automático"

#. Failure reason shown inside the Not-translated chip in development builds only: the model returned the source line as its own translation, so there is nothing to show. Lowercase; it reads as the reason the chip stands for.
#: client/components/TranslationLine.vue
msgctxt "translate.unchangedReason"
msgid "the line came back unchanged"
msgstr "La línea regresó igual"

#. Translation panel, channel languages field. {channel} is the channel's name (#seance).
#: client/components/TranslationPanel.vue
msgctxt "translation.panel.languages"
msgid "Languages: {channel}"
msgstr "Idiomas: {channel}"

#. Translation panel, a language chip's remove button. {language} is the language's name in the interface language.
#: client/components/TranslationPanel.vue
msgctxt "translation.panel.remove"
msgid "Remove {language}"
msgstr "Elimina {language}"

#. Line above the message input naming the two longest-typing users and summarizing everyone else. {nick1} and {nick2} are those users' names; {count} is how many further users are typing. The singular form shows when one further user is meant, the plural for any other number.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.many"
msgid "{nick1}, {nick2} and {count} other is typing…"
msgid_plural "{nick1}, {nick2} and {count} others are typing…"
msgstr[0] "{nick1}, {nick2} y {count} otros están escribiendo…"
msgstr[1] "{nick1}, {nick2} y {count}, otros están escribiendo…"

#. Line above the message input saying that one user is writing a message right now. {nick} is that user's name.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.one"
msgid "{nick} is typing…"
msgstr "{nick} está escribiendo…"

#. Line above the message input saying that three users are writing messages right now. {nick1}, {nick2} and {nick3} are their names, in the order they started typing.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.three"
msgid "{nick1}, {nick2} and {nick3} are typing…"
msgstr "{nick1}, {nick2} y {nick3} están escribiendo…"

#. Line above the message input saying that two users are writing messages right now. {nick1} and {nick2} are their names, in the order they started typing.
#: client/components/TypingIndicator.vue:31
msgctxt "typing.two"
msgid "{nick1} and {nick2} are typing…"
msgstr "{nick1} y {nick2} están escribiendo…"

#. Error notice when the file's type is not on the uploader's accepted list. {file} is the file's name — user content, never translated; {types} is the accepted-type list from the deploy's config, kept verbatim.
#: client/js/upload.ts:788
msgctxt "upload.badType"
msgid "File {file} is not a type this uploader accepts ({types})"
msgstr "El archivo {file} no es un tipo que este uploader acepta ({types})"

#. Button of the upload confirmation dialog; clicking cancels the whole upload and sends nothing.
#: client/components/UploadPreview.vue
msgctxt "upload.cancel"
msgid "Cancel"
msgstr "Cancelar"

#. Notice when an upload in flight was cancelled before it finished.
#: client/js/upload.ts:460
msgctxt "upload.cancelled"
msgid "Upload cancelled"
msgstr "Subida cancelada"

#. Intro line of the upload confirmation dialog; asks the user to check the files and warns that every uploaded file is reachable through its link.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmHint"
msgid "Check that this is what you meant to share, then upload. Anyone who can open the link will be able to see it."
msgstr "Comprueba que es lo que quieres compartir, luego sube. Quien pueda abrir el enlace podrá verlo."

#. Confirmation button of the upload dialog when several files are queued; clicking sends them all to the chat server.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmMany"
msgid "Upload {count} files"
msgstr "Subir {count} archivos"

#. Confirmation button of the upload confirmation dialog when one file is queued; clicking sends it to the chat server.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmOne"
msgid "Upload"
msgstr "Subir"

#. Title of the confirmation dialog shown before files are uploaded to the chat server, when several files were chosen.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmTitleMany"
msgid "Upload these files?"
msgstr "Subir estos archivos?"

#. Title of the confirmation dialog shown before files are uploaded to the chat server, when one file was chosen.
#: client/components/UploadPreview.vue
msgctxt "upload.confirmTitleOne"
msgid "Upload this file?"
msgstr "Subir este archivo?"

#. Error notice when the user tries to send a file while the network is disconnected. Shown in the error strip above the message input.
#: client/js/upload.ts:765
msgctxt "upload.disconnected"
msgid "You are currently disconnected, unable to initiate upload process."
msgstr "Estás actualmente desconectado, no puedes iniciar el proceso de subida."

#. Frame for a failed upload; the underlying reason follows the colon. {reason} is the browser's or endpoint's own message, kept verbatim — its content is not our copy.
#: client/js/upload.ts:464
msgctxt "upload.failed"
msgid "Upload failed: {reason}"
msgstr "Subida fallida: {reason}"

#. Frame for a failed upload when the endpoint answered with an error status and no readable message. {status} is the numeric HTTP status code.
#: client/js/upload.ts:476
msgctxt "upload.failedHttp"
msgid "Upload failed: HTTP {status}"
msgstr "Subida fallida: HTTP {status}"

#. Error notice when the upload endpoint answered but its reply lacks the expected URL field. {field} is the response path named in the deploy's config (technical, never translated).
#: client/js/upload.ts:353
msgctxt "upload.missingField"
msgid "Upload failed: the uploader did not return a \"{field}\" URL"
msgstr "Subida fallida: el uploader no devolvió una URL \"{field}\""

#. Error notice when the browser offers no way to send a request, so the upload cannot even start.
#: client/js/upload.ts:447
msgctxt "upload.noFetch"
msgid "Upload failed: fetch is not available"
msgstr "Subida fallida: fetch no está disponible"

#. Error notice when the upload endpoint's reply carries no usable link.
#: client/js/upload.ts:365
msgctxt "upload.noUrl"
msgid "Upload failed: the uploader did not return a URL"
msgstr "Subida fallida: el uploader no devolvió una URL"

#. Error notice when the user drops, pastes or picks a file but this deploy has no uploads endpoint configured, so no file can be sent. Shown in the error strip above the message input.
#: client/js/upload.ts:758
msgctxt "upload.notConfigured"
msgid "File uploads are not configured in this client."
msgstr "Las subidas de archivos no están configuradas en este cliente."

#. Note under an animated image in the upload confirmation dialog; it is not re-drawn, so its animation survives. Em dash is part of the copy.
#: client/components/UploadPreview.vue
msgctxt "upload.noteAnimated"
msgid "Animated — sent as it is, so the animation is kept"
msgstr "Animado — enviado tal como está, por lo que la animación se mantiene"

#. Note under a file in the upload confirmation dialog when it will be sent unchanged, with its metadata. Starts the note.
#: client/components/UploadPreview.vue
msgctxt "upload.noteOff"
msgid "Sent as it is, metadata included"
msgstr "Enviado tal como está, incluyendo metadatos"

#. Note under a file in the upload confirmation dialog when the remove-metadata setting is on and the image will be re-drawn to strip its EXIF metadata. Capitalized; starts the note.
#: client/components/UploadPreview.vue
msgctxt "upload.noteStrip"
msgid "Metadata (EXIF) will be removed before upload"
msgstr "Los metadatos (EXIF) se eliminarán antes de subir"

#. Note under a file in the upload confirmation dialog when the app cannot re-process it and it will be sent unchanged. Starts the note.
#: client/components/UploadPreview.vue
msgctxt "upload.noteUnsupported"
msgid "Sent as it is"
msgstr "Enviado tal como está"

#. Error notice when the network's own upload host (IRCv3 FILEHOST) would not issue an upload token. {reason} is the server's text or a client-side reason, verbatim.
#: client/js/upload.ts
msgctxt "upload.refused"
msgid "Upload refused by the network: {reason}"
msgstr "Subida rechazada por la red: {reason}"

#. aria-label of the ✕ button on a file in the upload confirmation dialog; clicking removes that file from the upload. {name} is the file's name.
#: client/components/UploadPreview.vue
msgctxt "upload.removeOne"
msgid "Don't upload {name}"
msgstr "No subir {name}"

#. Tooltip of the ✕ button on a file in the upload confirmation dialog; clicking removes the file from the upload.
#: client/components/UploadPreview.vue
msgctxt "upload.removeTitle"
msgid "Don't upload this file"
msgstr "No subir este archivo"

#. Error notice when a file the user sent is larger than the uploader's size limit. {file} is the file's name — user content, never translated.
#: client/js/upload.ts:779
