#. aria-label of the hamburger button that opens and closes the sidebar (channel list) on narrow screens.
#: client/components/SidebarToggle.vue:2
msgctxt "sidebar.toggle"
msgid "Toggle channel list"
msgstr "Prehľad zoznamu kanálov"

#. Title and aria-label of the ladybird button in the sidebar, shown only in development builds: opens or closes the eruda in-page devtools.
#: client/components/Sidebar.vue:22
msgctxt "sidebar.toggleDevtools"
msgid "Toggle eruda devtools"
msgstr "Prehľad eruda devtools"

#. Part of a sidebar channel row's aria-label and tooltip, after the channel name: how many unread messages it holds.
#: client/components/ChannelWrapper.vue:89
msgctxt "sidebar.unread"
msgid "{count} unread message"
msgid_plural "{count} unread messages"
msgstr[0] "{count} nepřečtené správy"
msgstr[1] "{count} nepřečtené správy"
msgstr[2] "{count} nepřečtené správy"

#. Column header of the channel-ban list: the banned hostmask, verbatim server data.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.banned"
msgid "Banned"
msgstr "Zabrané"

#. Column header of the channel-ban list: when the ban was set, locale-formatted.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.bannedAt"
msgid "Banned At"
msgstr "Zabrané o"

#. Column header of the channel-ban list: the operator who set the ban, verbatim.
#: client/components/Special/ListBans.vue
msgctxt "special.bans.bannedBy"
msgid "Banned By"
msgstr "Zabrané od"

#. Column header of the channel list: the channel name, verbatim server data.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.channel"
msgid "Channel"
msgstr "Kanál"

#. Column header of the channel list: the channel's topic, verbatim server data.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.topic"
msgid "Topic"
msgstr "Téma"

#. Column header of the channel list: how many visible users the channel has.
#: client/components/Special/ListChannels.vue
msgctxt "special.channels.users"
msgid "Users"
msgstr "Používatelia"

#. Column header of the ban-exception list: the exempted hostmask, verbatim server data.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exempted"
msgid "Exempted"
msgstr "Vylúčené"

#. Column header of the ban-exception list: when the exception was set, locale-formatted.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exemptedAt"
msgid "Exempted At"
msgstr "Vylúčené o"

#. Column header of the ban-exception list: who set the exception, verbatim.
#: client/components/Special/ListExcepts.vue
msgctxt "special.excepts.exemptedBy"
msgid "Exempted By"
msgstr "Vylúčené od"

#. Column header of the ignore list: the ignored hostmask, verbatim server data.
#: client/components/Special/ListIgnored.vue
msgctxt "special.ignored.hostmask"
msgid "Hostmask"
msgstr "Hostmask"

#. Column header of the ignore list: when the ignore was set, locale-formatted.
#: client/components/Special/ListIgnored.vue
msgctxt "special.ignored.ignoredAt"
msgid "Ignored At"
msgstr "Zabrané o"

#. Column header of the channel-invite list: the invited hostmask, verbatim server data.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invited"
msgid "Invited"
msgstr "Zavolávanie"

#. Column header of the channel-invite list: when the invite was set, locale-formatted.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invitedAt"
msgid "Invited At"
msgstr "Zavolávanie v"

#. Column header of the channel-invite list: who set the invite, verbatim.
#: client/components/Special/ListInvites.vue
msgctxt "special.invites.invitedBy"
msgid "Invited By"
msgstr "Zavolávanie od"

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_INVALID_TARGET). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.invalidTarget"
msgid "its lines did not all go to the same target."
msgstr "jeho riadky sa nepodobrali na ten istý cieľ."

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_MAX_BYTES without a limit named). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxBytes"
msgid "it was too long for one multi-line message."
msgstr "bol príliš dlhý na jedno viacriadkové správny."

#. Why fragment of 'Message not sent: {why}'; {limit} is the byte limit the server named.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxBytesLimit"
msgid "it was too long for one multi-line message (the server's limit is {limit} bytes)."
msgstr "bol príliš dlhý na jedno viacriadkové správny (limit servera je {limit} bajtov)."

#. Why fragment of 'Message not sent: {why}' (FAIL BATCH MULTILINE_MAX_LINES without a limit named). Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxLines"
msgid "it had too many lines for one multi-line message."
msgstr "mal príliš veľa riadkov na jedno viacriadkové správny."

#. Why fragment of 'Message not sent: {why}'; {limit} is the line limit the server named.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.maxLinesLimit"
msgid "it had too many lines for one multi-line message (the server's limit is {limit})."
msgstr "mal príliš veľa riadkov na jedno viacriadkové správny (limit servera je {limit})."

#. Why fragment of 'Message not sent: {why}' when the server's rejection named no cause. Lowercase mid-sentence by position.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multiline.rejected"
msgid "the server rejected the multi-line batch."
msgstr "server odmietol viacriadkový batch."

#. Channel error when the server threw away a whole multi-line message; {why} is one of the sr.multiline* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.multilineNotSent"
msgid "Message not sent: {why}"
msgstr "Správa nebol odoslaná: {why}"

#. Channel error for a refused deletion (FAIL REDACT DISABLED); the server's own copy is replaced with this phrasing.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactDisabled"
msgid "Deleting messages is disabled on this server."
msgstr "Vymazávanie správ je zakázané na tomto serveri."

#. Channel error when a message edit was dropped because its redaction was refused; {why} is one of the sr.redact* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactEditPrefix"
msgid "Edit not sent: {why}"
msgstr "Editácia nebol odoslaná: {why}"

#. Channel error for a refused deletion (FAIL REDACT REDACT_FORBIDDEN).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactForbidden"
msgid "You are not allowed to delete that message."
msgstr "Na túto správu nemáš prístup."

#. Channel error for a refused deletion aimed at a non-channel (FAIL REDACT INVALID_TARGET).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactInvalidTarget"
msgid "Messages can only be deleted in channels."
msgstr "Správy môžu byť vymazané len v kanáloch."

#. Channel error for a refused deletion; {why} is one of the sr.redact* copies or the server's own description, left verbatim.
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactPrefix"
msgid "Could not delete message: {why}"
msgstr "Nemožno vymazať správu: {why}"

#. Channel error for a deletion naming a message the server has forgotten (FAIL REDACT UNKNOWN_MSGID).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactUnknownMsgid"
msgid "The server no longer has that message."
msgstr "Server už nemá túto správu."

#. Channel error for a deletion past the server's edit window (FAIL REDACT REDACT_WINDOW_EXPIRED).
#: client/js/irc/handlers/standard-replies.ts
msgctxt "sr.redactWindowExpired"
msgid "That message is too old to delete."
msgstr "Táto správa je príliš stará, aby sa dala vymazať."

#. Title of the left action button on a push notification (shown on every platform): marks the conversation read on the server at this notification's newest message, which also closes the notification on the reader's other devices.
#: client/service-worker.js:1146
msgctxt "sw.markRead"
msgid "Mark read"
msgstr "Oznámiť ako prečítané"

#. Body of the fallback notification shown when a push payload cannot be parsed into a conversation message, or the worker hit an error: something happened, but there is nothing to show. The title is the app name and is never translated.
#: client/service-worker.js:1194
#: client/service-worker.js:1212
msgctxt "sw.newActivity"
msgid "New activity while you were away."
msgstr "Nové činnosti počas tvojho odchodu."

#. Body of a notification for a push payload that named no message text (a degraded opt-down tier): the conversation saw activity whose content was not delivered.
#: client/service-worker.js:992
msgctxt "sw.newMessage"
msgid "New message"
msgstr "Nová správa"

#. Title of the right action button on a push notification; where the platform has an inline reply field it opens that, else it opens the conversation. Kept last so a thumb lands on it.
#: client/service-worker.js:1150
msgctxt "sw.reply"
msgid "Reply"
msgstr "Odpoveď"

#. Placeholder of the notification's inline reply text field (platforms that show one, e.g. desktop Chrome); what the reader types goes to the conversation as one IRC message.
#: client/service-worker.js:1151
msgctxt "sw.replyPlaceholder"
msgid "Reply…"
msgstr "Odpoveď…"

#. Notification title for a message in a channel: {nick} is the sender's nickname, {target} the channel name. Translated as a whole so word order is free; the unread-count suffix is appended after it, never inside.
#: client/service-worker.js:1134
msgctxt "sw.titleChannel"
msgid "{nick} in {target}"
msgstr "{nick} v {target}"

#. Push-notification title for a channel conversation carrying more than one unread message. {nick} is the nick of the newest message's author and {target} is the channel name — both verbatim, never translate them; {count} is the number of unread messages the notification carries.
#: client/service-worker.js:1137
msgctxt "sw.titleChannelCount"
msgid "{nick} in {target} ({count})"
msgstr "{nick} v {target} ({count})"

#. Push-notification title for a query (direct-message) conversation carrying more than one unread message. {nick} is the other side's nick, verbatim — never translate it; {count} is the number of unread messages.
#: client/service-worker.js:1141
msgctxt "sw.titleNickCount"
msgid "{nick} ({count})"
msgstr "{nick} ({count})"

#. System line when a user is marked away. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element. The away reason (user-set, verbatim) follows in parentheses.
#: client/components/MessageTypes/away.vue:10
msgctxt "system.away"
msgid "{nick} is away"
msgstr "{nick} je vypnutý"

#. System line when a user returns from away. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element.
#: client/components/MessageTypes/back.vue:10
msgctxt "system.back"
msgid "{nick} is back"
msgstr "{nick} je späť"

#. System line tail case: a user's username/hostname changed but neither value arrived (degenerate). {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:4
msgctxt "system.chghost"
msgid "{nick} has changed"
msgstr "{nick} sa zmenil"

#. System line when a user's username AND hostname change together. {nick} and {ident} are VERBATIM user content; {host} is a verbatim technical value; {nick} renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:12
msgctxt "system.chghostBoth"
msgid "{nick} has changed username to {ident} and hostname to {host}"
msgstr "{nick} sa zmenil používateľské meno na {ident} a hostname na {host}"

#. System line when a user's hostname changes. {nick} is the user's nick (VERBATIM, renders as the interactive username element) and {host} the new hostname (verbatim technical value).
#: client/components/MessageTypes/chghost.vue:9
msgctxt "system.chghostHost"
msgid "{nick} has changed hostname to {host}"
msgstr "{nick} sa zmenil hostname na {host}"

#. System line when a user's username (ident) changes. {nick} is the user's nick and {ident} the new username — both VERBATIM, never translate; {nick} renders as the interactive username element.
#: client/components/MessageTypes/chghost.vue:6
msgctxt "system.chghostIdent"
msgid "{nick} has changed username to {ident}"
msgstr "{nick} sa zmenil používateľské meno na {ident}"

#. System line for an incoming CTCP request. {nick} is the sender's nick (VERBATIM user content, renders as the interactive username element); {ctcp} is the fixed abbreviation CTCP (never translate); {message} is the verbatim CTCP payload.
#: client/components/MessageTypes/ctcp_request.vue:5
msgctxt "system.ctcpRequest"
msgid "{nick} sent a {ctcp} request: {message}"
msgstr "{nick} odosolil žiadost {ctcp}: {message}"

#. System line when a user invites someone else. {nick} is the inviter's nick and {target} the invited user's nick — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands; {channel} is the channel name (verbatim).
#: client/components/MessageTypes/invite.vue:9
msgctxt "system.inviteTarget"
msgid "{nick} has invited {target} to {channel}"
msgstr "{nick} vyzval {target} do {channel}"

#. System line when the invite targets the reader. {nick} is the inviter's nick (VERBATIM user content, renders as the interactive username element) and {channel} the channel name (verbatim).
#: client/components/MessageTypes/invite.vue:7
msgctxt "system.inviteYou"
msgid "{nick} has invited you to {channel}"
msgstr "{nick} vyzval teba do {channel}"

#. System line when a user joins a channel. {nick} is the joining user's nick, VERBATIM user content — never translate or inflect it; it renders as the interactive username element inline where the placeholder stands, so word order around it is the translator's.
#: client/components/MessageTypes/join.vue:8
msgctxt "system.join"
msgid "{nick} has joined the channel"
msgstr "{nick} sa pridal do kanálu"

#. System line when a user is kicked from a channel. {nick} is the kicker's nick and {target} the kicked user's nick — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands.
#: client/components/MessageTypes/kick.vue:6
msgctxt "system.kick"
msgid "{nick} has kicked {target}"
msgstr "{nick} vylúčil {target}"

#. System line when a channel or user mode changes. {nick} is the nick that set the mode, VERBATIM user content; {modes} is the verbatim mode change (e.g. +o nick), rendered as-is.
#: client/components/MessageTypes/mode.vue:6
msgctxt "system.mode"
msgid "{nick} sets mode {modes}"
msgstr "{nick} nastavil režim {modes}"

#. System line when a user changes nick. {nick} is the old nick and {newNick} the new one — both VERBATIM user content, each rendering as an interactive username element where its placeholder stands.
#: client/components/MessageTypes/nick.vue:6
msgctxt "system.nick"
msgid "{nick} is now known as {newNick}"
msgstr "{nick} je teraz známy ako {newNick}"

#. System line when a user parts a channel. {nick} is the parting user's nick, VERBATIM user content — never translate or inflect it; it renders as the interactive username element.
#: client/components/MessageTypes/part.vue:6
msgctxt "system.part"
msgid "{nick} has left the channel"
msgstr "{nick} opustil kanál"

#. System line when a user disconnects from the network. {nick} is the user's nick, VERBATIM user content; it renders as the interactive username element. The quit reason (user-set, verbatim) follows the sentence in parentheses.
#: client/components/MessageTypes/quit.vue:6
msgctxt "system.quit"
msgid "{nick} has quit"
msgstr "{nick} opustil"

#. Tooltip and aria-label of the translate button in a message's hover toolbar when the message's translation was hidden; it brings it back.
#: client/components/MessageActions.vue
msgctxt "translate.action.showTranslation"
msgid "Show translation"
msgstr "Zobrazit preklad"

#. Tooltip and aria-label of the translate button in a message's hover toolbar: it translates that one message.
#: client/components/MessageActions.vue
msgctxt "translate.action.translate"
msgid "Translate"
msgstr "Preklad"

#. Verdict of the device check in Settings → Translation: the large graphics-processor model cannot run, the smaller main-processor ones can. Any reasons follow as their own list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.cpu"
msgid "The GPU model is unavailable here; the CPU models still work."
msgstr "GPU model je tu nedostupný; CPU modely stále fungujú."

#. Verdict of the device check in Settings → Translation: the graphics processor is good enough for the large model. GPU is the usual abbreviation for the graphics processor.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.gpu"
msgid "This device can run the GPU model."
msgstr "Tento zariadenie môže bežať s GPU modelom."

#. Verdict of the device check in Settings → Translation: no model can run at all. Any reasons follow as their own list.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.none"
msgid "Translation cannot run on this device."
msgstr "Prevedenie nemôže bežať na tomto zariadení."

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the page is not served securely. WebGPU, HTTPS and localhost are technical names.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.insecureOrigin"
msgid "insecure origin: WebGPU needs HTTPS or localhost — serve the app over HTTPS"
msgstr "nebezpečný pôvod: WebGPU potrebuje HTTPS alebo localhost — spustajte aplikáciu cez HTTPS"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the browser has WebGPU but gave out no device. WebGPU is a web standard's name.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noAdapter"
msgid "WebGPU adapter unavailable"
msgstr "adapter WebGPU je nedostupný"

#. One reason the graphics-processor model cannot run, listed under the device verdict in Settings → Translation: the graphics hardware lacks half-precision arithmetic.
#: client/components/Settings/Translation.vue
msgctxt "translate.capability.reason.noF16"
msgid "no 16-bit float shaders"
msgstr "žiadne 16-bitové float šachty"

#. One reason no model can run, listed under the device verdict in Settings → Translation: the browser lacks the WebAssembly SIMD instructions. Both are technical names.
