msgid ""
msgstr ""
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=(0);\n"

#: client/components/Channel.vue
#. Tooltip and aria-label of the ✕ button on a private-conversation or list-window row in the sidebar network list; clicking closes that window (nothing is left on the server).
msgctxt "channel.close"
msgid "Close"
msgstr "Đóng"

#: client/components/Channel.vue
#. Tooltip and aria-label of the ✕ button on a channel row in the sidebar network list; clicking leaves the channel on the server and closes its window.
msgctxt "channel.leave"
msgid "Leave"
msgstr "Thoát"

#: client/components/Channel.vue
#. Tooltip and aria-label of the small icon on a channel row in the sidebar network list while the client is not in that channel (it was left or the join failed); the row's history is still readable.
msgctxt "channel.partedAria"
msgid "Not currently joined"
msgstr "Không tham gia hiện tại"

#: client/components/Chat.vue:186
#. Tooltip and aria-label of the spinner in a chat window's header while the connection is being established, when the network's display name is not known.
msgctxt "chat.connecting"
msgid "Connecting…"
msgstr "Đang kết nối…"

#: client/components/Chat.vue:186
#. Tooltip and aria-label of the spinner in a chat window's header while that network's connection is being established. {network} is the display name of the chat network.
msgctxt "chat.connectingTo"
msgid "Connecting to {network}…"
msgstr "Đang kết nối đến {network}…"

#: client/components/Chat.vue:72
#. aria-label of the ☰ button in a chat window's header; clicking opens the menu of actions for the current conversation.
msgctxt "chat.contextMenu"
msgid "Open the context menu"
msgstr "Mở menu ngữ cảnh"

#: client/components/Chat.vue:22
#. aria-label of the conversation's name in the header of an open chat window (the visible text is the channel or conversation name itself). {type} is the kind of conversation, inserted as an English word by the app: 'channel' (a group chat), 'query' (a private one-on-one chat), 'lobby' (the network's home view) or 'special' (a list window such as the ban list).
msgctxt "chat.currentlyOpen"
msgid "Currently open {type}"
msgstr "Mở hiện tại {type}"

#: client/components/MessageList.vue:10
#. Text of the 'load older messages' button at the top of the scrollback while earlier history is being fetched.
msgctxt "chat.historyLoading"
msgid "Loading…"
msgstr "Đang tải…"

#: client/components/Chat.vue:106
#. aria-label of the downward-arrow button that appears above the message input when the scrollback is scrolled up; clicking scrolls down to the newest messages.
msgctxt "chat.jumpToRecent"
msgid "Jump to recent messages"
msgstr "Nhảy đến tin nhắn gần đây"

#: client/components/Chat.vue:67
#. aria-label of the @ button in a chat window's header; clicking opens the popup listing messages that mention you.
msgctxt "chat.mentions"
msgid "Open your mentions"
msgstr "Mở các nhắc nhở của bạn"

#: client/components/Chat.vue:35
#. aria-label of the save control at the right end of the topic editor, shown while the channel topic is being edited; clicking saves the new topic.
msgctxt "chat.saveTopic"
msgid "Save topic"
msgstr "Lưu chủ đề"

#: client/components/MessageList.vue:11
#. Text of the button at the top of the scrollback that fetches and shows earlier history of the conversation.
msgctxt "chat.showOlder"
msgid "Show older messages"
msgstr "Xem tin nhắn cũ hơn"

#: client/components/Chat.vue:78
#. Tooltip and aria-label of the button in a chat window's header that shows and hides the panel listing the channel's members.
msgctxt "chat.toggleUserlist"
msgid "Toggle user list"
msgstr "Đổi chế độ danh sách người dùng"

#: client/components/Chat.vue:30
#. Placeholder of the input field shown while the channel topic is being edited (double-click the topic line to open it); Enter saves.
msgctxt "chat.topicPlaceholder"
msgid "Set channel topic"
msgstr "Thiết lập chủ đề kênh"

#: client/js/irc/commands/alias.ts
#. Confirmation after /alias <name> <commands> created a new alias. {name} is the alias name as typed, verbatim.
msgctxt "cmd.alias.added"
msgid "Alias /{name} added."
msgstr "Tên biệt danh /{name} đã được thêm."

#: client/js/irc/commands/alias.ts
#. Error when an /alias name is invalid. {max} is the length limit, a number.
msgctxt "cmd.alias.badName"
msgid "Alias names are letters, digits, _ and - (up to {max} characters)."
msgstr "Tên biệt danh chỉ bao gồm các chữ cái, số, _, và - (tối đa {max} ký tự)."

#: client/js/irc/commands/alias.ts
#. Reply to /alias <name> when that alias does not exist. {name} is the name as typed, user input, verbatim; the second '/alias …' part is command syntax.
msgctxt "cmd.alias.missing"
msgid "No alias /{name}. /alias {name} <commands> creates it."
msgstr "Không có biệt danh /{name}. Lệnh /alias {name} <commands> sẽ tạo nó."

#: client/js/irc/commands/alias.ts
#. Reply to a bare /alias when none are defined; the '/alias <name> <commands>' part is command syntax and stays verbatim.
msgctxt "cmd.alias.none"
msgid "No aliases defined. /alias <name> <commands> creates one."
msgstr "Không có biệt danh nào được định nghĩa. Lệnh /alias <name> <commands> sẽ tạo một biệt danh."

#: client/js/irc/commands/alias.ts
#. Error when an /alias body exceeds the size limit. {length} and {max} are byte counts.
msgctxt "cmd.alias.tooLong"
msgid "That alias is too long ({length} of at most {max} characters)."
msgstr "Biệt danh đó quá dài ({length} ký tự, tối đa {max} ký tự)."

#: client/js/irc/commands/alias.ts
#. Error when a new alias would exceed the count limit. {max} is the limit, a number; 'Settings → Aliases' names the settings tab where aliases are edited.
msgctxt "cmd.alias.tooMany"
msgid "You already have {max} aliases; delete one in Settings → Aliases first."
msgstr "Bạn đã có {max} biệt danh; xóa một trong Settings → Aliases trước."

#: client/js/irc/commands/alias.ts
#. Confirmation after /alias <name> <commands> overwrote an existing alias. {name} is the alias name as typed, verbatim.
msgctxt "cmd.alias.updated"
msgid "Alias /{name} updated."
msgstr "Đã cập nhật alias /{name}."

#: client/js/irc/commands/connect.ts
#. Error when /connect is typed for a network that is already up.
msgctxt "cmd.alreadyConnected"
msgid "You are already connected."
msgstr "Bạn đã kết nối."

#: client/js/irc/commands/me.ts
#: client/js/irc/commands/react.ts
#. Error when a command that needs a conversation is typed in a network's lobby. {cmd} is the command as typed, user input, verbatim.
msgctxt "cmd.channelsAndQueriesOnly"
msgid "{cmd} command can only be used in channels and queries."
msgstr "Lệnh {cmd} chỉ có thể được sử dụng trong các kênh và truy vấn."

#: client/js/irc/commands/ban.ts
#: client/js/irc/commands/kick.ts
#: client/js/irc/commands/mode.ts
#: client/js/irc/commands/topic.ts
#: client/js/irc/commands/invite.ts
#. Error when a channel-only command is typed in another window. {cmd} is the command as typed (its canonical lowercase name, e.g. 'ban', 'kickban', 'op'), user input, verbatim.
msgctxt "cmd.channelsOnly"
msgid "{cmd} command can only be used in channels."
msgstr "Lệnh {cmd} chỉ có thể được sử dụng trong các kênh."

#: client/js/irc/commands/invite.ts
#. Error when /invite is typed outside a channel without naming one. {cmd} is the command as typed, user input, verbatim.
msgctxt "cmd.channelsOrTargetOnly"
msgid "{cmd} command can only be used in channels or by specifying a target."
msgstr "Lệnh {cmd} chỉ có thể được sử dụng trong các kênh hoặc bằng cách chỉ định mục tiêu."

#: client/js/irc/commands/ignore.ts
#. Confirmation after /ignore. {mask} is the hostmask, user data, wrapped in bold formatting codes, verbatim.
msgctxt "cmd.ignore.added"
msgid "{mask} added to ignorelist"
msgstr "{mask} đã được thêm vào danh sách bỏ qua."

#: client/js/irc/commands/ignore.ts
#. Error when /ignore names a hostmask that is already on the ignore list.
msgctxt "cmd.ignore.already"
msgid "The specified user/hostmask is already ignored"
msgstr "Người dùng/hostmask được chỉ định đã được bỏ qua."

#: client/js/irc/commands/ignore.ts
#. Error when /unignore names a hostmask that is not on the ignore list.
msgctxt "cmd.ignore.notIgnored"
msgid "The specified user/hostmask is not ignored"
msgstr "Người dùng/hostmask được chỉ định không được bỏ qua."

#: client/js/irc/commands/ignore.ts
#. Confirmation after /unignore. {mask} is the hostmask, user data, wrapped in bold formatting codes, verbatim.
msgctxt "cmd.ignore.removed"
msgid "Successfully removed {mask} from ignorelist"
msgstr "Đã loại bỏ {mask} khỏi danh sách bỏ qua."

#: client/js/irc/commands/ignore.ts
#. Error when /ignore names the user's own nick.
msgctxt "cmd.ignore.self"
msgid "You can't ignore yourself"
msgstr "Bạn không thể bỏ qua chính mình."

#: client/js/irc/commands/ignorelist.ts
#. Error shown instead of the ignore-list window when nothing is ignored.
msgctxt "cmd.ignorelistEmpty"
msgid "Ignorelist is empty"
msgstr "Danh sách bỏ qua trống."

#: client/js/irc/commands/ignorelist.ts
#. Title of the special window showing the network's ignore list, opened by /ignorelist. The name doubles as the window's lookup name, so it stays byte-stable per locale while the session lives.
msgctxt "cmd.ignorelistTitle"
msgid "Ignored users"
msgstr "Người dùng bị bỏ qua."

#: client/js/irc/commands/index.ts
#. Error when a plain message is typed in a network's lobby instead of a channel or query; the lobby's input is for commands.
msgctxt "cmd.lobbySend"
msgid "Messages can not be sent to lobbies."
msgstr "Không thể gửi tin nhắn cho các phòng chờ."

#: client/js/irc/commands/mute.ts
#. Error when /mute or /unmute names several channels or users with no open window. {targets} is the comma-joined list of names as typed, user input, verbatim. Plural for more than one name.
msgctxt "cmd.mute.nonePlural"
msgid "No open channels or users found for {targets}"
msgstr "Không tìm thấy các kênh mở hoặc người dùng nào cho {targets}."

#: client/js/irc/commands/mute.ts
#. Error when /mute or /unmute names a channel or user that has no open window. {targets} is the comma-joined list of names as typed, user input, verbatim. Singular for one name.
msgctxt "cmd.mute.noneSingular"
msgid "No open channel or user found for {targets}"
msgstr "Không tìm thấy kênh mở hoặc người dùng nào cho {targets}."

#: client/js/irc/commands/nick.ts
#. Error when /nick is given a new nick containing spaces.
msgctxt "cmd.nickSpaces"
msgid "Nicknames may not contain spaces."
msgstr "Tên nick không thể chứa khoảng trống."

#: client/js/irc/commands/nick.ts
#. Error when /nick is given a new nick that exceeds the server's reported length limit.
msgctxt "cmd.nickTooLong"
msgid "Nicknames may not be this long."
msgstr "Tên nick không thể dài như vậy."

#: client/js/irc/commands/part.ts
#. Error when /part is typed in a network's lobby; the '/quit' part is a command name, verbatim.
msgctxt "cmd.partLobby"
msgid "You can not part from networks, use /quit instead."
msgstr "Bạn không thể rời khỏi mạng, hãy sử dụng /quit thay thế."

#: client/js/irc/commands/msg.ts
#. Error when /query is given a channel name; the '/join' part is a command name, verbatim.
msgctxt "cmd.query.channel"
msgid "You can not open query windows for channels, use /join instead."
msgstr "Bạn không thể mở cửa sổ truy vấn cho các kênh, hãy sử dụng /join thay thế."

#: client/js/irc/commands/msg.ts
#. Error when /query is typed with no nick.
msgctxt "cmd.query.noArg"
msgid "You cannot open a query window without an argument."
msgstr "Bạn không thể mở cửa sổ truy vấn mà không có đối số."

#: client/js/irc/commands/msg.ts
#. Error when /query is given a name starting with a channel membership prefix (~&@%+); a prefixed nick needs the prefix dropped.
msgctxt "cmd.query.prefix"
msgid "You can not open query windows for names starting with a user prefix."
msgstr "Bạn không thể mở cửa sổ truy vấn cho tên bắt đầu bằng tiền tố người dùng."

#: client/js/irc/commands/msg.ts
#. Error when /query is given a name with spaces; nicks cannot contain them.
msgctxt "cmd.query.spaces"
msgid "You can not open query windows for names containing spaces."
msgstr "Bạn không thể mở cửa sổ truy vấn cho tên chứa khoảng trống."

#: client/js/irc/commands/react.ts
#. Error when /react is typed where no recent message can carry a reaction (e.g. a window without message-tags history).
msgctxt "cmd.reactNoTarget"
msgid "No message to react to: none here carries a msgid."
msgstr "Không có thông báo để phản hồi: không có dòng nào mang msgid."

#: client/js/irc/commands/rejoin.ts
#. Error when /rejoin is typed outside a channel window.
msgctxt "cmd.rejoinChannels"
msgid "You can only rejoin channels."
msgstr "Bạn chỉ có thể tham gia lại kênh."

#: client/js/irc/commands/ctcp.ts
#. Usage line of /ctcp when arguments are missing; the placeholders are command syntax.
msgctxt "cmd.usageCtcp"
msgid "Usage: /ctcp <nick> <ctcp_type>"
msgstr "Cách dùng: /ctcp <nick> <ctcp_type>"

#: client/js/irc/commands/ignore.ts
#. Usage line of /ignore and /unignore when no target is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
msgctxt "cmd.usageIgnore"
msgid "Usage: /{cmd} <nick>[!ident][@host]"
msgstr "Cách dùng: /{cmd} <nick>[!ident][@host]"

#: client/js/irc/commands/join.ts
#. Usage line of /join when no channel is given; the placeholders are command syntax.
msgctxt "cmd.usageJoin"
msgid "Usage: /join <channel> [key]"
msgstr "Cách dùng: /join <channel> [key]"

#: client/js/irc/commands/ban.ts
#. Usage line of the mode-list commands (/ban, /unban, …) when no nick is given. {cmd} is the command as typed, user input, verbatim; the '<nick>' placeholder is command syntax, not user data.
msgctxt "cmd.usageNick"
msgid "Usage: /{cmd} <nick>"
msgstr "Cách dùng: /{cmd} <nick>"

#: client/js/irc/commands/nick.ts
#. Usage line of /nick when no new nick is given; the placeholder is command syntax.
msgctxt "cmd.usageNickChange"
msgid "Usage: /nick <your new nick>"
msgstr "Cách dùng: /nick <your new nick>"

#: client/js/irc/commands/mode.ts
#. Usage line of /op, /deop, /voice, /devoice when no nick is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
msgctxt "cmd.usageNickMulti"
msgid "Usage: /{cmd} <nick> [...nick]"
msgstr "Cách dùng: /{cmd} <nick> [...nick]"

#: client/js/irc/commands/react.ts
#. Usage line of /react when no reaction text is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
msgctxt "cmd.usageReact"
msgid "Usage: /{cmd} <text> [msgid]"
msgstr "Cách dùng: /{cmd} <text> [msgid]"

#: client/js/irc/commands/redact.ts
#. Usage line of /redact when no msgid is given. {cmd} is the command as typed, user input, verbatim; the rest is command syntax.
msgctxt "cmd.usageRedact"
msgid "Usage: /{cmd} <msgid> [reason]"
msgstr "Cách dùng: /{cmd} <msgid> [reason]"

#: client/components/CodeBlock.vue
#. Button under a long code block in a chat message that shows only its first lines; clicking reveals every line. {count} is the number of lines of code. The singular shows with exactly one line, the plural otherwise.
msgctxt "code.showAllLines"
msgid "Show all {count} line"
msgid_plural "Show all {count} lines"
msgstr[0] "Hiển thị tất cả {count} dòng"

#: client/components/CodeBlock.vue
#. Button under a long code block in a chat message while all of its lines are shown; clicking folds the block back to its first lines.
msgctxt "code.showLess"
msgid "Show less"
msgstr "Hiển thị ít hơn"

#: client/components/ChatInput.vue:67
#. aria-label of the ✕ button that leaves reply or edit mode in the compose bar above the message input; the keyboard key Escape does the same.
msgctxt "composer.cancel"
msgid "Cancel"
msgstr "Hủy bỏ"

#: client/components/ChatInput.vue:68
#. Tooltip of the ✕ button that leaves reply or edit mode in the compose bar; it names the keyboard key that does the same thing.
msgctxt "composer.cancelEscape"
msgid "Cancel (Escape)"
msgstr "Hủy bỏ (Tránh thoát)"

#: client/components/ChatInput.vue:45
#. Tooltip and aria-label of the ✕ button on the upload progress bar above the message input; clicking it aborts the upload in progress.
msgctxt "composer.cancelUpload"
msgid "Cancel upload"
msgstr "Hủy bỏ tải lên"

#: client/components/ChatInput.vue:19
#. Button in the connection bar shown above the message input when the connection to the chat network is down and no automatic retry is in progress; clicking it dials the network again.
msgctxt "composer.connect"
msgid "Connect"
msgstr "Kết nối"

#: client/components/ChatInput.vue:19
#. Button in the connection bar shown above the message input while the app waits to retry a dropped connection to the chat network; clicking it skips the wait and dials the network immediately.
msgctxt "composer.connectNow"
msgid "Connect now"
msgstr "Kết nối ngay"

#: client/components/ChatInput.vue:344
#. Text of the connection bar shown above the message input while the dial to the chat network is in flight (a spinner turns beside it). {network} is the display name of the chat network.
msgctxt "composer.connectingTo"
msgid "Connecting to {network}…"
msgstr "Đang kết nối đến {network}…"

#: client/components/ChatInput.vue:339
#. Text of the connection bar shown above the message input when the chat network is down and no reconnect attempt is running yet. {network} is the display name of the chat network.
msgctxt "composer.disconnectedFrom"
msgid "Disconnected from {network}."
msgstr "Đã ngắt kết nối với {network}."

#: client/components/ChatInput.vue:55
#. Label at the left of the compose bar shown while the user edits a message they already sent; the edited text follows it in the same line.
msgctxt "composer.editing"
msgid "Editing message"
msgstr "Đang chỉnh sửa tin nhắn"

#: client/components/ChatInput.vue:336
#. Fallback name for a chat network whose configured name is empty; it is inserted into connection-bar sentences such as 'Connecting to {network}…' in place of the network name. Mid-sentence by position.
msgctxt "composer.fallbackNetwork"
msgid "the network"
msgstr "mạng"

#: client/components/ChatInput.vue:75
#. Visually hidden label of the message input field, read by screen readers; the field is where chat messages are typed.
msgctxt "composer.inputLabel"
msgid "Message input"
msgstr "Nhập tin nhắn"

#: client/components/ChatInput.vue:115
#. Tooltip on the send button while the chat network is disconnected, explaining why messages cannot be sent right now.
msgctxt "composer.notConnected"
msgid "Not connected"
msgstr "Không kết nối"

#: client/components/ChatInput.vue:293
#. Placeholder of the message input shown while it is empty. {name} is the name of the conversation being typed into: a channel's name, or the person's nick in a private one-on-one conversation.
msgctxt "composer.placeholder"
msgid "Write to {name}"
msgstr "Gửi tin nhắn cho {name}"

#: client/components/ChatInput.vue:343
#. Text of the connection bar shown above the message input while the client waits to reconnect to a chat network it lost. {network} is the display name of the chat network; {seconds} is the whole number of seconds until the retry starts, updating every half second. The singular form shows when one second remains, the plural for any other number.
msgctxt "composer.reconnectIn"
msgid "Reconnecting to {network} in {seconds}s…"
msgid_plural "Reconnecting to {network} in {seconds}s…"
msgstr[0] "Đang nối lại với {network} trong {seconds}s…"

#: client/components/ChatInput.vue:60
#. Label at the left of the compose bar shown while a reply is being written. {nick} is the name of the user being replied to, shown emphasized; the quoted message preview follows it. Keep the trailing colon.
msgctxt "composer.replyingTo"
msgid "Replying to {nick}:"
msgstr "Trả lời cho {nick}:"

#: client/components/ChatInput.vue:123
#. Tooltip and aria-label of the send button beside the message input.
msgctxt "composer.send"
msgid "Send message"
msgstr "Gửi tin nhắn"

#: client/components/ChatInput.vue:93
#. Tooltip and aria-label of the paperclip button beside the message input; clicking it opens the file picker to send a file into the conversation.
msgctxt "composer.uploadFile"
msgid "Upload file"
msgstr "Tải lên tệp"

#: client/components/ChatInput.vue:580
#. Part of the upload progress bar, appended after the uploading text when several files are queued: it says which file of how many is being sent now. {index} is the number of the current file, {count} the total number queued.
msgctxt "composer.uploadIndex"
msgid "{index} of {count}"
msgstr "{index} trong {count}"

#: client/components/ChatInput.vue:584
#. Part of the upload progress bar, appended after the uploading text while the file is being prepared (re-encoded or stripped of metadata) before it is sent. Starts lowercase because it is joined with the other parts into one line.
msgctxt "composer.uploadPreparing"
msgid "preparing…"
msgstr "đang chuẩn bị…"

#: client/components/ChatInput.vue:586
#. Part of the upload progress bar, appended after the uploading text while the file has been sent and the chat server has not confirmed it yet. Starts lowercase because it is joined with the other parts into one line.
msgctxt "composer.uploadWaiting"
msgid "waiting for the server…"
msgstr "đang chờ máy chủ…"

#: client/components/ChatInput.vue:577
#. First part of the upload progress bar shown above the message input while a file is being sent to the chat server. {file} is the name of the file currently going up.
msgctxt "composer.uploading"
msgid "Uploading {file}"
msgstr "Tải lên {file}"

#: client/components/MessageCondensed.vue
#. Condensed status block: away markings while the block was collapsed. The singular shows 'once' when one marking happened, the plural the number of markings; {count} is that number.
msgctxt "condensed.away"
msgid "marked away once"
msgid_plural "marked away {count} times"
msgstr[0] "đã đánh dấu đi một lần"

#: client/components/MessageCondensed.vue
#. Condensed status block: back markings while the block was collapsed. The singular shows 'once' when one marking happened, the plural the number of markings; {count} is that number.
msgctxt "condensed.back"
msgid "marked back once"
msgid_plural "marked back {count} times"
msgstr[0] "đã đánh dấu trở lại một lần"

#: client/components/MessageCondensed.vue
#. Condensed status block: {count} users changed their username/hostname while the block was collapsed.
msgctxt "condensed.chghost"
msgid "{count} user has changed hostname"
msgid_plural "{count} users have changed hostname"
msgstr[0] "{count} người dùng đã thay đổi tên máy chủ"

#: client/components/MessageCondensed.vue
#. Condensed status block: {count} users joined while the block was collapsed. The counts of several kinds join into one sentence in the active locale's list format.
msgctxt "condensed.join"
msgid "{count} user has joined"
msgid_plural "{count} users have joined"
msgstr[0] "{count} người dùng đã tham gia"

#: client/components/MessageCondensed.vue
#. Condensed status block: {count} users were kicked while the block was collapsed.
msgctxt "condensed.kicked"
msgid "{count} user was kicked"
msgid_plural "{count} users were kicked"
msgstr[0] "{count} người dùng đã bị kick"

#: client/components/MessageCondensed.vue
#. Condensed status block: {count} users left the channel (quits are counted as parts) while the block was collapsed.
msgctxt "condensed.left"
msgid "{count} user has left"
msgid_plural "{count} users have left"
msgstr[0] "{count} người dùng đã rời khỏi"

#: client/components/MessageCondensed.vue
#. Condensed status block: {count} channel-mode changes were set while the block was collapsed (one MODE line can carry several).
msgctxt "condensed.modes"
msgid "{count} mode was set"
msgid_plural "{count} modes were set"
msgstr[0] "{count} mode được thiết lập"

#: client/components/MessageCondensed.vue
#. Condensed status block: {count} users renamed while the block was collapsed.
msgctxt "condensed.nick"
msgid "{count} user has changed nick"
msgid_plural "{count} users have changed nick"
msgstr[0] "{count} người dùng đã thay đổi nick"

#: client/components/MessageCondensed.vue
#. aria-label of the small toggle button that expands or collapses the condensed status block in a channel's scrollback.
msgctxt "condensed.toggle"
msgid "Toggle status messages"
msgstr "Đảo ngược trạng thái thông báo"

#: client/components/ConfirmDialog.vue
#. Button of every confirmation dialog in the app (delete message, delete network, restore settings, clear history…); clicking declines and closes the dialog.
msgctxt "confirm.cancel"
msgid "Cancel"
msgstr "Hủy bỏ"

#: client/components/Windows/Connect.vue:34
#: client/components/Windows/Connect.vue:213
#. Label of the services account (login name) text field on the connect form and on the network edit form.
msgctxt "connect.account"
msgid "Account"
msgstr "Tài khoản"

#: client/components/Windows/Connect.vue:7
#. aria-label of the whole connect screen (the window/dialog element); announced by screen readers on arriving at the form.
msgctxt "connect.ariaLabel"
msgid "Connect"
msgstr "Kết nối"

#: client/components/Windows/Connect.vue:201
#. Heading of the authentication section on the connect form (the SASL toggle and account fields follow).
msgctxt "connect.authentication"
msgid "Authentication"
msgstr "xác thực"

#: client/components/Windows/Connect.vue:290
#. Checkbox on the connect form: dial this network every time the app opens.
msgctxt "connect.autoconnect"
msgid "Connect automatically when the app starts"
msgstr "Kết nối tự động khi ứng dụng mở"

#: client/components/Windows/Connect.vue:280
#. Checkbox at the bottom of the connect form: show desktop notifications for this network's messages; the browser's permission ask fires when it is first switched on.
msgctxt "connect.browserNotifications"
msgid "Browser notifications for this network"
msgstr "Thông báo trình duyệt cho mạng này"

#: client/components/Windows/Connect.vue:188
#. Label of the field listing channels to join automatically after connecting, on the connect and network edit forms.
msgctxt "connect.channels"
msgid "Channels"
msgstr "Các kênh"

#: client/components/Windows/Connect.vue:194
#. Placeholder of the channels field on the connect form: example channel names, and a note that the field may stay empty.
msgctxt "connect.channelsPlaceholder"
msgid "#channel, #another (optional)"
msgstr "#channel, #another (tùy chọn)"

#: client/components/Windows/Connect.vue:84
#: client/components/Windows/Connect.vue:308
#. Status line shown on the connect form right after submitting: the nick used and the network name (or host:port of the server) being dialled.
msgctxt "connect.connectingAs"
msgid "Connecting as {nick} to {network}…"
msgstr "Kết nối như {nick} đến {network}…"

#: client/js/irc/client.ts
#. Lobby status line while a chat network is being dialled. {host} and {port} come from the saved network's settings.
msgctxt "connect.connectingTo"
msgid "Connecting to {host}:{port}…"
msgstr "Kết nối đến {host}:{port}…"

#: client/js/irc/client.ts
#. Lobby status line while an automatic retry dials a chat network; {attempt} counts the retries this connection has seen.
msgctxt "connect.connectingToAttempt"
msgid "Connecting to {host}:{port}… (attempt {attempt})"
msgstr "Kết nối đến {host}:{port}… (lần thử {attempt})"

#: client/js/irc/client.ts
#. Lobby status line when the user's own /quit closed the connection on purpose.
msgctxt "connect.disconnected"
msgid "Disconnected."
msgstr "Đã ngắt kết nối."

#: client/js/irc/client.ts
#. Lobby status line after registration naming the IRCv3 capabilities the server enabled; {caps} is a comma-separated list of protocol tokens, never translated.
msgctxt "connect.enabledCaps"
msgid "Enabled capabilities: {caps}"
msgstr "Các khả năng được kích hoạt: {caps}"

#: client/components/Windows/Connect.vue:572
#. Notice on the connect form when it was opened by a link to a saved network whose password was not remembered; {account} is the services account name.
msgctxt "connect.enterPassword"
msgid "Enter the password for {account} to connect."
msgstr "Nhập mật khẩu cho {account} để kết nối."

#: client/components/Windows/Connect.vue:672
#. Error notice shown under the guest sign-in form when the guest nick field was left empty or invalid.
msgctxt "connect.guestNickRequired"
msgid "Choose a nick to connect as a guest."
msgstr "Chọn nick để kết nối như khách."

#: client/js/branding.ts
#. Button that connects with just a nick instead of an account.
msgctxt "connect.guestSubmit"
msgid "Connect as guest"
msgstr "Kết nối như khách"

#: client/js/branding.ts
#. Heading of the guest half of the sign-in form (features.guestAccess on).
msgctxt "connect.guestTitle"
msgid "No account?"
msgstr "Không có tài khoản?"

#: client/components/Windows/Connect.vue:608
#. Notice at the top of the connect form when a web+irc:// link named a server the deploy does not allow; {network} is this deploy's network name, {host} the refused server.
msgctxt "connect.linkIgnored"
msgid "This app only connects to {network}. The link to {host} was ignored."
msgstr "Ứng dụng này chỉ kết nối đến {network}. Liên kết đến {host} đã bị bỏ qua."

#: client/components/Windows/Connect.vue:610
#. Notice on the connect approval dialog opened from a web+irc:// link without channels; {host}:{port} is the proposed server.
msgctxt "connect.linkSuggest"
msgid "This link suggests connecting to {host}:{port}. Nothing is saved until you choose to connect."
msgstr "Liên kết này gợi ý kết nối đến {host}:{port}. Không có gì được lưu trữ cho đến khi bạn chọn kết nối."

#: client/components/Windows/Connect.vue:611
#. Notice on the connect approval dialog opened from a web+irc:// link that also names channels to join; {channels} is the comma-separated channel list.
msgctxt "connect.linkSuggestJoin"
msgid "This link suggests connecting to {host}:{port} and joining {channels}. Nothing is saved until you choose to connect."
msgstr "Liên kết này gợi ý kết nối đến {host}:{port} và tham gia {channels}. Không có gì được lưu trữ cho đến khi bạn chọn kết nối."

#: client/components/Windows/Connect.vue:28
#: client/components/Windows/Connect.vue:126
#. Read-only row label on the connect/sign-in form, above the name of the network being connected to (shown instead of an editable server field).
msgctxt "connect.network"
msgid "Network"
msgstr "Mạng"

#: client/components/Windows/Connect.vue:118
#. Heading of the connect form when it opened from a web+irc:// link that proposes a server the user has not approved yet.
msgctxt "connect.newServerTitle"
msgid "Connect to a new server?"
msgstr "Kết nối đến máy chủ mới?"

#: client/components/Windows/Connect.vue:101
#: client/components/Windows/Connect.vue:173
#. Label of the nickname text field: on the connect form and in the guest half of the sign-in panel.
msgctxt "connect.nick"
msgid "Nick"
msgstr "Tên nick"

#: client/components/Windows/Connect.vue:91
#: client/components/Windows/Connect.vue:315
#. Dismiss button on the connect screen shown as a dialog when the user followed a web+irc:// link; declines the connection without disconnecting the app.
msgctxt "connect.notNow"
msgid "Not now"
msgstr "Không ngay"

#: client/components/Windows/Connect.vue:46
#: client/components/Windows/Connect.vue:228
#. Label of the account password field on the connect form, sign-in panel and network edit form; the field has a show/hide eye toggle.
msgctxt "connect.password"
msgid "Password"
msgstr "Mật khẩu"

#: client/components/Windows/Connect.vue:251
#. Checkbox in the authentication section of the connect form: register this device for push notifications once the IRC server supports it.
msgctxt "connect.pushNotifications"
msgid "Push notifications (registers when the server supports them)"
msgstr "Thông báo đẩy (gửi thông báo khi máy chủ hỗ trợ)"

#: client/js/irc/client.ts
#. Lobby status line when the network was disconnected while an automatic reconnect was still scheduled.
msgctxt "connect.reconnectCancelled"
msgid "Reconnect cancelled."
msgstr "Hủy kết nối lại."

#: client/js/branding.ts
#. Checkbox on the sign-in form: remember the account and reconnect on the next load.
msgctxt "connect.rememberMe"
msgid "Stay signed in on this device"
msgstr "Duy trì đăng nhập trên thiết bị này"

#: client/components/Windows/Connect.vue:264
#. Checkbox under the SASL password field on the connect form: keep the password in this browser's storage so reconnects need no typing.
msgctxt "connect.rememberPassword"
msgid "Remember password on this device"
msgstr "Nhớ mật khẩu trên thiết bị này"

#: client/js/irc/client.ts
#. Lobby error when the login the deploy asked for did not go through; {reason} is one of the connect.saslReason* copies (or, for a few server-side rejections, a technical phrase left verbatim).
msgctxt "connect.saslFailed"
msgid "SASL authentication failed: {reason}"
msgstr "Thất bại trong xác thực SASL: {reason}"

#: client/js/irc/sasl.ts
#. Lobby status line listing the SASL mechanisms the server offers (902-adjacent RPL_SASLMECHS). {mechanisms} is the server's comma-separated token list, verbatim.
msgctxt "connect.saslMechanisms"
msgid "Available SASL mechanisms: {mechanisms}"
msgstr "Các cơ chế SASL có sẵn: {mechanisms}"

#: client/js/irc/client.ts
#. Lobby error after a failed required SASL login: the network was dropped instead of registering unauthenticated. {host} is the chat network's configured host name.
msgctxt "connect.saslQuitHint"
msgid "Not connecting to {host} without the login you asked for."
msgstr "Không kết nối đến {host} mà không có tài khoản đăng nhập bạn yêu cầu."

#: client/js/irc/client.ts
#. Lobby error after a required SASL login that merely timed out (a slow login service, not a wrong password): the connection is redialled on the usual schedule. {host} is the configured host name.
msgctxt "connect.saslQuitHintRetry"
msgid "Not connecting to {host} without the login you asked for; trying again."
msgstr "Không kết nối đến {host} mà không có tài khoản đăng nhập bạn yêu cầu; đang thử lại."

#: client/js/irc/sasl.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the server's AUTHENTICATE challenge is not the empty one PLAIN and EXTERNAL expect. {mechanism} is the mechanism token, verbatim. Lowercase mid-sentence by position.
msgctxt "connect.saslReason.badChallenge"
msgid "unexpected challenge for {mechanism}"
msgstr "Thách thức không mong đợi cho {mechanism}"

#: client/js/irc/handlers/cap.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the server rejected the client's request for the sasl capability (CAP NAK). Lowercase mid-sentence by position.
msgctxt "connect.saslReason.capRefused"
msgid "the server refused the sasl capability"
msgstr "Máy chủ từ chối khả năng SASL"

#: client/js/irc/client.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the saved network has no login credentials. Lowercase mid-sentence by position.
msgctxt "connect.saslReason.noCredentials"
msgid "no account name or password is configured"
msgstr "Không có tên tài khoản hoặc mật khẩu được cấu hình"

#: client/js/irc/sasl.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when a SASL failure numeric carries no text of its own. {code} is the numeric, verbatim. Lowercase mid-sentence by position.
msgctxt "connect.saslReason.numeric"
msgid "numeric {code}"
msgstr "mã số {code}"

#: client/js/irc/client.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the server took too long to answer the login. Lowercase mid-sentence by position.
msgctxt "connect.saslReason.timeout"
msgid "timed out waiting for the server"
msgstr "đã hết thời gian chờ đợi server"

#: client/js/irc/client.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the server announced no usable sasl capability. Lowercase mid-sentence by position.
msgctxt "connect.saslReason.unavailable"
msgid "the server does not offer SASL"
msgstr "server không hỗ trợ SASL"

#: client/js/irc/client.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the server's rejection named no cause. Lowercase mid-sentence by position.
msgctxt "connect.saslReason.unknown"
msgid "unknown error"
msgstr "lỗi không xác định"

#: client/js/irc/client.ts
#. Reason fragment of 'SASL authentication failed: {reason}' when the server's SASL mechanisms do not include the saved network's. {offered} and {mechanism} are protocol mechanism tokens, never translated.
msgctxt "connect.saslReason.wrongMechanism"
msgid "the server offers SASL {offered}, not {mechanism}"
msgstr "server hỗ trợ SASL {offered}, không phải {mechanism}"

#: client/js/irc/client.ts
#. Follow-up to a failed required SASL login, telling the reader where to fix or drop the credentials.
msgctxt "connect.saslRequiredHint"
msgid "Check the account name and password in this network's settings, or pick \"No authentication\" there to connect without logging in."
msgstr "Kiểm tra tên tài khoản và mật khẩu trong cài đặt mạng này, hoặc chọn \"Không xác thực\" để kết nối mà không đăng nhập."

#: client/components/Windows/Connect.vue:207
#. Checkbox on the connect form: reveals the account name and password fields used to authenticate with network services (SASL).
msgctxt "connect.saslToggle"
msgid "I have a services account (SASL)"
msgstr "Tôi có tài khoản dịch vụ (SASL)"

#: client/components/Windows/Connect.vue:124
#: client/components/Windows/Connect.vue:132
#. The IRC server section of the connect form: heading above the server fields, and the label of the server host field.
msgctxt "connect.server"
msgid "Server"
msgstr "Server"

#: client/components/Windows/Connect.vue:139
#. aria-label of the server host text input (e.g. irc.example.org) on the connect form; the visible label is on the row.
msgctxt "connect.serverAddress"
msgid "Server address"
msgstr "Địa chỉ server"

#: client/components/Windows/Connect.vue:156
#. aria-label of the numeric port input next to the server host field on the connect form.
msgctxt "connect.serverPort"
msgid "Server port"
msgstr "Port server"

#: client/js/branding.ts
#. Intro line above the sign-in form; intentionally empty by default, fill only if the deploy wants one.
msgctxt "connect.signInIntro"
msgid ""
msgstr ""

#: client/js/branding.ts
#. Button that submits the sign-in form.
msgctxt "connect.signInSubmit"
msgid "Sign in"
msgstr "Đăng nhập"

#: client/js/branding.ts
#. Heading of the sign-in panel (features.signIn on).
msgctxt "connect.signInTitle"
msgid "Sign in"
msgstr "Đăng nhập"

#: client/js/irc/client.ts
#. Lobby status line when the connection is dropped to be redialled over TLS. {port} is the secure port the server's policy named.
msgctxt "connect.stsReconnect"
msgid "Server requires a secure connection (STS): reconnecting on port {port}…"
msgstr "Server yêu cầu kết nối an toàn (STS): kết nối lại trên port {port}…"

#: client/js/irc/client.ts
#. Lobby status line when the server's strict-transport-security policy upgrades a plain connection to TLS. {port} is the new TLS port.
msgctxt "connect.stsUpgrade"
msgid "Upgrading to TLS on port {port} (STS policy)"
msgstr "Cập nhật TLS trên port {port} (chính sách STS)"

#: client/js/branding.ts
#. Button on the connect form: submits it and dials the server.
msgctxt "connect.submit"
msgid "Connect"
msgstr "Kết nối"

#: client/js/branding.ts
#. Heading of the connect form (features.signIn off).
msgctxt "connect.title"
msgid "Connect to IRC"
msgstr "Kết nối đến IRC"

#: client/components/Windows/Connect.vue:166
#. Checkbox under the server fields on the connect form: connect over TLS instead of a plain connection.
msgctxt "connect.useTls"
msgid "Use secure connection (TLS)"
msgstr "Sử dụng kết nối an toàn (TLS)"

#: client/components/Windows/Connect.vue:171
#. Heading of the user section of the connect form (nick, channels, authentication follow below it).
msgctxt "connect.user"
msgid "User"
msgstr "Người dùng"

#: client/js/socket-events/connection.ts
#. Error line the app shows when the connection to the chat server failed (also flashed on the loading splash). {message} is the verbatim technical message from the server or browser — never translate or reword its content.
msgctxt "connection.error"
msgid "Connection error: {message}"
msgstr "Lỗi kết nối: {message}"

#: client/components/DateMarker.vue:4
#. Label of a date marker between message groups in the scrollback: tooltip of the divider between the messages sent today.
msgctxt "dates.today"
msgid "Today"
msgstr "Hôm nay"

#: client/components/DateMarker.vue:4
#. Label of a date marker between message groups in the scrollback: tooltip of the divider between the messages sent the day before; older groups show the date itself.
msgctxt "dates.yesterday"
msgid "Yesterday"
msgstr "Hôm qua"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1001 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1001"
msgid "server going away"
msgstr "server going away"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1002 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1002"
msgid "WebSocket protocol error"
msgstr "WebSocket protocol error"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1006 (abnormal closure: refused, unreachable, TLS failure — the browser never says which) in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1006"
msgid "connection lost"
msgstr "connection lost"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1008 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1008"
msgid "policy violation"
msgstr "policy violation"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1009 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1009"
msgid "message too large"
msgstr "message too large"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1011 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1011"
msgid "server error"
msgstr "server error"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1012 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1012"
msgid "server restarting"
msgstr "server restarting"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1013 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1013"
msgid "server asked to try again later"
msgstr "server asked to try again later"

#: client/js/irc/disconnect.ts
#. Name of WebSocket close code 1015 in a connection-failure report. Lowercase mid-sentence by position.
msgctxt "disconnect.code1015"
msgid "TLS handshake failed"
msgstr "TLS handshake failed"

#: client/js/irc/disconnect.ts
#. Detail of a connection-failure report when the WebSocket closed with a code the app has no name for. {code} is the numeric close code, verbatim.
msgctxt "disconnect.codeUnknown"
msgid "code {code}"
msgstr "code {code}"

#: client/js/irc/disconnect.ts
#. Connection-failure report when the WebSocket never opened. {url} is the address that was dialled, verbatim. {error} is ' (<the browser's error text>)' or empty — the browser hides why a dial failed, so the slot often stays empty.
msgctxt "disconnect.couldNotConnect"
msgid "Could not connect to {url}{error}."
msgstr "Could not connect to {url}{error}."

#: client/js/irc/disconnect.ts:78
#. Headline when a network the client is dialling never opened and the retry schedule is standing down (the browser refused or could not reach the address). {url} is the WebSocket URL that was dialled; {error} is the browser's error text in parentheses, or empty.
msgctxt "disconnect.couldNotConnectNotReconnecting"
msgid "Could not connect to {url}{error}. Not reconnecting."
msgstr "Could not connect to {url}{error}. Not reconnecting."

#: client/js/irc/disconnect.ts
#. Connection-failure report once the network was registered. {host} is the network's configured host name, verbatim. {detail} is ' (<server close reason>)', ' (<close-code name>)' or empty.
msgctxt "disconnect.disconnected"
msgid "Disconnected from {host}{detail}."
msgstr "Disconnected from {host}{detail}."

#: client/js/irc/disconnect.ts:127
#. Headline when a registered connection closed and the retry schedule is standing down. {host} is the host as the user typed it; {detail} is the close detail in parentheses, or empty.
msgctxt "disconnect.disconnectedNotReconnecting"
msgid "Disconnected from {host}{detail}. Not reconnecting."
msgstr "Disconnected from {host}{detail}. Not reconnecting."

#: client/js/irc/disconnect.ts
#. Follow-up hint under a failed connection dialled with ws:// from an https:// page: the browser blocks mixed content, so the fix is on the network's settings.
msgctxt "disconnect.hint.httpsBlocked"
msgid "This page was loaded over HTTPS, so the browser blocks plain ws:// connections. Enable TLS for this network, or open the app over http://."
msgstr "This page was loaded over HTTPS, so the browser blocks plain ws:// connections. Enable TLS for this network, or open the app over http://."

#: client/js/irc/disconnect.ts
#. Follow-up hint under a failed plain (ws://) dial from a non-secure page.
msgctxt "disconnect.hint.plainCauses"
msgid "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or it does not accept WebSocket connections on that port."
msgstr "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or it does not accept WebSocket connections on that port."

#: client/js/irc/disconnect.ts
#. Follow-up hint under a connection the server dropped during IRC registration, when the close reason named no live session.
msgctxt "disconnect.hint.registration"
msgid "The WebSocket opened but the server dropped it before registration finished - check that this port really speaks IRC over WebSocket, and look for a server notice above for the reason."
msgstr "The WebSocket opened but the server dropped it before registration finished - check that this port really speaks IRC over WebSocket, and look for a server notice above for the reason."

#: client/js/irc/disconnect.ts
#. Follow-up hint when the server's close reason names a live session: retrying alone cannot fix it, the other client has to go.
msgctxt "disconnect.hint.sessionConflict"
msgid "This account is already connected on this network - another tab, window or device is using it. Close that client; this tab then connects on its next retry (a dead connection is reclaimed within about a minute)."
msgstr "This account is already connected on this network - another tab, window or device is using it. Close that client; this tab then connects on its next retry (a dead connection is reclaimed within about a minute)."

#: client/js/irc/disconnect.ts
#. Follow-up hint under a failed secure (wss://) dial. {url} is the network's address with https: in place of wss:, for accepting a self-signed certificate once.
msgctxt "disconnect.hint.wssCauses"
msgid "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or its TLS certificate is not trusted — for a self-signed certificate, open {url} in a new tab, accept the warning, then reconnect."
msgstr "The browser does not reveal why. Likely causes: the server is down, the port is wrong, or its TLS certificate is not trusted — for a self-signed certificate, open {url} in a new tab, accept the warning, then reconnect."

#: client/js/irc/disconnect.ts
#. Connection-failure report when the server dropped the socket before registration finished. {host} is the network's configured host name, verbatim. {detail} is ' (<server close reason>)', ' (<close-code name>)' or empty.
msgctxt "disconnect.registeringClosed"
msgid "Connection to {host} closed during IRC registration{detail}."
msgstr "Connection to {host} closed during IRC registration{detail}."

#: client/js/irc/disconnect.ts:112
#. Headline when the connection was closed between connecting and completing IRC registration and the retry schedule is standing down. {host} is the host as the user typed it; {detail} is the close detail in parentheses (a server reason, a connection-lost note or the close code), or empty.
msgctxt "disconnect.registeringClosedNotReconnecting"
msgid "Connection to {host} closed during IRC registration{detail}. Not reconnecting."
msgstr "Kết nối đến {host} bị đóng trong quá trình đăng ký IRC{detail}. Không reconnect."

#: client/components/MessageTypes/error.vue
#. Join refusal (475) phrased by the client. {channel} is the refused channel name, user data, never translated; the '- <cause>.' layout follows the server's cause ordering.
msgctxt "error.badChannelKey"
msgid "Cannot join {channel} - Bad channel key."
msgstr "Không thể tham gia {channel} - Mật khẩu kênh sai."

#: client/components/MessageTypes/error.vue
#. Join refusal (474) phrased by the client; {channel} is the refused channel name.
msgctxt "error.bannedFromChannel"
msgid "Cannot join {channel} - You have been banned from the channel."
msgstr "Không thể tham gia {channel} - Bạn đã bị cấm tham gia kênh."

#: client/components/MessageTypes/error.vue
#. Send refusal (404) phrased by the client; {channel} is the refused channel name.
msgctxt "error.cannotSendToChannel"
msgid "Cannot send to channel {channel}"
msgstr "Không thể gửi tin nhắn đến kênh {channel}."

#: client/components/MessageTypes/error.vue
#. Join refusal (471) phrased by the client; {channel} is the refused channel name.
msgctxt "error.channelIsFull"
msgid "Cannot join {channel} - Channel is full."
msgstr "Không thể tham gia {channel} - Kênh đầy."

#: client/components/MessageTypes/error.vue
#. Refusal (482) phrased by the client, e.g. a mode change without operator status.
msgctxt "error.chanopPrivsNeeded"
msgid "Cannot perform action: You're not a channel operator."
msgstr "Không thể thực hiện hành động: Bạn không phải là người điều hành kênh."

#: client/components/MessageTypes/error.vue
#. Join refusal (473) phrased by the client; {channel} is the refused channel name.
msgctxt "error.inviteOnlyChannel"
msgid "Cannot join {channel} - Channel is invite only."
msgstr "Không thể tham gia {channel} - Kênh chỉ cho phép mời."

#: client/components/MessageTypes/error.vue
#. Send refusal (401) phrased by the client; {nick} is the addressed nick, user data.
msgctxt "error.noSuchNick"
msgid "User {nick} hasn't logged in or does not exist."
msgstr "Người dùng {nick} chưa đăng nhập hoặc không tồn tại."

#: client/components/MessageTypes/error.vue
#. Refusal (442) phrased by the client, e.g. a topic change from outside.
msgctxt "error.notOnChannel"
msgid "Cannot perform action: You're not on the channel."
msgstr "Không thể thực hiện hành động: Bạn không ở trong kênh."

#: client/components/MessageTypes/error.vue
#. Login refusal (464) phrased by the client.
msgctxt "error.passwordMismatch"
msgid "Password mismatch."
msgstr "Mật khẩu không khớp."

#: client/components/MessageTypes/error.vue
#. Join refusal (405) phrased by the client; {channel} is the refused channel name.
msgctxt "error.tooManyChannels"
msgid "Cannot join {channel} - You've already reached the maximum number of channels allowed."
msgstr "Không thể tham gia {channel} - Bạn đã đạt số lượng kênh tối đa."

#: client/components/MessageTypes/error.vue
#. Server rejection (421) phrased by the client; {command} is the unknown slash command as typed, user input.
msgctxt "error.unknownCommand"
msgid "Unknown command: {command}"
msgstr "Lệnh không biết: {command}."

#: client/components/MessageTypes/error.vue
#. Refusal (441) phrased by the client, e.g. a kick of a user who has left; {nick} is user data.
msgctxt "error.userNotInChannel"
msgid "User {nick} is not on the channel."
msgstr "Người dùng {nick} không ở trong kênh."

#: client/components/MessageTypes/error.vue
#. Refusal (443) phrased by the client; {nick} is user data.
msgctxt "error.userOnChannel"
msgid "User {nick} is already on the channel."
msgstr "Người dùng {nick} đã ở trong kênh."

