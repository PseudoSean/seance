msgctxt "help.commands.ignorelist"
msgid "Load the list of ignored users for the current network."
msgstr "načíst seznam ignorovaných uživatelů pro současnou síti."

#. Start of the /invite command description in the help window; a code fragment with the channel parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.inviteA"
msgid "Invite a user to the specified channel. If"
msgstr "pozvat uživatele do určeného kanálu. Pokud"

#. Continuation of the /invite command description in the help window, after the channel-parameter code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.inviteB"
msgid "is omitted, user will be invited to the current channel."
msgstr "je vynecháno, uživatel bude pozván do současného kanálu."

#. Description of the /join command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.join"
msgid "Join a channel. Password is only needed in protected channels and can usually be omitted."
msgstr "připojit se k kanálu. Heslo je potřebné jenom v chráněných kanálech a může být obvykle vynecháno."

#. Description of the /kick command in the help window; it removes the user from the channel (they may rejoin).
#: client/components/Windows/Help.vue
msgctxt "help.commands.kick"
msgid "Kick a user from the current channel."
msgstr "vyhodit uživatele z současného kanálu."

#. Start of the /kickban command description in the help window; a code fragment with the +b mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickbanA"
msgid "Kick and ban ("
msgstr "vyhodit a zakázat ("

#. Middle of the /kickban command description in the help window, after the +b code fragment; a code fragment with the /ban command follows it. Starts with the closing parenthesis. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickbanB"
msgid ") a user from the current channel. Unlike"
msgstr ") uživatel z aktuálního kanálu. Různý"

#. End of the /kickban command description in the help window, after the /ban code fragment. Starts with a comma.
#: client/components/Windows/Help.vue
msgctxt "help.commands.kickbanC"
msgid ", only nicknames (and not host masks) can be used."
msgstr ", pouze nicknáma (a ne host masks) mohou být použity."

#. Description of the /list command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.list"
msgid "Retrieve a list of available channels on this network."
msgstr "Získejte seznam dostupných kanálů na tomto síti."

#. Description of the /me command in the help window. {appName} is the chat app's display name.
#: client/components/Windows/Help.vue
msgctxt "help.commands.me"
msgid "Send an action message to the current channel. {appName} will display it inline, as if the message was posted in the third person."
msgstr "Odesílání akce do aktuálního kanálu. {appName} bude zobrazeno v rámci, jako by zpráva byla napísaná v třetí osobě."

#. Description of the /mode command in the help window; explains whose modes the flags apply to depending on the active window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mode"
msgid "Set the given flags to the current channel if the active window is a channel, another user if the active window is a private message window, or yourself if the current window is a server window."
msgstr "Nastavte dané vlajky pro aktuální kanál, pokud aktivní okno je kanál, jiného uživatele, pokud aktivní okno je okno soukromého zprávy, nebo sebe, pokud aktuální okno je serverové okno."

#. Description of the /msg command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.msg"
msgid "Send a message to the specified channel."
msgstr "Odesílání zprávy do určeného kanálu."

#. Description of the /mute command in the help window; a code fragment with the /unmute command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.mute"
msgid "Prevent messages from generating any feedback for a channel. This turns off the highlight indicator, hides mentions and inhibits push notifications. Muting a network lobby mutes the entire network. Not specifying any channel target mutes the current channel. Revert with"
msgstr "Zakáže generování zpětné vazby pro kanál. Toto vypne oznamovací indikátor, skryje zmínky a zastaví oznámení přes push. Zakázání mluvení v síti vypne celou síť. Pokud nezadáte cílový kanál, zakažete aktuální kanál. Revert with"

#. Description of the /nick command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.nick"
msgid "Change your nickname on the current network."
msgstr "Změníte své nickname na aktuální síti."

#. Description of the /notice command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.notice"
msgid "Sends a notice message to the specified channel."
msgstr "Odesílá upozornění zprávu do určeného kanálu."

#. Start of the /op command description in the help window; a code fragment with the +o mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.opA"
msgid "Give op ("
msgstr "Uděluje op ("

#. Continuation of the /op command description in the help window, after the +o code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.opB"
msgid ") to one or several users in the current channel."
msgstr ") jednom nebo několika uživatelům v aktuálním kanále."

#. Start of the /part command description in the help window; a code fragment with the channel parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.part"
msgid "Close the specified channel or private message window, or the current channel if"
msgstr "Zavři zadaný kanál nebo soukromý zprávový okno, nebo aktuální kanál pokud"

#. End of the /part command description in the help window, after the channel-parameter code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.partB"
msgid "is omitted."
msgstr "je vynechán."

#. Description of the /query command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.query"
msgid "Send a private message to the specified user."
msgstr "Odeslání soukromé zprávy uživateli."

#. Description of the /quit command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.quit"
msgid "Disconnect from the current network with an optional message."
msgstr "Připojení se k aktuální síti s volitelnou zprávou."

#. Description of the /raw command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.raw"
msgid "Send a raw message to the current IRC network."
msgstr "Odeslání primitivní zprávy aktuální IRC síti."

#. Description of the /rejoin command in the help window; ChanServ (the IRC channel service) stays verbatim.
#: client/components/Windows/Help.vue
msgctxt "help.commands.rejoin"
msgid "Leave and immediately rejoin the current channel. Useful to quickly get op from ChanServ in an empty channel, for example."
msgstr "Odmítnutí a okamžité připojení do aktuálního kanálu. Užitečné pro rychlé získání opu z ChanServ v prázdném kanálu, například."

#. Description of the /search command in the help window. No trailing period in the source; keep it as is.
#: client/components/Windows/Help.vue
msgctxt "help.commands.search"
msgid "Search for messages in the current channel / user"
msgstr "Hledání zpráv v aktuálním kanálu / uživateli"

#. Description of the /slap command in the help window; a playful IRC tradition. Keep the exclamation mark.
#: client/components/Windows/Help.vue
msgctxt "help.commands.slap"
msgid "Slap someone in the current channel with a trout!"
msgstr "Připnout někoho v aktuálním kanálu s trávníkem!"

#. Start of the /topic command description in the help window; a code fragment with the newtopic parameter follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.topicA"
msgid "Get the topic in the current channel. If"
msgstr "Získání tématy v aktuálním kanálu. Pokud"

#. End of the /topic command description in the help window, after the newtopic-parameter code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.topicB"
msgid "is specified, sets the topic in the current channel."
msgstr "Je určený, nastaví téma v aktuálním kanále."

#. Start of the /unban command description in the help window; a code fragment with the -b mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unbanA"
msgid "Unban ("
msgstr "Zrušit zákaz ("

#. Continuation of the /unban command description in the help window, after the -b code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unbanB"
msgid ") a user from the current channel. This can be a nickname or a hostmask."
msgstr ") uživatele z aktuálního kanálu. Může být nickname nebo hostmask."

#. Description of the /unignore command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unignore"
msgid "Unblock messages from the specified user on the current network. This can be a nickname or a hostmask."
msgstr "Unblock zprávy od určeného uživatele v aktuálním sítě. Může být nickname nebo hostmask."

#. Start of the /unmute command description in the help window; a code fragment with the /mute command follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unmuteA"
msgid "Un-mutes the given channel(s) or the current channel if no channel is provided. See"
msgstr "Un-mutes daný kanál(nebo aktuální kanál, pokud není uveden kanál). Poznámka"

#. End of the /unmute command description in the help window, after the /mute code fragment.
#: client/components/Windows/Help.vue
msgctxt "help.commands.unmuteB"
msgid "for more information."
msgstr "pro více informací."

#. Start of the /ver command description in the help window; the CTCP abbreviation follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.verA"
msgid "Ask a user which client they run: a"
msgstr "Zeptej se uživatele, který klient používá: a"

#. Middle of the /ver command description in the help window: follows the CTCP abbreviation, and the literal command '/ctcp nick version' follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.verB"
msgid "VERSION request, the same as"
msgstr "Požadavkům verze, stejně jako"

#. Last sentence of the /ver command description in the help window; a whole sentence on its own.
#: client/components/Windows/Help.vue
msgctxt "help.commands.verC"
msgid "The answer shows where you asked."
msgstr "Odpověď ukazuje, kde jsi se ptal."

#. Start of the /voice command description in the help window; a code fragment with the +v mode follows it. The parenthesis is part of the copy. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commands.voiceA"
msgid "Give voice ("
msgstr "Přidat hlas ("

#. Continuation of the /voice command description in the help window, after the +v code fragment. Starts with the closing parenthesis.
#: client/components/Windows/Help.vue
msgctxt "help.commands.voiceB"
msgid ") to one or several users in the current channel."
msgstr ") jednom nebo několik uživatelům v aktuálním kanále."

#. Description of the /whois command in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.commands.whois"
msgid "Retrieve information about the given user on the current network."
msgstr "Získat informace o daném uživateli v aktuální síti."

#. Word inside the link of the help window's past-release sentence; the linked text names the source code commit the running build was made from, and the commit hash follows it. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.commitLink"
msgid "commit"
msgstr "dodržovat"

#. First word of the two list items under the help window's past-release sentence; each continues with a link comparing two versions. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.compare"
msgid "Compare"
msgstr "Porovnat"

#. Label of the documentation link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.documentation"
msgid "Documentation"
msgstr "Dokumentace"

#. Shared first part of the descriptions of the Ctrl+B, Ctrl+U, Ctrl+I, Ctrl+S and Ctrl+M formatting shortcuts in the help window; the formatted example word (bold, underlined, italics, struck through, monospaced) follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.as"
msgid "Mark all text typed after this shortcut as"
msgstr "Oznakovat všechny texty napsané po tomto klíčovém slově jako"

#. The example word shown in bold lettering in the help window's Ctrl+B formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.bold"
msgid "bold"
msgstr "tužkový"

#. Text of the link at the end of the Ctrl+K description in the help window's formatting section; it opens an external IRC color reference. Mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorHere"
msgid "here"
msgstr "zde"

#. First part of the Ctrl+K description in the help window's formatting section; a code fragment with the numeric range follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP1a"
msgid "Mark any text typed after this shortcut to be colored. After hitting this shortcut, enter an integer in the range"
msgstr "Oznakovat libovolný text napsaný po tomto klíčovém slově jako barvě. Po stisknutí tohoto klíčového slova, zadejte celé číslo v rozsahu"

#. Continuation of the Ctrl+K description in the help window's formatting section, after the code fragment with the numeric range.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP1b"
msgid "to select the desired color, or use the autocompletion menu to choose a color name (see below)."
msgstr "pro vybranou barvu, nebo použijte doporučovací menu pro vybrané barvy (doporučení níže)."

#. Start of the second paragraph of the Ctrl+K description in the help window's formatting section; a code fragment with the numeric range follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP2a"
msgid "Background color can be specified by putting a comma and another integer in the range"
msgstr "Barva pozadí může být určena zadáním čárky a dalšího celého čísla v rozsahu"

#. Continuation of the second paragraph of the Ctrl+K description in the help window's formatting section, after the code fragment with the numeric range.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorP2b"
msgid "after the foreground color number (autocompletion works too)."
msgstr "po čísle přední barvy (doporučovací menu funguje i tam)."

#. Start of the last paragraph of the Ctrl+K description in the help window's formatting section; the link text follows it. Ends mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.colorRef"
msgid "A color reference can be found"
msgstr "Referenční barva může být nalezena"

#. Heading of the formatting-shortcuts section of the help window; each row shows a key combination and the message formatting it inserts.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.heading"
msgid "Formatting Shortcuts"
msgstr "Formátování zkratky"

#. The example word shown in italics in the help window's Ctrl+I formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.italic"
msgid "italics"
msgstr "uvozovky"

#. The example word shown in a monospaced font in the help window's Ctrl+M formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.monospace"
msgid "monospaced"
msgstr ""

#. Description of the Ctrl+O formatting shortcut in the help window; it removes any formatting applied so far in the message.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.reset"
msgid "Mark all text typed after this shortcut to be reset to its original formatting."
msgstr "Zaznamenat všechny texty typované po této zkratce jako znovuformátované."

#. The example word shown with a line through it in the help window's Ctrl+S formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.strikethrough"
msgid "struck through"
msgstr "překřížené"

#. The example word shown underlined in the help window's Ctrl+U formatting description; it demonstrates the formatting. Lowercase mid-sentence.
#: client/components/Windows/Help.vue
msgctxt "help.formatting.underline"
msgid "underlined"
msgstr "podtržené"

#. Heading of the touch-gestures section of the help window; lists what swiping on the sidebar does.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.heading"
msgid "Gestures"
msgstr "Gestury"

#. Description of the single-finger swipe-left gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.hideSidebar"
msgid "Hide sidebar."
msgstr "Skrytí stránky."

#. Description of the single-finger swipe-right gesture in the help window.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.showSidebar"
msgid "Show sidebar."
msgstr "Zobrazení stránky."

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar left with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeLeft"
msgid "Single-Finger Swipe Left"
msgstr "Jednopalcový pohyb vlevo"

#. Name of the touch gesture in the help window's gestures section: swiping the sidebar right with one finger. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.swipeRight"
msgid "Single-Finger Swipe Right"
msgstr "Jednopalcový pohyb vpravo"

#. Name of the touch gesture in the help window's gestures section: swiping left with two fingers anywhere in the chat. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.twoSwipeLeft"
msgid "Two-Finger Swipe Left"
msgstr "Dvojpalcový pohyb vlevo"

#. Name of the touch gesture in the help window's gestures section: swiping right with two fingers anywhere in the chat. Its description follows.
#: client/components/Windows/Help.vue
msgctxt "help.gestures.twoSwipeRight"
msgid "Two-Finger Swipe Right"
msgstr "Dvojpalcový pohyb vpravo"

#. Label of the privacy policy link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.privacy"
msgid "Privacy policy"
msgstr "Politika ochrany osobních údajů"

#. Link beside the version number in the help window's title line; opens the changelog window. Mid-sentence between parentheses.
#: client/components/Windows/Help.vue
msgctxt "help.releaseNotesLink"
msgid "release notes"
msgstr "Poznámky k uvolnění"

#. Button of the update banner in the help window; clicking reloads the app to pick up the new build.
#: client/components/Windows/Help.vue
msgctxt "help.reload"
msgid "Reload"
msgstr "Znovu načíst"

#. Link in the help window's about section; opens the bug-report page of the app's source repository. Ellipsis is part of the copy.
#: client/components/Windows/Help.vue
msgctxt "help.reportIssue"
msgid "Report an issue…"
msgstr "Zpráva o chybě…"

#. Description of the Alt+Shift+Left keyboard shortcut in the help window; it folds the current network's channel list in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.collapseNetwork"
msgid "Collapse current network."
msgstr "Zkřížit aktuální síť."

#. Description of the Escape key in the help window; it dismisses whatever popup or editor is open, or leaves the input field.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.escape"
msgid "Close current contextual window (context menu, image viewer, topic edit, etc) and remove focus from input."
msgstr "Zavřít aktuální kontextové okno (kontextové menu, prohlížeč obrázku, editace tématy atd.) a odstranit zaměření z vstupu."

#. Description of the Alt+Shift+Right keyboard shortcut in the help window; it unfolds the current network's channel list in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.expandNetwork"
msgid "Expand current network."
msgstr "Rozšířit aktuální síť."

#. Description of the Alt+A keyboard shortcut in the help window; it jumps to the earliest conversation with unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.firstUnread"
msgid "Switch to the first window with unread messages."
msgstr "Přepnout na první okno s nečtenými zprávami."

#. Heading of the keyboard shortcuts section of the help window; each row shows the key combination and what it does.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.heading"
msgid "Keyboard Shortcuts"
msgstr "Klávesové zkratky"

#. Description of the Alt+/ keyboard shortcut in the help window; it opens this help page.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.helpMenu"
msgid "Switch to the help menu."
msgstr "Přepnout na pomůcku."

#. Description of the Alt+Shift+Down keyboard shortcut in the help window; it moves to the next network's home view in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextLobby"
msgid "Switch to the next lobby in the channel list."
msgstr "Přepnout na další lobby v seznamu kanálů."

#. Description of the Alt+Ctrl+Down keyboard shortcut in the help window; it jumps to the next conversation that has unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextUnread"
msgid "Switch to the next window with unread messages in the channel list."
msgstr "Přepnout na další okno s nečtenými zprávami v seznamu kanálů."

#. Description of the Alt+Down keyboard shortcut and of the two-finger swipe-left gesture in the help window; both move to the conversation after the current one in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.nextWindow"
msgid "Switch to the next window in the channel list."
msgstr "Přepnout na další okno v seznamu kanálů."

#. Description of the Alt+Shift+Up keyboard shortcut in the help window; it moves to the previous network's home view in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevLobby"
msgid "Switch to the previous lobby in the channel list."
msgstr "Přepnout na předchozí lobby v seznamu kanálů."

#. Description of the Alt+Ctrl+Up keyboard shortcut in the help window; it jumps to the previous conversation that has unread messages.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevUnread"
msgid "Switch to the previous window with unread messages in the channel list."
msgstr "Přepnout na předchozí okno s nečtenými zprávami v seznamu kanálů."

#. Description of the Alt+Up keyboard shortcut and of the two-finger swipe-right gesture in the help window; both move to the conversation before the current one in the sidebar.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.prevWindow"
msgid "Switch to the previous window in the channel list."
msgstr "Přepnout na předchozí okno v seznamu kanálů."

#. Description of the Alt+J keyboard shortcut in the help window; it opens or closes the search field for jumping to a conversation.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleJump"
msgid "Toggle jump to channel switcher."
msgstr "Přepnout na přepínač přesunutí do generátoru kanálů."

#. Description of the Alt+K keyboard shortcut in the help window; it switches message formatting (bold, code, spoilers) on or off.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleMarkdown"
msgid "Toggle Markdown rendering."
msgstr "Přepnout na renderování Markdown."

#. Description of the Alt+M keyboard shortcut in the help window; it opens or closes the popup listing messages that mention you.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleMentions"
msgid "Toggle recent mentions popup."
msgstr "Přepnout na popup uvedených nedávno."

#. Description of the Alt+S keyboard shortcut in the help window; it shows or hides the sidebar network list.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleSidebar"
msgid "Toggle sidebar."
msgstr "Přepnout na stránku."

#. Description of the Alt+U keyboard shortcut in the help window; it shows or hides the panel listing the channel's members.
#: client/components/Windows/Help.vue
msgctxt "help.shortcuts.toggleUserlist"
msgid "Toggle channel user list."
msgstr "Přepnout na seznam uživatelů v kanálu."

#. Purpose clause ending the first compare item of the help window's past-release list (comparing the release with the running build). Starts lowercase because it follows the link.
#: client/components/Windows/Help.vue
msgctxt "help.sinceRelease"
msgid "to see what changed since the release"
msgstr "Aby jsi viděl, co se změnilo po vydání."

#. Title of the help window: its heading, its dialog aria-label, and the accessible name of the whole page.
#: client/components/Windows/Help.vue
msgctxt "help.title"
msgid "Help"
msgstr "Pomoc"

#. Text of the banner at the top of the help window shown when a newer build of the app was published; a Reload button follows it.
#: client/components/Windows/Help.vue
msgctxt "help.updateAvailable"
msgid "New version available"
msgstr "Nová verze je dostupná"

#. Label of the network's website link in the Help window.
#: client/js/branding.ts
#: client/components/Windows/Help.vue
msgctxt "help.website"
msgid "Website"
msgstr "Webová stránka"

#. aria-label of the ✕ control of the image viewer that fills the screen; clicking closes it.
#: client/components/ImageViewer.vue
msgctxt "image.close"
msgid "Close"
msgstr "Zavřít"

#. aria-label of the forward arrow of the image viewer; clicking shows the next image from the conversation.
#: client/components/ImageViewer.vue
