#. Label of the services account (login name) text field on the connect form and on the network edit form.
#: client/components/Windows/Connect.vue:34
#: client/components/Windows/Connect.vue:213
msgctxt "connect.account"
msgid "Account"
msgstr "アカウント"

#. aria-label of the whole connect screen (the window/dialog element); announced by screen readers on arriving at the form.
