#. Name of the highest IRC channel role (the ~ prefix), filling {name} in the mode menu items such as 'Revoke {name} (-a)'. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeOwner"
msgid "owner"
msgstr "proprietar"

#. Name of the IRC voiced role (the + prefix; may speak in a moderated channel), filling {name} in the mode menu items. Lowercase mid-sentence.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.modeVoice"
msgid "voice"
msgstr "voce"

#. Context-menu item on a conversation; clicking mutes it (no highlights, no notifications from it). {type} names the kind of conversation in lowercase: 'network', 'channel' or 'conversation'.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.muteType"
msgid "Mute {type}"
msgstr "Mutează {type}"

#. Context-menu item that takes an IRC channel role away from a user; {name} is the role's name ('operator'), {mode} the mode letter with its minus sign, e.g. -o.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.revokeMode"
msgid "Revoke {name} (-{mode})"
msgstr "Revocați {name} (-{mode})"

#. Context-menu item that removes an IRC mode whose role name is unknown; {mode} is the mode letter with its minus sign, e.g. -z.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.revokeModeUnknown"
msgid "Mode -{mode}"
msgstr "Mod -{mode}"

#. Context-menu item on a conversation whose messages are muted (not highlighted, not notified); clicking unmutes it. {type} names the kind of conversation in lowercase: 'network', 'channel' or 'conversation'.
#: client/js/helpers/contextMenu.ts
msgctxt "menu.unmuteType"
msgid "Unmute {type}"
msgstr "Dese mutes {type}"

#. Context-menu item on a user (in the user list, a message or a conversation); asks the server for that user's details (real name, account, idle time).
#: client/js/helpers/contextMenu.ts
msgctxt "menu.whois"
msgid "User information"
msgstr "Informații utilizator"

#. aria-label of the hover toolbar on a chat message holding the reply, react, copy, edit and delete buttons.
#: client/components/MessageActions.vue:6
msgctxt "message.actionsToolbar"
msgid "Message actions"
msgstr "Acțiuni mesaj"

#. Short label shown for a moment over a chat message after its text or code was copied to the clipboard from the message toolbar.
#: client/components/MessageActions.vue:34
#: client/components/MessageActions.vue
msgctxt "message.copied"
msgid "Copied"
msgstr "Copiat"

#. Tooltip and aria-label of the copy button that a chat message shows when it contains code blocks; clicking copies the code to the clipboard.
#: client/components/MessageActions.vue:34
msgctxt "message.copyCode"
msgid "Copy code"
msgstr "Copiază cod"

#. Tooltip and aria-label of the message toolbar button that copies the whole message text; shown on touch devices, where the text cannot be selected. Toggles to 'Copied' after a copy.
#: client/components/MessageActions.vue
msgctxt "message.copyText"
msgid "Copy text"
msgstr "Copiază textul"

#. Label of the confirmation button in the dialog shown before a chat message is deleted.
#: client/components/MessageActions.vue:54
#: client/components/MessageActions.vue
msgctxt "message.delete"
msgid "Delete"
msgstr "Șterge"

#. Body of the confirmation dialog shown before a chat message is deleted. {who} describes whose message it is ('your message', or another user's name in the possessive), {preview} is the beginning of the message text, quoted.
#: client/components/MessageActions.vue:196
msgctxt "message.deleteConfirm"
msgid "Delete {who}? \"{preview}\""
msgstr "Șterge {who}? \"{preview}\""

#. Title of the confirmation dialog shown before a chat message is deleted, and the tooltip and aria-label of the message toolbar's delete button (a trash can) that opens it.
#: client/components/MessageActions.vue:195
#: client/components/MessageActions.vue
msgctxt "message.deleteTitle"
msgid "Delete message"
msgstr "Șterge mesaj"

#. Part of the delete-confirmation dialog's body: fills the {who} placeholder when the message to be deleted was written by someone else. {nick} is that user's name.
#: client/components/MessageActions.vue:190
msgctxt "message.deleteWhoOther"
msgid "{nick}'s message"
msgstr "{nick}'s mesaj"

#. Part of the delete-confirmation dialog's body: fills the {who} placeholder when the message to be deleted is the reader's own.
#: client/components/MessageActions.vue:189
msgctxt "message.deleteWhoSelf"
msgid "your message"
msgstr "Mesajul tău"

#. Visible text standing in for a deleted chat message when the deletion gave no reason. {nick} is the name of the user who deleted it. Square brackets are part of the copy.
#: client/components/Message.vue:333
msgctxt "message.deleted"
msgid "[Message deleted by {nick}]"
msgstr "[Mesaj șters de {nick}]"

#. Visible text standing in for a deleted chat message when the deletion gave a reason. {nick} is the name of the user who deleted it, {reason} the reason they gave. Square brackets are part of the copy.
#: client/components/Message.vue:331
msgctxt "message.deletedWithReason"
msgid "[Message deleted by {nick}: {reason}]"
msgstr "[Mesajul șters de {nick}: {reason}]"

#. Tooltip and aria-label of the pencil button in a chat message's hover toolbar, shown on your own messages; clicking starts editing that message.
#: client/components/MessageActions.vue:44
msgctxt "message.edit"
msgid "Edit"
msgstr "Editează"

#. Tooltip on the edited marker of a chat message when the time of the edit is unknown.
#: client/components/Message.vue:265
msgctxt "message.edited"
msgid "This message was edited"
msgstr "Acest mesaj a fost editat"

#. Tooltip on the edited marker of a chat message that was edited after being sent; {time} is the date and time the edit was made, already formatted in the reader's locale.
#: client/components/Message.vue:264
msgctxt "message.editedAt"
msgid "Edited {time}"
msgstr "Editat {time}"

#. Small marker shown after a chat message that was edited after being sent. Parenthesized; keep the lowercase form.
#: client/components/Message.vue:77
msgctxt "message.editedBadge"
msgid "(edited)"
msgstr "(editat)"

#. Tooltip and aria-label of a one-tap reaction button on a chat message's toolbar. {reaction} is the emoji (or word) it sends.
#: client/components/MessageActions.vue
msgctxt "message.quickReact"
msgid "React with {reaction}"
msgstr ""

#. Tooltip and aria-label of a one-tap reaction button on a chat message's toolbar when you already reacted with it; tapping takes your reaction off. {reaction} is the emoji (or word).
#: client/components/MessageActions.vue
msgctxt "message.quickRemove"
msgid "Remove {reaction}"
msgstr ""

#. Tooltip and aria-label of the smiley button in a chat message's hover toolbar; clicking opens the emoji picker to add a reaction to that message.
#: client/components/MessageActions.vue:21
msgctxt "message.react"
msgid "React"
msgstr "Reacționează"

#. Tooltip on the revealed text of a deleted chat message; clicking hides the text again.
#: client/components/Message.vue:72
msgctxt "message.redactedHide"
msgid "Click to hide again"
msgstr "Apasă pentru a ascunde din nou"

#. aria-label of the placeholder button that replaces a deleted chat message; clicking shows the deleted text.
#: client/components/Message.vue:65
msgctxt "message.redactedReveal"
msgid "Deleted message, click to reveal"
msgstr "Mesaj șters, apasă pentru a-l revela"

#. Tooltip and aria-label of the reply button in a chat message's hover toolbar; clicking starts a reply quoting that message.
#: client/components/MessageActions.vue:11
msgctxt "message.reply"
msgid "Reply"
msgstr "Răspunde"

#. aria-label of the quoted-message button on a chat message when the message being replied to is not in the loaded scrollback, so it cannot be jumped to.
#: client/components/Message.vue:294
msgctxt "message.replyMissing"
msgid "Replying to a message that is not loaded"
msgstr "Răspuns la un mesaj care nu este încă încărcat"

#. Visible text of the quoted-message button on a chat message when the message being replied to is not in the loaded scrollback; it stands in for the quoted text. Parenthesized.
#: client/components/Message.vue:53
msgctxt "message.replyUnknown"
msgid "(unknown message)"
msgstr "(mesaj necunoscut)"

#. aria-label of the small quoted-message button on a chat message that is a reply; clicking scrolls to the message being replied to. {nick} is the name of the user who wrote the quoted message, {text} its content as plain text.
#: client/components/Message.vue:291
msgctxt "message.replyingTo"
msgid "Replying to {nick}: {text}. Jump to that message."
msgstr "Răspuns la {nick}: {text}. Saltă la acel mesaj."

#. Tooltip of the small marker on a chat message that arrived while you had another channel open; the server delivered it to the active window only.
#: client/components/Message.vue:118
msgctxt "message.shownInActive"
msgid "This message was shown in your active channel"
msgstr "Acest mesaj a fost afișat în canalele active"

#. Tooltip of the small mode-prefix marker (a character such as + or @) shown before messages that the server delivered only to the part of the channel holding that status. {mode} is the mode character itself, inserted verbatim.
#: client/components/StatusmsgMarker.vue:4
msgctxt "message.statusmsg"
msgid "This message was only shown to users with {mode} mode"
msgstr "Acest mesaj a fost afișat doar utilizatorilor cu {mode} mod"

#. Tooltip of the 'CTCP' abbreviation inside the CTCP-request system message; the abbreviation itself is the protocol's name and stays verbatim.
#: client/components/MessageTypes/ctcp_request.vue
msgctxt "msg.ctcpTitle"
msgid "Client-to-client protocol"
msgstr "Protocol client-la-client"

#. System message announcing a channel's modes (324). The mode string in <b> is protocol text and stays verbatim.
#: client/components/MessageTypes/mode_channel.vue
msgctxt "msg.modeChannelIs"
msgid "Channel mode is"
msgstr "Modul canalei este"

#. System message announcing the reader's own user modes (221). The mode string in <b> is protocol text and stays verbatim.
#: client/components/MessageTypes/mode_user.vue
msgctxt "msg.modeUserIs"
msgid "Your user mode is"
msgstr "Modul tău este"

#. Lobby error when the server refused a nick as taken (433) and gave no reason of its own; shown as '<nick>: <reason>'. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.nickInUse"
msgid "Nickname is already in use."
msgstr "Numele de utilizator este deja în uz."

#. Lobby error when the server refused a nick as malformed (432) and gave no reason of its own; shown as '<nick>: <reason>'. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "msg.nickInvalid"
msgid "Nickname is invalid."
msgstr "Numele de utilizator este invalid."

#. Lobby error when a whois/whowas named a nick the server does not know; {nick} is the nick as typed, user input.
#: client/js/irc/handlers/whois.ts
msgctxt "msg.noSuchNick"
msgid "No such nick: {nick}"
msgstr "Niciun astfel de nume: {nick}"

#. System message when a user changes a channel's topic. Renders after the user's name (direction-isolated in <bdi>); the new topic is channel content and stays verbatim.
#: client/components/MessageTypes/topic.vue
msgctxt "msg.topicChanged"
msgid "has changed the topic to:"
msgstr "a schimbat subiectul în:"

#. Reply to a topic request for a channel the client is not in: the channel name and the topic itself are verbatim channel data.
#: client/js/irc/handlers/topic.ts
msgctxt "msg.topicFor"
msgid "Topic for {channel}: {topic}"
msgstr "Subiect pentru {channel}: {topic}"

#. System message announcing a channel's topic (no changer known, e.g. on join). The topic itself is channel content and stays verbatim.
#: client/components/MessageTypes/topic.vue
msgctxt "msg.topicIs"
msgid "The topic is:"
msgstr "Subiectul este:"

#. System message naming who set the topic (333). Renders before the setter's name (direction-isolated in <bdi>); the time follows through the next fragment.
#: client/components/MessageTypes/topic_set_by.vue
msgctxt "msg.topicSetBy"
msgid "Topic set by"
msgstr "Subiect setat de"

#. Topic-set-by system message, after the setter's name. {time} is the pre-formatted timestamp of when the topic was set; keep it in the position the language's preposition wants.
#: client/components/MessageTypes/topic_set_by.vue
msgctxt "msg.topicSetOn"
msgid "on {time}"
msgstr "pe {time}"

#. Channel message answering a topic request when the channel has none (331).
#: client/js/irc/handlers/topic.ts
msgctxt "msg.topicUnset"
msgid "No topic is set."
msgstr "Nu a fost setat subiect."

#. Reply to a topic request for a channel the client is not in that has no topic; {channel} is the channel name, verbatim.
#: client/js/irc/handlers/topic.ts
msgctxt "msg.topicUnsetFor"
msgid "No topic is set for {channel}."
msgstr "Nu a fost setat subiect pentru {channel}."

#. Lobby status line when your own nick change is confirmed. {nick} is the new nick, user content, never translated.
#: client/js/irc/handlers/nick.ts
msgctxt "msg.youAreKnownAs"
msgid "You're now known as {nick}"
msgstr "Ei este acum cunoscut ca {nick}"

#. Reason under 'Not sent: {message}' when a multi-line message's framing leaves no space for any text. {prefix} and {maxBytes} are byte counts.
#: client/js/irc/multiline.ts
msgctxt "multiline.noRoom"
msgid "No room for message text: {prefix} bytes of line prefix, {maxBytes} bytes per message"
msgstr "Nu există spațiu pentru textul mesajului: {prefix} byte-uri din prefix, {maxBytes} byte-uri pe mesaj END"

#. Desktop notification title when another user invites the reader to a channel; the body names the inviter and channel.
#: client/js/socket-events/msg.ts
msgctxt "notify.channelInvite"
msgid "New channel invite:"
msgstr "Nouă invitație pentru canale:"

#. Desktop notification body when another user invites the reader to a channel; {nick} and {channel} are the inviter's name and the channel name, both verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.inviteBody"
msgid "{nick} invited you to {channel}"
msgstr "{nick} îți a fost invitat la {channel}"

#. Desktop notification title for a channel event that is not a message (e.g. an action); {nick} is the sender's name and {channel} the channel name, both verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.titleChannel"
msgid "{nick} ({channel})"
msgstr "{nick} ({channel})"

#. Desktop notification title for a channel message; {nick} is the sender's name and {channel} the channel name, both verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.titleChannelSays"
msgid "{nick} ({channel}) says:"
msgstr "{nick} ({channel}) spune:"

#. Desktop notification title for a private message; {nick} is the sender's name, verbatim.
#: client/js/socket-events/msg.ts
msgctxt "notify.titleSays"
msgid "{nick} says:"
msgstr "{nick} spune:"

#. Reason fragment of 'Not sent ({reason}): {text}' when the connection dropped with the message still unconfirmed. Lowercase mid-sentence by position.
#: client/js/irc/client.ts
#: client/js/irc/pending.ts
msgctxt "pending.connectionLost"
msgid "connection lost"
msgstr "conexiune pierdută"

#. Reason fragment of 'Not sent ({reason}): {text}' when the server stayed silent for a minute. Lowercase mid-sentence by position.
#: client/js/irc/pending.ts
msgctxt "pending.noAcknowledgement"
msgid "no acknowledgement from the server"
msgstr "fără confirmare de la server"

#. Error under a message the server never confirmed. {reason} is a short cause (one of the pending.* fragments or the server's own rejection text, verbatim); {text} is the message as typed, user content, verbatim.
#: client/js/irc/pending.ts
msgctxt "pending.notSent"
msgid "Not sent ({reason}): {text}"
msgstr "Nu a fost trimis ({reason}): {text}"

#. Reason fragment of 'Not sent ({reason}): {text}' when a labelled rejection numeric names no text. {code} is the numeric, verbatim. Lowercase mid-sentence by position.
#: client/js/irc/handlers/numerics.ts
msgctxt "pending.numericError"
msgid "error {code}"
msgstr "eroare {code}"

#. Lobby passthrough of a PERSISTENCE reply the app does not otherwise understand; {params} is the server's own words, verbatim.
#: client/js/irc/handlers/persistence.ts
msgctxt "persistence.echo"
msgid "Persistence: {params}"
msgstr "Persistență: {params}"

#. Lobby status line confirming the state change the user asked for. {state} is the server's ON/OFF token, verbatim.
#: client/js/irc/handlers/persistence.ts
msgctxt "persistence.set"
msgid "Session persistence set to: {state}"
msgstr "Persistența sesiunii setată la: {state}"

#. Lobby status line reporting the bouncer session's state. {state} is the server's ON/OFF token, verbatim.
#: client/js/irc/handlers/persistence.ts
msgctxt "persistence.status"
msgid "Session persistence (the server keeps you in your channels while disconnected): {state}"
msgstr "Persistența sesiunii (serverul ține cont de canalele tale în timp ce e dezconectat): {state}"

#. Lobby status line reporting the bouncer session's state when the client's own persistence setting differs from what the server reports. {state} is the server's ON/OFF token, verbatim; {setting} is the client setting's value.
#: client/js/irc/handlers/persistence.ts:89
msgctxt "persistence.statusClientSetting"
msgid "Session persistence (the server keeps you in your channels while disconnected): {state} (your setting: {setting})"
msgstr "Persistența sesiunii (serverul ține cont de canalele tale în timp ce e dezconectat): {state} (setarea ta: {setting})"

#. Body of the push opt-in prompt; explains what allowing push does and that it is chosen per network.
#: client/components/PushPrompt.vue
msgctxt "push.enableBody"
msgid "This server can wake this app when it has messages for you while it is closed. You can change this per network, in each network's settings."
msgstr "Acest server poate avertiza această aplicație atunci când are mesaje pentru tine în timp ce este închisă. Poți schimba acest lucru pe rețea, în setările fiecărei rețele."

#. Title of the prompt shown at connect time asking whether to enable web push notifications for that chat network.
#: client/components/PushPrompt.vue
msgctxt "push.enableTitle"
msgid "Enable push notifications?"
msgstr "Activați notificările de tip push?"

#. Fallback for the network name in the push prompt's target line when no name is known for the chat network being asked about.
#: client/components/PushPrompt.vue
msgctxt "push.fallbackNetwork"
msgid "this network"
msgstr "această rețea"

#. Button of the push opt-in prompt; declines and stops the app from ever asking again for that network.
#: client/components/PushPrompt.vue
msgctxt "push.never"
msgid "Never"
msgstr "Măcar nu"

#. Button of the push opt-in prompt; declines for now without disabling future prompts.
#: client/components/PushPrompt.vue
msgctxt "push.no"
msgid "No"
msgstr "Nu"

#. Body of the push-renewal prompt; explains why the subscription broke and that re-subscribing can be done later from that network's settings.
#: client/components/PushPrompt.vue
msgctxt "push.renewBody"
msgid "This server's push key changed, so this device's push subscription for it no longer works. Subscribe again to keep being notified while the app is closed. You can also do this later from this network's settings."
msgstr "Cheia de push a serverului a fost schimbată, deci abonarea ta de tip push pentru acest server nu funcționează mai. Abonează-te din nou pentru a fi notificat în timp ce aplicația este închisă. Poți face acest lucru și mai târziu din setările acestei rețele."

#. Title of the prompt shown at connect time when a chat server's push identity (its key) changed and the device's subscription must be renewed.
#: client/components/PushPrompt.vue
msgctxt "push.renewTitle"
msgid "Renew push notifications?"
msgstr "Renovează notificările de tip push?"

#. Button of the push opt-in prompt; allows web push (the click doubles as the browser's permission gesture).
#: client/components/PushPrompt.vue
msgctxt "push.yes"
msgid "Yes"
msgstr "Da"

#. Tooltip and aria-label of the ➕ button at the end of a message's reaction row; clicking opens the emoji picker.
#: client/components/MessageReactions.vue
msgctxt "reactions.add"
msgid "Add a reaction"
msgstr "Adaugă o reacție"

#. Preview-bar hint in the emoji picker while a reaction is being composed; shift-clicking an emoji appends it instead of sending.
#: client/components/ReactionPicker.vue
msgctxt "reactions.buildingHint"
msgid "Shift-click to add more emoji"
msgstr "Apasă Ctrl+Click pentru a adăuga mai multe emoji"

#. Preview-bar title in the emoji picker while the user is composing a reaction out of several emoji or typing one.
#: client/components/ReactionPicker.vue
msgctxt "reactions.buildingName"
msgid "Building a reaction"
msgstr "Construiește o reacție"

#. aria-label of a reaction badge under a chat message. {reaction} is the emoji or word reaction, {users} the comma-joined names of who sent it.
#: client/components/MessageReactions.vue
msgctxt "reactions.by"
msgid "{reaction} by {users}"
msgstr "{reaction} de {users}"

#. Tooltip and aria-label of the ✕ button in the emoji picker's search field; clicking empties the field.
#: client/components/ReactionPicker.vue
msgctxt "reactions.clearSearch"
msgid "Clear search"
msgstr "Curăță căutarea"

#. Suffix appended to a reaction badge's aria-label when you took part in it, saying that clicking removes your reaction. Parenthesized.
#: client/components/MessageReactions.vue
msgctxt "reactions.clickToRemoveSuffix"
msgid "(click to remove yours)"
msgstr "(apasă pentru a șterge al tău)"

#. aria-label of the emoji picker popup that opens from a chat message to add a reaction to it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.dialogAria"
msgid "Add a reaction"
msgstr "Adaugă o reacție"

#. Preview-bar hint of the emoji picker when nothing is highlighted or being composed; sums up the three ways to react.
#: client/components/ReactionPicker.vue
msgctxt "reactions.emptyHint"
msgid "Pick an emoji, type a word, or shift-click to combine several."
msgstr "Alege un emoji, tipărește un cuvânt, sau apasă Ctrl+Click pentru a combina mai multe."

#. Label shown before the typed text on the emoji picker's free-text row, which sends what was typed as the reaction; the typed text follows it. Mid-sentence by position.
#: client/components/ReactionPicker.vue
msgctxt "reactions.freePrefix"
msgid "React with"
msgstr "Reacționează cu"

#. aria-label of the row of reaction badges under a chat message, listing who reacted with what.
#: client/components/MessageReactions.vue
msgctxt "reactions.groupAria"
msgid "Reactions"
msgstr "Reacțiuni"

#. Preview-bar hint in the emoji picker for a single emoji; shift-clicking another appends it to the reaction instead of sending. Keep the shift symbol.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintCombine"
msgid "⇧ to combine"
msgstr "⇧ pentru a combina"

#. Preview-bar hint in the emoji picker when the highlighted emoji is already on the message; clicking it takes the reaction back off.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintRemove"
msgid "Remove"
msgstr "Șterge"

#. Preview-bar hint in the emoji picker for a typed reaction (a word or several emoji): pressing Enter sends it.
#: client/components/ReactionPicker.vue
msgctxt "reactions.hintSend"
msgid "Enter to send"
msgstr "Enter pentru a trimite"

#. aria-label of the emoji picker's scrollable grid of emoji to pick from.
#: client/components/ReactionPicker.vue
msgctxt "reactions.listAria"
msgid "Emoji"
msgstr "Emoji"

#. Error note shown inside the emoji picker when the emoji catalog failed to download; the search field above still accepts any reaction as text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loadFailed"
msgid "The emoji list could not be loaded. You can still type a reaction above."
msgstr "Lista emoji nu a putut fi încărcată. Poți încă tipări o reacție de mai sus."

#. Note shown inside the emoji picker while its catalog is being fetched. Ellipsis is part of the copy.
#: client/components/ReactionPicker.vue
msgctxt "reactions.loading"
msgid "Loading emoji…"
msgstr "Încarc emoji…"

#. Heading of the emoji picker's list while a search matched nothing (what was typed can still be sent as a reaction).
#: client/components/ReactionPicker.vue
msgctxt "reactions.noMatch"
msgid "No emoji match"
msgstr "Nici o reacție potrivită"

#. Heading of the emoji picker's section of suggested starter reactions, shown when nothing has been used recently, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.quickReactions"
msgid "Quick reactions"
msgstr "Reacțiuni rapide"

#. Heading of the emoji picker's section of recently sent reactions, and the label of its tab.
#: client/components/ReactionPicker.vue
msgctxt "reactions.recentlyUsed"
msgid "Recently used"
msgstr "Utilizate recent"

#. Placeholder and aria-label of the emoji picker's search field; the same field doubles as the entry for a custom reaction (any text or emoji).
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchPlaceholder"
msgid "Search emoji, or type any reaction"
msgstr "Caută emoji, sau introduce o reacție"

#. Heading of the emoji picker's list while a search is showing matches.
#: client/components/ReactionPicker.vue
msgctxt "reactions.searchResults"
msgid "Search results"
msgstr "Rezultatele căutării"

#. Button in the emoji picker's preview bar; clicking sends the reaction being composed.
#: client/components/ReactionPicker.vue
msgctxt "reactions.send"
msgid "Send"
msgstr "Trimite"

#. Preview-bar note in the emoji picker for a remembered reaction that is not an emoji, saying it will be sent as words. Starts lowercase because it follows other text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.sentAsText"
msgid "sent as text"
msgstr "Trimis ca text"

#. aria-label of the row of tab buttons in the emoji picker that jumps to a group of emoji (smileys, animals, food…).
#: client/components/ReactionPicker.vue
msgctxt "reactions.tabsAria"
msgid "Emoji groups"
msgstr "Grupuri de emoji"

#. Tooltip of the emoji picker's free-text row and its spoken form, offering to send what was typed as the reaction. {reaction} is that text.
#: client/components/ReactionPicker.vue
msgctxt "reactions.titleTemplate"
msgid "React with {reaction}"
msgstr "Reacționează cu {reaction}"

#. aria-label of the magnifier button in a chat window's header; clicking it opens the message-search field for the conversation.
#: client/components/MessageSearchForm.vue:19
msgctxt "search.openForm"
msgid "Search messages in this channel"
msgstr "Caută mesajele din acest canal"

#. Placeholder of the message-search field that opens from the magnifier in a chat window's header; it filters this conversation's history.
#: client/components/MessageSearchForm.vue:10
msgctxt "search.placeholder"
msgid "Search messages…"
msgstr "Caută mesajele…"

#. aria-label of the search-results view of the chat window, which lists the messages matching a search.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.aria"
msgid "Search results"
msgstr "Rezultatele căutării"

#. Tooltip and aria-label of the ✕ button in the search-results header; clicking closes the search and returns to the conversation.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.close"
msgid "Close search window"
msgstr "Închide fereastra de căutare"

#. Shown in the search-results view when the search matched no messages.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.none"
msgid "No results found."
msgstr "Nu au fost găsite rezultate."

#. Note under the search results, explaining that the search covers only the messages currently loaded in the app, not the full history on the server. Em dash is part of the copy.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.scopeNote"
msgid "Only messages loaded in this session are searched — older history is not searched."
msgstr "Doar mesajele încărcate în această sesiune sunt căutate — istoricul mai vechi nu este căutat."

#. Second fragment of the search-results window header, rendered after the styled channel-name element; the search term itself follows the header. The element (the channel's or query window's name — user content, never translated) sits between this fragment and the one before it. Word order inside each fragment is free; the fragments cannot cross the element. Ends mid-sentence.
#: client/components/Windows/SearchResults.vue:21
msgctxt "search.results.searchingInAfter"
msgid "for"
msgstr "pentru"

#. First fragment of the search-results window header, rendered before the styled channel-name element. That element (the channel's or query window's name — user content, never translated, like a <Username>) sits between this fragment and the one after it. Word order inside each fragment is free; the fragments cannot cross the element.
#: client/components/Windows/SearchResults.vue:19
msgctxt "search.results.searchingInBefore"
msgid "Searching in"
msgstr "Căutare în"

#. Button at the top of the search results list that fetches more matches. {count} is how many further matches are available.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.showOlder"
msgid "Show older results ({count} more)"
msgstr "Arată rezultate mai vechi ({count} mai multe)"

#. Shown in the search-results view when the search field is empty; invites typing a query.
#: client/components/Windows/SearchResults.vue
msgctxt "search.results.typePrompt"
msgid "Type something to search for."
msgstr "Introdu ceva pentru a căuta."

#. Lobby error when the server never answered the redaction an edit depends on.
#: client/js/irc/client.ts
msgctxt "send.editNoReply"
msgid "Edit not sent: no reply from the server."
msgstr "Editare netrimisă: fără răspuns de la server."

#. Lobby error when a second edit of the same message was sent before the first one settled.
#: client/js/irc/client.ts
msgctxt "send.editWaiting"
msgid "Edit not sent: an edit of that message is already waiting for the server."
msgstr "Editare netrimisă: o editare a acestui mesaj a fost deja trimisă către server."

#. Lobby error when a command or message was typed while the network is down; nothing was sent.
#: client/js/irc/client.ts
#: client/js/irc/commands/index.ts:215
#: client/js/irc/commands/index.ts:224
msgctxt "send.notConnected"
msgid "You are not connected to the IRC network, unable to send your command."
msgstr "Nu ești conectat la rețeaua IRC, nu poți trimite comanda ta."

#. Lobby error when an IRC line could not be written to the socket. {message} is a technical transport error, left verbatim.
#: client/js/irc/client.ts
msgctxt "send.notSent"
msgid "Not sent: {message}"
msgstr "Netrimis: {message}"

#. Lobby error when the server's push-subscription registration line exceeds the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.pushTooLong"
msgid "Not sent: the push subscription does not fit on one line"
msgstr "Nu a fost trimis: abonamentul de tipare nu se poate afișa pe o singură linie"

#. Lobby error when a reaction was sent on a server without message-tags.
#: client/js/irc/client.ts
msgctxt "send.reactNeedsTags"
msgid "Reactions need the message-tags capability, which this server did not enable."
msgstr "Reacțiile necesită capacitatea de etichetare a mesajelor, care nu a fost activată de acest server."

#. Lobby error when a reaction was sent in a window that carries no messages.
#: client/js/irc/client.ts
msgctxt "send.reactTargets"
msgid "Reactions can only be sent in channels and queries."
msgstr "Reacțiile pot fi trimise doar în canale și într-o întrebare."

#. Lobby error when deletion was tried outside a channel.
#: client/js/irc/client.ts
msgctxt "send.redactChannels"
msgid "Messages can only be deleted in channels."
msgstr "Mesajele pot fi șterse doar în canale."

#. Lobby error when deletion was tried on a server without the redaction capability.
#: client/js/irc/client.ts
msgctxt "send.redactUnavailable"
msgid "Deleting messages is not available: the server did not enable draft/message-redaction."
msgstr "Ștergerea mesajelor nu este disponibilă: serverul nu a activat funcția de ștergere a mesajelor."

#. Lobby error when a message's client tags exceed the IRC line limit; nothing was sent.
#: client/js/irc/client.ts
msgctxt "send.tagsTooLong"
msgid "Not sent: the tags do not fit on one line"
msgstr "Nu a fost trimis: etichetele nu se pot afișa pe o singură linie"

#. Button under the alias table: appends a new, empty alias row to edit.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.add"
msgid "Add alias"
msgstr "Adaugă alias"

#. aria-label of an alias row's commands (body) input. {name} is the alias's name — or, while the name is empty, the row's number; verbatim user content either way, never translated.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyAria"
msgid "Commands for alias {name}"
msgstr "Comenzi pentru alias {name}"

#. Example body shown in the alias-body input: an IRC action waving at the first argument. Keep the /me command and the $1 token verbatim; the action wording is an example and may be adapted.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.bodyPlaceholder"
msgid "/me waves at $1"
msgstr "/me salută $1"

#. Shown in place of the alias table when no aliases are defined.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.empty"
msgid "No aliases yet."
msgstr "Încă nu există aliasuri."

#. Row error: the alias has a name but no commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorBody"
msgid "Say what the alias runs."
msgstr "Spune ce face aliasul."

#. Row error: another row already defines this alias. {name} is the other alias's name, verbatim user content; the slash before it is the command prefix.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorDuplicate"
msgid "There is already a /{name}."
msgstr "Existe deja /{name}."

#. Row error under an alias row: the alias has no name.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorName"
msgid "Give the alias a name."
msgstr "Dă-ți un nume la alias."

#. Row error: the alias name contains characters other than letters, digits, hyphen and underscore. The - and _ are literal characters, keep them.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorNameChars"
msgid "Names are letters, digits, - and _ — no spaces or slashes."
msgstr "Numele trebuie să fie litere, cifre, - și _ — fără spații sau /."

#. Row error: the body exceeds the length limit. {limit} is the maximum number of characters (a number).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.errorTooLong"
msgid "The body is too long (over {limit} characters)."
msgstr "Corpul este prea lung (mai mult de {limit} caractere)."

#. Column heading of the alias editor table: the name of the slash command being defined. The header row is aria-hidden; each input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headName"
msgid "Alias"
msgstr ""

#. Column heading of the alias editor table: the command lines the alias runs (its body). The header row is aria-hidden; the body input's own aria-label carries this meaning to screen readers.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.headRuns"
msgid "Runs"
msgstr "Rulează"

#. Joins the last two entries of the alias-body variable list ($2- or $*). Single word; the spaces around it come from the template.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.introOr"
msgid "or"
msgstr "sau"

#. Intro fragment (Settings -> Aliases): leads into the example alias invocation that follows in code style; the fragment ends where the example begins.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.introOwn"
msgid "An alias is a slash command of your own. Typing"
msgstr "Un alias este o comandă slash a ta. Tipărirea"

#. Intro fragment between the example invocation and the variable list: what defining an alias does. Sits in front of the $1 token.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.introRuns"
msgid "runs what you define here — one command per line, with the arguments filled in where the body says"
msgstr "rulează ceea ce ai definit aici — o comandă pe linie, cu argumentele completate în locul corpului"

#. aria-label of an alias row's name input. {number} is the row's position, counting from 1.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nameAria"
msgid "Alias name {number}"
msgstr "Numele de alias {number}"

#. Placeholder of the alias-name input: the alias's name goes here.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.namePlaceholder"
msgid "name"
msgstr "nume"

#. Nested-alias fragment between the two example commands: the first command can be rewritten as the second.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nestedBecomes"
msgid "can become"
msgstr "poate deveni"

#. Nested-alias fragment: aliases may call other aliases and shadow built-in commands; the two example commands follow in code style.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nestedMain"
msgid "A body line can invoke another alias, and an alias named after a built-in command replaces it —"
msgstr "O linie de corp poate invoca un alt alias, iar un alias numit după o comandă built-in îl înlocuiește —"

#. Nested-alias fragment: closes the example — shadowing a built-in does not recurse for ever.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.nestedTail"
msgid "without looping."
msgstr "fără a se cicla."

#. aria-label of the whole aliases pane (a role=group in Settings); heard by screen readers when they enter the pane.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.paneAria"
msgid "Command aliases"
msgstr "Aliase comandă"

#. Live preview: the typed text matched no alias, so it would go to the server exactly as typed.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.previewMiss"
msgid "Not an alias — this would be sent as typed."
msgstr "Nu un alias — aceasta ar fi trimisă ca și cum ar fi fost tastată."

#. aria-label of an alias row's remove button (trash icon; no visible text). {name} is the alias's name — or the row's number while the name is empty; verbatim user content.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.removeAria"
msgid "Remove alias {name}"
msgstr "Elimină alias {name}"

#. Status line when some rows have errors and are not saved yet. {count} is the number of saved aliases; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusBroken"
msgid "{count} alias saved — rows with errors are not saved."
msgid_plural "{count} aliases saved — rows with errors are not saved."
msgstr[0] "{count} alias salvat — rândurile cu erori nu sunt salvate."
msgstr[1] "{count} alese de alias salvate — rândurile cu erori nu sunt salvate."
msgstr[2] "{count} alese de alias salvate — rândurile cu erori nu sunt salvate."

#. Status line under the alias table: how many aliases are saved. {count} is the number; gettext plural, English index 0 is the singular.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.statusSaved"
msgid "{count} alias saved."
msgid_plural "{count} aliases saved."
msgstr[0] "{count} alias salvat."
msgstr[1] "{count} alese de alias salvate."
msgstr[2] "{count} alese de alias salvate."

#. Heading of the command-aliases pane in Settings, where the user defines their own slash commands.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.titleHeading"
msgid "Command aliases"
msgstr "Aliase comandă"

#. aria-label of the try-it input: type an alias invocation to preview its expansion.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryAria"
msgid "Try an alias"
msgstr "Încearcă un alias"

#. Try-it placeholder when at least one valid alias exists: an example invocation of that alias. {name} is the alias's name, verbatim; the rest is example prose.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryExample"
msgid "/{name} some arguments"
msgstr "/{name} câteva argumente"

#. Heading of the live preview: type an alias invocation and see the commands it expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.tryHeading"
msgid "Try it"
msgstr "Încearcă"

#. Variable reference: what $chan expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varChan"
msgid "the current channel or query"
msgstr "canala actuală sau interogarea"

#. Variable reference fragment: introduces the $$ escape, which follows in code style as a single dollar sign.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varLiteral"
msgid "a literal"
msgstr "o literală"

#. Variable reference: what $me expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varMe"
msgid "your nick on that network"
msgstr "nick-ul tău pe acea rețea"

#. Variable reference: what $1 expands to in an alias body.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varOne"
msgid "one argument (empty when not given)"
msgstr "un argument (vid atunci când nu este furnizat)"

#. Variable reference: what $2- expands to (everything from the second argument on).
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varRest"
msgid "arguments from the 2nd to the last"
msgstr "argumentele de la al doilea până la ultimul"

#. Variable reference: what $* expands to.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.varStar"
msgid "everything after the alias name"
msgstr "tot ce vine după numele alias-ului"

#. Heading of the variables reference: the dollar placeholders an alias body can use.
#: client/components/Settings/Aliases.vue
msgctxt "settings.aliases.variablesHeading"
msgid "Variables"
msgstr "Variabile"

#. Checkbox in Settings > Appearance; when ticked, typing in the message input suggests completions for names, emoji and commands.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.autocomplete"
msgid "Enable autocomplete"
msgstr "Activa autocompletare"

#. Checkbox in Settings > Appearance; when ticked, each user's name in chat is drawn in its own consistent color.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.coloredNicks"
msgid "Enable colored nicknames"
msgstr "Activează numele de utilizator colorat"

#. Heading of the section in Settings > Appearance holding the user's own CSS. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheet"
msgid "Custom Stylesheet"
msgstr "Fisier de stil personalizat"

#. Visually hidden label of the custom stylesheet text area in Settings > Appearance, where CSS rules overriding the app's own styles can be entered.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetHelp"
msgid "Custom stylesheet. You can override any style with CSS here."
msgstr "Fisier de stil personalizat. Poți suprascrie orice stil cu CSS aici."

#. Placeholder of the custom stylesheet text area in Settings > Appearance, written as a CSS comment. Keep the /* */ comment markers.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.customStylesheetPlaceholder"
msgid "/* You can override any style with CSS here */"
msgstr "/* Poți suprascrie orice stil cu CSS aici */"

#. aria-label of the slider in Settings > Appearance that changes the size of chat text and the interface with it.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeAria"
msgid "Message font size"
msgstr "Mărimea font-ului mesaj"

#. Heading of the text size control in Settings > Appearance; a slider that scales the whole interface.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.fontSizeHeading"
msgid "Font size"
msgstr "Mărimea font-ului"

#. Label of the largest step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:458
msgctxt "settings.appearance.fontSizeHuge"
msgid "Huge"
msgstr "Înalt"

#. Label of the default step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:456
msgctxt "settings.appearance.fontSizeLarge"
msgid "Large"
msgstr "Mare"

#. Label of the middle step of the font-size slider in Settings → Appearance: the browser's default size. One word.
#: client/components/Settings/Appearance.vue:455
msgctxt "settings.appearance.fontSizeMedium"
msgid "Medium"
msgstr "Mediu"

#. Label of the second step of the font-size slider in Settings → Appearance. One word.
#: client/components/Settings/Appearance.vue:454
msgctxt "settings.appearance.fontSizeSmall"
msgid "Small"
msgstr "Mic"

#. Label of the smallest step of the font-size slider in Settings → Appearance: the datalist stop and the value shown while dragging. One word.
#: client/components/Settings/Appearance.vue:453
msgctxt "settings.appearance.fontSizeTiny"
msgid "Tiny"
msgstr "Foarte mic"

#. Label of the second-largest step of the font-size slider in Settings → Appearance.
#: client/components/Settings/Appearance.vue:457
msgctxt "settings.appearance.fontSizeXlarge"
msgid "Extra large"
msgstr "Extra mare"

#. Checkbox in Settings > Appearance; when ticked, chat messages are rendered with Markdown styling such as bold text, code blocks and spoiler marks. Ellipsis is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.markdown"
msgid "Render Markdown formatting (bold, code, spoilers…)"
msgstr "Renderizează formatarea Markdown (greșelile, codul, spoilerurile...)"

#. Checkbox in Settings > Appearance; when ticked, links to media are shown as an inline playable preview inside the chat instead of a plain link.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.media"
msgid "Preview images, video and audio links inline"
msgstr "Prevede imaginile, videoclipurile și linkurile audio inline"

#. Radio option in Settings > Appearance; media previews load on their own as soon as a message contains one, which exposes your address to the media site. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaAlways"
msgid "Show automatically — the media site sees your address as soon as a link appears"
msgstr "Arată automat — site-ul de medii vede adresa ta imediat când apare un link"

#. Radio option in Settings > Appearance; media previews stay behind a placeholder until you click them, so nothing is loaded from the media site before that. Em dash is part of the copy.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaClick"
msgid "Click to reveal — nothing is fetched from the media site until you ask to see it"
msgstr "Click pentru a revela — nimic nu este încărcat de la site-ul de medii până când îți ceri să-l vezi"

#. Heading of the media preview section in Settings > Appearance, which controls how links to images, video and audio are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaHeading"
msgid "Media previews"
msgstr "Prevederi media"

#. Visually hidden group label of the two radio choices in Settings > Appearance that decide when media previews are fetched from their site.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.mediaRevealGroup"
msgid "When to load previews"
msgstr "Când să încarcă prevederile"

#. Heading of the message display section in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.messagesHeading"
msgid "Messages"
msgstr "Mesajele"

#. Expansion of the acronym MOTD, shown as the abbreviation's hover tooltip on the Message Of The Day checkbox in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.motdTitle"
msgid "Message Of The Day"
msgstr "Mesajul zilei"

#. Label of the text field in Settings > Appearance that sets the character(s) inserted after a completed user's name, for example a comma.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfix"
msgid "Nick autocomplete postfix"
msgstr "Postfix autocompletare pentru nick"

#. Tooltip on the nick autocomplete postfix field in Settings > Appearance; explains what the field sets.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixHelp"
msgid "Nick autocomplete postfix (for example a comma)"
msgstr "Postfix autocompletare pentru nick (de exemplu o virgulă)"

#. Placeholder of the nick autocomplete postfix field in Settings > Appearance; keep the example punctuation (the quoted comma) as it shows what would be typed.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.nickPostfixPlaceholder"
msgid "Nick autocomplete postfix (e.g. ', ')"
msgstr "Postfix autocompletare pentru nick (de exemplu ', ')"

#. Settings → Appearance → Your own messages, radio option: your own messages sit on a lighter or darker background band.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesBand"
msgid "Highlighted row"
msgstr ""

#. Settings → Appearance → Your own messages, lowercase hint after the 'Highlighted row' option (a dash is drawn before it).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesBandHint"
msgid "the row on a lighter or darker band, the text like everyone else's"
msgstr ""

#. Settings → Appearance, heading of the radio group choosing how the user's own chat messages are told apart from everyone else's.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesHeading"
msgid "Your own messages"
msgstr ""

#. Settings → Appearance → Your own messages, radio option: your own messages' text is drawn in the muted grey colour.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesMuted"
msgid "Greyed text"
msgstr ""

#. Settings → Appearance → Your own messages, lowercase hint after the 'Greyed text' option (a dash is drawn before it). 'as before' = this is how the app always looked.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesMutedHint"
msgid "the text in the muted colour, as before"
msgstr ""

#. Settings → Appearance → Your own messages, radio option: your own messages look exactly like other people's.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesPlain"
msgid "Same as everyone else's"
msgstr ""

#. Settings → Appearance → Your own messages, lowercase hint after the 'Same as everyone else's' option (a dash is drawn before it); 'them' = your own messages.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.ownMessagesPlainHint"
msgid "nothing marks them"
msgstr ""

#. Third line of the sample chat under the font-size slider in Settings → Appearance: the extreme steps are intentionally unusable.
#: client/components/Settings/Appearance.vue:486
msgctxt "settings.appearance.sampleEnds"
msgid "The ends are meant to be too small and too big."
msgstr "Capetele sunt intenționate să fie prea mici și prea mari."

#. First line of the sample chat under the font-size slider in Settings → Appearance, written by the sample nick grandma: it asks whether the text is comfortable to read.
#: client/components/Settings/Appearance.vue:474
msgctxt "settings.appearance.sampleGlasses"
msgid "Can you read this without your glasses?"
msgstr "Poți citi acest lucru fără ochelari?"

#. Second line of the sample chat under the font-size slider in Settings → Appearance, the reply telling the reader to drag the slider until the text is comfortable.
#: client/components/Settings/Appearance.vue:480
msgctxt "settings.appearance.sampleSlide"
msgid "Yes! Slide it until this is comfortable."
msgstr "Da! Înclină-l până când este confortabil."

#. First word of the checkbox label in Settings > Appearance that displays the server's Message Of The Day; the untranslated acronym 'MOTD' follows it as a marked abbreviation, so only this word is translated.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showMotd"
msgid "Show"
msgstr "Arată"

#. Checkbox in Settings > Appearance; when ticked, message timestamps include the seconds as well as hours and minutes.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.showSeconds"
msgid "Include seconds in timestamp"
msgstr "Incluzi secunde în timestamp"

#. Radio option in Settings > Appearance; joins and parts are compressed into one summary line to keep the chat short.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusCondensed"
msgid "Condense status messages together"
msgstr "Condensează mesajele de stare"

#. Heading of the section in Settings > Appearance that controls how join, part and similar service notices are shown in chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHeading"
msgid "Status messages"
msgstr "Mesaje de stare"

#. Tooltip on the status messages heading in Settings > Appearance; lists the kinds of notices meant (people joining or leaving, being removed, renaming, and permission changes).
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHelp"
msgid "Joins, parts, quits, kicks, nick changes, and mode changes"
msgstr "Alinieri, părăsiri, părăsiri, kick-uri, schimbări de nick, și schimbări de mod"

#. Radio option in Settings > Appearance; joins, parts and similar service notices are not shown at all.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusHidden"
msgid "Hide all status messages"
msgstr "Ascunde toate mesajele de stare"

#. Radio option in Settings > Appearance; every join, part or similar notice appears as its own line in the chat.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.statusShown"
msgid "Show all status messages individually"
msgstr "Arată toate mesajele de stare individual"

#. Heading of the theme section in Settings > Appearance, and the visually hidden label of the theme dropdown beneath it; picks the color scheme of the app.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.theme"
msgid "Theme"
msgstr "Temă"

#. The name of the button on a media preview that marks its site, sender or channel as always allowed to load; the words appear quoted inside the always-shown list's help sentence in Settings > Appearance.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedButtonName"
msgid "Always show"
msgstr "Arată întotdeauna"

#. Subheading in the always-shown media list of Settings > Appearance above the chat channel entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedChannels"
msgid "Channels"
msgstr "Canale"

#. Button in Settings > Appearance beside the always-shown list heading; clicking removes every entry from that list.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedClear"
msgid "Clear all"
msgstr "Curățe tot"

#. Shown under the always-shown media list in Settings > Appearance when it has no entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedEmpty"
msgid "Nothing yet."
msgstr "Încă nimic."

#. Heading of the list in Settings > Appearance of sites, people and channels whose media always loads without asking.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHeading"
msgid "Always shown"
msgstr "Tot afișat"

#. First part of the help line under the always-shown list in Settings > Appearance; the second part and the words 'Always show' (the name of the button on any media preview) follow it. Ends mid-sentence.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHelpA"
msgid "Media in these scopes loads without asking. Add one with"
msgstr "Medii în aceste scope încarcă fără a cere. Adaugă unul cu"

#. Last part of the help line under the always-shown list in Settings > Appearance, after the words 'Always show' marking the preview button's name. Ends the sentence.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedHelpB"
msgid "on any preview."
msgstr "pe orice previzualizare."

#. Subheading in the always-shown media list of Settings > Appearance above the user account entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedPeople"
msgid "People"
msgstr "Oameni"

#. Subheading in the always-shown media list of Settings > Appearance above the website entries.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.trustedSites"
msgid "Sites"
msgstr "Site-uri"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a website or a person. {name} is that site's host or the person's name. Clicking stops their media from loading automatically.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustFrom"
msgid "Stop always showing from {name}"
msgstr "Opriți afișarea constantă din {name}"

#. Tooltip and aria-label of the remove button on an entry of the always-shown media list in Settings > Appearance, for a chat channel. {name} is that channel's name.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.untrustIn"
msgid "Stop always showing in {name}"
msgstr "Opriți afișarea constantă în {name}"

#. Checkbox in Settings > Appearance; when ticked, message timestamps use a 12-hour clock (am/pm) instead of a 24-hour clock.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.use12hClock"
msgid "Use 12-hour timestamps"
msgstr "Folosiți orele 12"

#. Heading of the section in Settings > Appearance holding readability helpers such as nickname colors and autocomplete. Keep the capitalization style of the source if possible.
#: client/components/Settings/Appearance.vue
msgctxt "settings.appearance.visualAids"
msgid "Visual Aids"
msgstr "Ajutor vizual"

#. Heading of the away section in Settings > General, and the visually hidden label of the away-message input beneath it; names the setting that marks you away with a message when the app is closed.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayHeading"
msgid "Automatic away message"
msgstr "Mesaj automat de lipsă"

#. Placeholder of the away-message field in Settings > General; shows the message that is sent automatically while the app is not open. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.awayPlaceholder"
msgid "Away message if {appName} is not open"
msgstr "Mesaj de lipsă dacă {appName} nu este deschis"

#. Sentence shown in the restore-confirmation dialog in Settings > General, saying when the backup file was made. {date} is that day written out in the reader's language (e.g. 9 September 2026). A whole sentence: the dialog puts the separating space in.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupExported"
msgid "Exported {date}."
msgstr "Exportat {date}."

#. Body of the confirmation dialog before restoring a settings backup in Settings > General. {parts} is a comma-joined list ('your settings, 1 network, mutes and ignore lists'), {file} the chosen backup file's name.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupFrame"
msgid "This replaces {parts} with the contents of {file}, then reloads."
msgstr "Aceasta înlocuiește {parts} cu conținutul fișierului {file}, apoi se reîncarcă."

#. Heading of the settings backup section in Settings > General, which exports preferences to a file and restores them.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupHeading"
msgid "Backup and restore"
msgstr "Backup și restabilire"

#. Intro line under the Backup and restore heading in Settings > General; says what exporting does.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupIntro"
msgid "Save your settings to a file. You can restore here or on another device."
msgstr "Salvați setările dumneavoastră într-un fișier. Poți restabili aici sau pe un alt dispozitiv."

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for muted users and ignored users. Comma-joined by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupMutes"
msgid "mutes and ignore lists"
msgstr "Mute și liste de ignorare"

#. Part of the settings-restore confirmation in Settings > General; fills the list of what a restore replaces with how many saved chat networks the file carries. The singular shows with exactly one network, the plural otherwise.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupNetworks"
msgid "{count} network"
msgid_plural "{count} networks"
msgstr[0] "{count} rețea"
msgstr[1] "{count} rețele"
msgstr[2] "{count} rețele"

#. Part of the restore-confirmation sentence in Settings > General: fills the list of what the file replaces for the app's own preferences. Comma-joined with the other parts by position.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPartSettings"
msgid "your settings"
msgstr "setările dumneavoastră"

#. Sentence shown in the restore-confirmation dialog in Settings > General when the backup file contains saved network passwords. It is a whole sentence: the dialog puts the separating space in, so the translation needs no padding of its own.
#: client/components/Settings/General.vue
msgctxt "settings.general.backupPasswords"
msgid "The file includes network passwords."
msgstr "Fișierul include parolele de rețea."

#. Button in Settings > General; downloads the settings backup file to the device. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.export"
msgid "Export settings…"
msgstr "Exportare setări…"

#. Error message in Settings > General shown when exporting the settings backup failed and no file was produced.
#: client/components/Settings/General.vue
msgctxt "settings.general.exportFailed"
msgid "Couldn't create the file."
msgstr "Nu s-a putut crea fișierul."

#. Visually hidden but screen-reader-spoken label of the hidden file picker behind the Import settings button; it accepts a previously exported settings file.
#: client/components/Settings/General.vue
msgctxt "settings.general.fileAria"
msgid "Settings file to restore"
msgstr "Fișier setări pentru restabilire"

#. Button in Settings > General; opens a file picker to restore a previously exported settings backup file. Ellipsis is part of the copy.
#: client/components/Settings/General.vue
msgctxt "settings.general.import"
msgid "Import settings…"
msgstr "Importare setări…"

#. Confirmation button of the settings-restore dialog in Settings > General; clicking restores the file and reloads the app.
#: client/components/Settings/General.vue
msgctxt "settings.general.importButton"
msgid "Import and reload"
msgstr "Importare și reîncărcare"

#. Error notice under the import control in Settings → General when the backup file is corrupt or truncated. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importDamaged"
msgid "This file is damaged."
msgstr "Acest fișier este corupt."

#. Error message in Settings > General shown when the chosen file could not be read as a settings backup.
#: client/components/Settings/General.vue
msgctxt "settings.general.importFailed"
msgid "Couldn't read the file."
msgstr "Nu se poate citi fișierul."

#. Error notice under the import control in Settings → General when the backup was written by a newer build of the app that this one cannot read. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNewer"
msgid "This file was made by a newer version."
msgstr "Acest fișier a fost creat de o versiune mai nouă."

#. Error notice under the import control in Settings → General when the browser lacks the DecompressionStream API the compressed backup needs. Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNoDecompression"
msgid "This browser can't read compressed files."
msgstr "Această navigare nu poate citi fișiere comprimate."

#. Error notice under the import control in Settings → General when the chosen file is not a settings backup (wrong shape, unparseable). Starts a short sentence.
#: client/components/Settings/General.vue:259
msgctxt "settings.general.importNotSettings"
msgid "This isn't a settings file."
msgstr "Acesta nu este un fișier de setări."

#. Title of the confirmation dialog shown before a settings backup file is restored from Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.importTitle"
msgid "Import settings?"
msgstr "Importare setări?"

#. Checkbox in Settings > General's backup section; when ticked, the exported settings file also contains the saved chat network passwords.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswords"
msgid "Include network passwords"
msgstr "Incluzi parolile de rețea"

#. Tooltip on the include-network-passwords checkbox in Settings > General; warns that the export keeps passwords in plain text.
#: client/components/Settings/General.vue
msgctxt "settings.general.includePasswordsHelp"
msgid "Passwords are stored in the file unencrypted."
msgstr "Parolile sunt stocate în fișier fără criptare."

#. Button in Settings > General; clicking shows the browser's prompt that installs this web app to the device's home screen or app list. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.installApp"
msgid "Install {appName} as an app"
msgstr "Instalați {appName} ca aplicație"

#. Heading of the Native app section in Settings > General; groups the install and link-handler options for using the chat app as an installed application.
#: client/components/Settings/General.vue
msgctxt "settings.general.nativeApp"
msgid "Native app"
msgstr "Aplicație nativă"

#. Button in Settings > General; registers this web app as the handler for web+irc:// chat links so clicking one anywhere opens it in the app. Keep the web+irc:// scheme verbatim. {appName} is the chat app's display name.
#: client/components/Settings/General.vue
msgctxt "settings.general.openLinks"
msgid "Open web+irc:// links with {appName}"
msgstr "Deschide linkuri web+irc:// cu {appName}"

#. Checkbox in Settings > General; when ticked, other people in the channel are told while you are typing a message.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTyping"
msgid "Send typing notifications"
msgstr "Notificări de tipare"

#. Tooltip on the send-typing-notifications checkbox in Settings > General; mentions the IRCv3 +typing tag in parentheses.
#: client/components/Settings/General.vue
msgctxt "settings.general.sendTypingHelp"
msgid "Lets people in the channel see when you are typing (IRCv3 +typing)."
msgstr "Lasă oamenii din canal să vadă când tipi (IRCv3 +typing)."

#. Heading of the typing indicator section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.typingHeading"
msgid "Typing notifications"
msgstr "Notificări de tipare"

#. Checkbox in Settings > General. When ticked, images are re-drawn through a canvas before they are sent to the chat server, which strips photo metadata such as camera model and GPS location. Affects image uploads only.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvas"
msgid "Attempt to remove metadata from images before uploading"
msgstr "Încearcă să elimini metadatele din imagini înainte de încărcare"

#. Tooltip on the metadata-removal upload checkbox in Settings > General; explains how the option works and that it can mis-rotate photos in browsers without canvas orientation support.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadCanvasHelp"
msgid "This option renders the image into a canvas element to remove metadata from the image. This may break orientation if your browser does not support that."
msgstr "Opțiunea aceasta transformă imaginea într-un element canvas pentru a elimina metadatele din imagine. Aceasta poate ruina orientarea dacă browserul nu suportă aceasta."

#. Heading of the file upload options section in Settings > General.
#: client/components/Settings/General.vue
msgctxt "settings.general.uploadsHeading"
msgid "File uploads"
msgstr "Încărcare fișiere"

#. The first option of the interface-language picker: the language the browser asks for is used. {language} is that language's name, written in itself.
#: client/components/LanguageSelect.vue
msgctxt "settings.locale.auto"
msgid "System default ({language})"
msgstr "Domeniu sistem ({language})"

#. Button on the networks settings page; opens the connect form to set up a new chat network connection.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.add"
msgid "Add network"
msgstr "Adaugă rețea"

#. Button on a saved network row in the networks settings page while that network is offline; clicking dials the chat network again.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connect"
msgid "Connect"
msgstr "Conectează-te"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is up.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connected"
msgid "Connected"
msgstr "Conectat"

#. Status label on a saved network row in the networks settings page, and the caption of the same row's button, while the connection to that chat network is being established. Ellipsis is part of the copy.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.connecting"
msgid "Connecting…"
msgstr "Se conectează…"

#. Button on a saved network row in the networks settings page; opens a confirmation before the saved network is removed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.delete"
msgid "Delete"
msgstr "Șterge"

#. Confirmation button of the dialog that removes a saved chat network.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteButton"
msgid "Delete network"
msgstr "Șterge rețea"

#. Body of the confirmation dialog before removing a saved chat network; explains what the deletion does.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteText"
msgid "This removes the saved network and disconnects it if it is running."
msgstr "Aceasta șterge rețeaua salvată și o dezconectează dacă este în execuție."

#. Title of the confirmation dialog before removing a saved chat network. {name} is the network's display name.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.deleteTitle"
msgid "Delete {name}?"
msgstr "Șterge {name}?"

#. Status label on a saved network row in the networks settings page; the connection to that chat network is down.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.disconnected"
msgid "Disconnected"
msgstr "Deconectat"

#. Button on a saved network row in the networks settings page; opens the form where that network's address and credentials are changed.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.edit"
msgid "Edit"
msgstr "Editează"

#. Empty state of the networks settings page, shown when no chat network has been saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.empty"
msgid "No networks saved yet."
msgstr "Nici o rețea salvată încă."

#. Heading of the networks page in the chat app's settings, which lists the IRC network connections saved in this browser.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.heading"
msgid "Networks"
msgstr "Rețea"

#. Line under the Networks heading in the settings, saying what the page is for.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.intro"
msgid "Manage the IRC networks saved in this browser."
msgstr "Managementul rețelelor IRC salvate în acest browser."

#. Button on a saved network row in the networks settings page while that network is connected; clicking opens the network's chat view.
#: client/components/Settings/Networks.vue
msgctxt "settings.networks.open"
msgid "Open"
msgstr "Deschide"

#. Warning line in Settings > Notifications when notification permission has been denied in the browser.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserBlocked"
msgid "Notifications are blocked by your browser."
msgstr "Notificările sunt blocate de către browser."

#. Heading of the section in Settings > Notifications about the browser's own notifications while the app is open.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserHeading"
msgid "Browser Notifications"
msgstr "Notificări browser"

#. Intro line of the browser notifications section in Settings > Notifications; the quoted phrase names the toggle in each network's edit form. Keep the curly quotes.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserPerNetwork"
msgid "Browser notifications are also per network — enabled by default, toggled in each network's settings (Edit network → “Browser notifications for this network”)."
msgstr "Notificările browser sunt, de asemenea, per rețea — activate implicit, și pot fi schimbate în setările fiecărei rețea (Editează rețea → „Notificări browser pentru această rețea”)."

#. Warning line in Settings > Notifications when the browser cannot show notifications at all.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.browserUnsupported"
msgid "Notifications are not supported by your browser."
msgstr "Notificările nu sunt suportate de către browser."

#. Placeholder of the custom-highlights and highlight-exceptions fields in Settings > Notifications; shows the expected input format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.commaList"
msgid "Comma-separated, e.g.: word, some more words, anotherword"
msgstr "Separare prin virgulă, de exemplu: cuvânt, alte cuvinte, altcuvânt"

#. Checkbox in Settings > Notifications; when ticked, messages mentioning you are drawn with a colored background and can notify.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlight"
msgid "Highlight messages that mention you"
msgstr "Marcați mesajele care menționează pe voi"

#. Label of the text field in Settings > Notifications for words that suppress highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptions"
msgid "Highlight exceptions"
msgstr "Excepții de marcat"

#. Tooltip on the highlight-exceptions field in Settings > Notifications; explains that these words suppress highlight treatment.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightExceptionsHelp"
msgid "If a message contains any of these comma-separated expressions, it will not trigger a highlight even if it contains your nickname or expressions defined in custom highlights."
msgstr "Dacă un mesaj conține orice dintre aceste expresii separate prin virgulă, nu va declanșa un marcat, chiar dacă conține numele tău de șofer sau expresii definite în marcatul personal."

#. Tooltip on the highlight checkbox in Settings > Notifications; explains the visual effect of highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightHelp"
msgid "Messages that mention you or match a custom highlight get a colored background and border in the channel."
msgstr "Mesajele care menționează pe voi sau se potrivesc unui marcat personal primesc un fundal și o margine colorate în canal."

#. Label of the text field in Settings > Notifications for extra words that count as mentions of you.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlights"
msgid "Custom highlights"
msgstr "Marcat personal"

#. Tooltip on the custom highlights field in Settings > Notifications; explains the field's comma-separated format.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.highlightsHelp"
msgid "If a message contains any of these comma-separated expressions, it will trigger a highlight."
msgstr "Dacă un mesaj conține orice dintre aceste expresii separate prin virgulă, va declanșa un marcat."

#. Warning line in Settings > Notifications, shown on an iPhone browsing the app without installing it; the parenthesized phrase is the iOS share menu's action.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.iosNotInstalled"
msgid "On iOS, push notifications are only available after installing the app to the Home Screen (Share → Add to Home Screen)."
msgstr "Pe iOS, notificările pe push sunt disponibile doar după ce aplicația a fost instalată pe ecranul principal (Împarte → Adaugă pe ecranul principal)."

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: show a confirmation prompt before the device re-subscribes. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeAsk"
msgid "Wary — ask before renewing the subscription"
msgstr "Atentă — întreabă înainte de a renova abonamentul"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: do nothing, so push stays off for that server until renewed from its network settings. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIgnore"
msgid "Suspicious — leave it alone; push from that server stays off until you renew from the network settings"
msgstr "Suspecțioasă — lasă-o în liniște; notificările de pe server rămân dezactivate până când le renovezi din setările rețelei"

#. Heading-like line in Settings > Notifications introducing the three radio choices for what to do when a chat server's push identity changes; the colon leads into the choices.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeIntro"
msgid "When a server's push identity (its key) changes, this device's subscription for it stops working. Then:"
msgstr "Când identitatea push a unui server (cheia sa) se schimbă, abonamentul acestui dispozitiv pentru el deja nu funcționează. Apoi:"

#. Radio choice in Settings > Notifications for the server's push-identity change behaviour: re-subscribe immediately and silently. Em dash is part of the copy.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.keyChangeTrust"
msgid "Naive — renew it on the spot, without asking"
msgstr "Naivă — renuvață-o imediat, fără a întreba"

#. Warning line in Settings > Notifications when the page is not served over a secure connection, which browsers require for notifications.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.noHttps"
msgid "Notifications are only supported over HTTPS connections."
msgstr "Notificările sunt suportate doar prin conexiuni HTTPS."

#. Checkbox in Settings > Notifications; when ticked, every chat message notifies, not only mentions and highlights.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.notifyAll"
msgid "Enable notification for all messages"
msgstr "Activează notificările pentru toate mesajele"

#. Button in Settings > Notifications beside the notification-sound checkbox; clicking plays the notification sound once as a preview.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.playSound"
msgid "Play sound"
msgstr "Jucă sound"

#. Warning line in Settings > Notifications when the chat server refused the push subscription; SASL (the IRC login mechanism) stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushBlocked"
msgid "The server refused the push subscription. It may require logging in (SASL) before subscribing."
msgstr "Serverul a refuzat abonamentul push. Poate necesita autentificare (SASL) înainte de a se abona."

#. Warning line in Settings > Notifications when notification permission was denied; points at the browser's site settings to re-enable.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushDenied"
msgid "Notifications are blocked by your browser. Allow them in the browser's site settings, then try again."
msgstr "Notificările sunt blocate de browser. Allow-le în setările site-ului browser, apoi încearcă din nou."

#. Heading of the push notification section in Settings > Notifications; push wakes the app on new messages while it is closed.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushHeading"
msgid "Push Notifications"
msgstr "Notificări pe push"

#. Intro line of the push section in Settings > Notifications; explains that push is enabled per chat network from that network's edit form (the quoted phrase names that setting) and that each server decides whether to support it. Keep the curly quotes and the arrow.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.pushPerNetwork"
msgid "Push is set up per network — turn it on or off in each network's settings (Edit network → “Push notifications for this network”), where the enrollment status is also shown. The browser delivers the notifications; each push-capable server decides whether to wake this app."
msgstr "Push este configurat pe rețea — activă sau dezactivează-l în setările fiecărei rețele (Editează rețea → „Notificări pe push pentru această rețea”), unde și starea de înscriere este afișată. Navigatoarea trimite notificările; fiecare server capabil cu push decide dacă trece aplicația."

#. Warning line in Settings > Notifications when the chat server itself does not offer web push; names the IRCv3 draft/webpush capability, which stays verbatim.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.serverUnsupported"
msgid "Push notifications need a connected server that supports the draft/webpush capability and you to be logged in to an account."
msgstr "Notificările pe push necesită un server conectat care suportă capacitatea draft/webpush și faptul că ai fi autentificat într-un cont."

#. Snooze button in Settings > Notifications; pauses push notifications for fifteen minutes.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snooze15"
msgid "15 min"
msgstr "15 minute"

#. Snooze button in Settings > Notifications; pauses push notifications for eight hours.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snooze480"
msgid "8 hours"
msgstr "8 ore"

#. Snooze button in Settings > Notifications; pauses push notifications for one hour.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snooze60"
msgid "1 hour"
msgstr "1 oră"

#. Lead-in above the snooze buttons in Settings > Notifications, shown while push is enabled; the buttons pause push notifications for all networks. Keep the trailing colon.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snoozeIntro"
msgid "Snooze pushes everywhere:"
msgstr "Snooze notificările pe tot locul:"

#. Snooze button in Settings > Notifications; ends the pause and resumes push notifications immediately.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.snoozeOff"
msgid "Off"
msgstr "Of"

#. Checkbox in Settings > Notifications; when ticked, a sound plays alongside a notification.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.sound"
msgid "Enable notification sound"
msgstr "Activează sunetul notificărilor"

#. Warning line in Settings > Notifications shown after a chat server changed its push identity; tells the reader to re-subscribe from that network's edit form, whose control is named in the quoted phrase.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.stale"
msgid "A server's push identity (its key) changed, so this device's push subscription for it no longer works. Renew it from that network's settings (Edit network → “Renew push notifications”) to keep being notified while the app is closed."
msgstr "Identitatea serverului a fost actualizată, deci abonamentul pentru notificări push nu funcționează mai. Renuți-l din setările rețelei (Editare rețea → „Renuți notificări push”) pentru a rămâne notificat în timp ce aplicația este închisă."

#. Warning line in Settings > Notifications when the browser cannot do web push; the parentheses name the browser features push requires.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.unsupported"
msgid "Push notifications are not supported by this browser (they need the Push API, a service worker and a secure context)."
msgstr "Notificările de tip push nu sunt suportate de acest browser (au nevoie de API-ul Push, un worker de servicii și un context sigur)."

#. Word rendered bold at the start of several warning lines in Settings > Notifications (push and browser notification problems); a colon follows it.
#: client/components/Settings/Notifications.vue
msgctxt "settings.notifications.warning"
msgid "Warning"
msgstr "Avertizare"

#. Label of the Settings modal's Aliases tab (tab strip); switching tabs navigates to the Aliases settings pane.
#: client/components/Settings/Navigation.vue
#: client/components/Settings/SettingTabItem.vue
msgctxt "settings.tabs.aliases"
