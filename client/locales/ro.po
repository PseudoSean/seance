msgctxt "send.editWaiting"
msgid "Edit not sent: an edit of that message is already waiting for the server."
msgstr "Editare netrimisă: o editare a acestui mesaj a fost deja trimisă către server."

#: client/js/irc/client.ts
#: client/js/irc/commands/index.ts:215
#: client/js/irc/commands/index.ts:224
#. Lobby error when a command or message was typed while the network is down; nothing was sent.
msgctxt "send.notConnected"
