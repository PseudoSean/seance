#: client/components/Windows/Changelog.vue
#. Text of the link in the changelog window that opens the list of every release.
msgctxt "windows.changelog.allReleasesLink"
msgid "see all releases"
msgstr "vedere toate release-urile"

#: client/components/Windows/Changelog.vue
#. aria-label of the changelog window, which shows the app's release notes.
msgctxt "windows.changelog.aria"
msgid "Changelog"
msgstr "Changelog"

#: client/components/Windows/Changelog.vue
#. Link at the top of the changelog window that goes back to the help page; the left double angle quote is part of the copy.
msgctxt "windows.changelog.back"
msgid "« Help"
msgstr "« Ajutor"

#: client/components/Windows/Changelog.vue
#. Word inside the link of the changelog's past-release sentence: the linked text names the source code commit the running build was made from; the commit hash follows it. Mid-sentence.
msgctxt "windows.changelog.commitLink"
msgid "commit"
msgstr "commit"

#: client/components/Windows/Changelog.vue
#. First sentence of the paragraph in the changelog window that says the release notes are read online; the following words are the two links.
msgctxt "windows.changelog.notBundled"
msgid "Release notes are not bundled with the build."
msgstr "Notițe de release nu sunt incluse în build."

#: client/components/Windows/Changelog.vue
#. Word joining the two links of the changelog window's last paragraph (the release notes and the list of all releases). Mid-sentence.
msgctxt "windows.changelog.or"
msgid "or"
msgstr "sau"

#: client/components/Windows/Changelog.vue
#. Start of the sentence in the changelog window shown when the running build is newer than its release; what follows names the source commit and the changes since the release. Ends mid-sentence.
msgctxt "windows.changelog.pastRelease"
msgid "This build is"
msgstr "Această versiune este"

#: client/components/Windows/Changelog.vue
#. Middle of the changelog's past-release sentence, after the link naming the source commit; introduces the link that lists what changed since the release. {version} is the release number the build follows. Keep the comma, colon and the v.
msgctxt "windows.changelog.pastReleaseAfter"
msgid ", after v{version}:"
msgstr ", după v{version}:"

#: client/components/Windows/Changelog.vue
#. Text of the link in the changelog window that opens the release notes for this release. {version} is the release number, with the v as in the source.
msgctxt "windows.changelog.readNotesLink"
msgid "Read the notes for v{version}"
msgstr "Citeste notițele pentru v{version}"

#: client/components/Windows/Changelog.vue
#. Text of the link in the changelog's past-release sentence that opens the list of changes between the release and this build. Mid-sentence.
msgctxt "windows.changelog.sinceReleaseLink"
msgid "what changed since the release"
msgstr "ce s-a schimbat de la lansare"

#: client/components/Windows/Changelog.vue
#. Heading of the changelog window. {version} is the release version number, kept as written (a v followed by the number).
msgctxt "windows.changelog.title"
msgid "Release notes for v{version}"
msgstr "Notiții de eliberare pentru v{version}"

#: client/components/Windows/NetworkEdit.vue
#. Link at the top of the network-editing form that goes back to the list of saved networks; the left arrow is part of the copy.
msgctxt "windows.networkEdit.back"
msgid "← Networks"
msgstr "← Rețele"

#: client/components/Windows/Settings.vue
#. aria-label of the ✕ button at the top right of the settings window; clicking closes the settings and returns to the chat.
msgctxt "windows.settings.close"
msgid "Close settings"
msgstr "Închide setări"

#: client/components/Windows/Settings.vue
#. Button in the footer of the settings window; clicking closes the settings and returns to the chat.
msgctxt "windows.settings.done"
msgid "Done"
msgstr "Terminat"

#: client/components/Windows/Settings.vue
#. Line in the footer of the settings window, beside the Done button; explains that settings apply instantly and nothing needs saving.
msgctxt "windows.settings.note"
msgid "Changes are saved as you make them."
msgstr "Schimbările sunt salvate în timp ce le faci."

#: client/components/Windows/Settings.vue
#. Title of the settings window: the heading of the modal, its dialog aria-label, and the accessible name of the whole settings pane.
msgctxt "windows.settings.title"
msgid "Settings"
